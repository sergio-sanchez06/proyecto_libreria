<%- include('../layout/header') %>

    <main class="container my-5">
        <h1 class="mb-4">
            <%= t('cookies_policy.title') %>
        </h1>
        <section class="card p-4 shadow-sm">
            <p>
                <%= t('cookies_policy.intro') %>
            </p>

            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item">
                    <strong>
                        <%= t('cookies_policy.session_name') %>
                    </strong>
                    <%= t('cookies_policy.session_desc') %>
                </li>
                <li class="list-group-item">
                    <strong>
                        <%= t('cookies_policy.technical_name') %>
                    </strong>
                    <%= t('cookies_policy.technical_desc') %>
                </li>
            </ul>

            <p class="text-muted small">
                <%= t('cookies_policy.disclaimer') %>
            </p>
        </section>
    </main>

    <%- include('../layout/footer') %>