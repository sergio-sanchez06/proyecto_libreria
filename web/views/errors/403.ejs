<%- include('../layout/header') %>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(252, 250, 247, 0.45);
            z-index: -1;
        }

        main {
            flex: 1;
            display: flex;
            align-items: center;
            /* Centrado vertical */
            justify-content: center;
        }

        .error-card {
            border: none;
            border-radius: 24px;
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
            padding: 3rem;
            max-width: 500px;
            width: 90%;
        }

        .error-code {
            font-size: 6rem;
            font-weight: 900;
            background: linear-gradient(135deg, var(--brand-teal), #2c3e50);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            line-height: 1;
            margin-bottom: 1rem;
        }

        .error-title {
            color: #2d3748;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 1rem;
        }

        .error-icon {
            font-size: 3rem;
            color: var(--brand-gold);
            margin-bottom: 1.5rem;
        }

        .btn-primary {
            background-color: var(--brand-teal) !important;
            border: none;
            padding: 12px 24px;
            font-weight: 700;
            border-radius: 12px;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background-color: var(--brand-teal-hover) !important;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(13, 92, 99, 0.2);
        }

        .btn-outline-custom {
            border: 1.5px solid var(--brand-teal);
            color: var(--brand-teal);
            padding: 12px 24px;
            font-weight: 600;
            border-radius: 12px;
            transition: all 0.3s ease;
        }

        .btn-outline-custom:hover {
            background: var(--brand-teal);
            color: white;
            transform: translateY(-2px);
        }

        .suggestion-text {
            font-size: 0.9rem;
            color: #718096;
        }

        .suggestion-text a {
            color: var(--brand-teal);
            text-decoration: none;
            font-weight: 600;
        }

        .suggestion-text a:hover {
            text-decoration: underline;
        }
    </style>

    <main class="container py-5">
        <div class="error-card text-center mx-auto">
            <div class="error-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>

            <h1 class="error-code">403</h1>
            <h2 class="error-title">Acceso Restringido</h2>
            <p class="text-muted mb-4">
                Lo sentimos, pero no tienes los permisos necesarios para ver este contenido.
            </p>

            <div class="d-grid gap-3 d-sm-flex justify-content-sm-center mb-4">
                <a href="/" class="btn btn-primary">
                    <i class="bi bi-house-door me-2"></i>Ir al inicio
                </a>
                <a href="/books" class="btn btn-outline-custom">
                    <i class="bi bi-search me-2"></i>Ver Catálogo
                </a>
            </div>

            <hr class="my-4" style="opacity: 0.1;">

            <div class="suggestion-text">
                <% if (!user) { %>
                    ¿Eres administrador?
                    <a href="/login">Inicia sesión aquí</a>
                    <% } else { %>
                        ¿Crees que es un error?
                        <a href="mailto:soporte@tu-libreria.com">Contacta con soporte</a>
                        <% } %>
            </div>
        </div>
    </main>

    <%- include('../layout/footer') %>