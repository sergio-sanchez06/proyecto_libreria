<%- include('../layout/header', { extraCSS: 'errors/404' }) %>

    <main class="container my-5 py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 text-center">
                <div class="display-1 text-secondary opacity-25 mb-4">
                    <i class="bi bi-archive-fill"></i>
                </div>

                <h1 class="fw-bold h2 mb-3">Recurso no disponible</h1>

                <p class="text-muted fs-5 mb-4">
                    Lo sentimos, el elemento que buscas (libro, autor, editorial o género)
                    ha sido <strong>archivado</strong> o ya no forma parte de nuestro catálogo activo.
                </p>

                <div class="card border-0 shadow-sm rounded-4 bg-light mb-5">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-uppercase small text-secondary mb-3">¿Qué puedes hacer?</h6>
                        <ul class="list-unstyled text-start mb-0">
                            <li class="mb-2">
                                <i class="bi bi-check2-circle text-success me-2"></i>
                                Explorar otros libros similares.
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check2-circle text-success me-2"></i>
                                Revisar si el nombre está bien escrito en la URL.
                            </li>
                            <li>
                                <i class="bi bi-check2-circle text-success me-2"></i>
                                Contactar con soporte si crees que es un error.
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="d-grid d-sm-flex justify-content-sm-center gap-3">
                    <a href="/books/showAllBooks" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold">
                        <i class="bi bi-book me-2"></i> Ver Catálogo
                    </a>
                    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i> Volver atrás
                    </a>
                </div>
            </div>
        </div>
    </main>

    <%- include('../layout/footer') %>
