<%- include('../layout/header', { 
    title: 'Error de servidor - Librería Online',
    extraCSS: 'errors/500' 
}) %>

<main class="container my-5 py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="error-illustration">
                <i class="bi bi-gear-fill"></i>
            </div>

            <h1 class="display-4 fw-bold text-dark mb-4">Error 500</h1>
            <h2 class="h4 text-muted mb-4">Algo no ha salido como esperábamos en nuestro servidor.</h2>

            <% if (locals.error) { %>
                <div class="error-details-box p-4 shadow-sm mb-5">
                    <h6 class="text-uppercase small fw-bold text-danger mb-3">Detalle del error:</h6>
                    <p class="mb-0 text-dark opacity-75"><%= error %></p>
                </div>
            <% } %>

            <p class="text-muted mb-5">
                Nuestro equipo ha sido notificado y estamos trabajando para solucionarlo. <br>
                Por favor, intenta recargar la página en unos momentos.
            </p>

            <div class="d-flex justify-content-center gap-3">
                <a href="/" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                    <i class="bi bi-house-door me-2"></i> Volver al inicio
                </a>
                <button onclick="window.location.reload()" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-clockwise me-2"></i> Reintentar
                </button>
            </div>
        </div>
    </div>
</main>

<%- include('../layout/footer') %>
