<%- include('../layout/header.ejs') %>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    body {
        background-image: url('/images/book_drawing_pattern.png');
        background-repeat: repeat;
        background-size: 500px;
        background-attachment: fixed;
        background-color: #fcfaf7;
        font-family: 'Inter', sans-serif;
    }

    body::before {
        content: "";
        position: fixed;
        top: 0; left: 0; width: 100vw; height: 100vh;
        background: rgba(252, 250, 247, 0.88);
        z-index: -1;
    }

    .section-title {
        font-weight: 800;
        color: var(--brand-teal);
        position: relative;
        padding-bottom: 8px;
        margin-bottom: 2rem;
    }

    .card {
        border: none;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    .book-card-cart:hover {
        transform: translateY(-5px);
        background: rgba(255, 255, 255, 0.9) !important;
    }

    .qty-controls {
        border: 1px solid rgba(0,0,0,0.05);
        background: rgba(255, 255, 255, 0.5) !important;
    }

    .summary-card {
        background: rgba(255, 255, 255, 0.9) !important;
        border: 2px solid var(--brand-teal);
        box-shadow: 0 15px 40px rgba(13, 92, 99, 0.1);
    }

    .btn-success {
        background-color: var(--brand-teal) !important;
        border: none !important;
        padding: 12px 30px;
        font-weight: 700;
        border-radius: 12px;
        transition: all 0.3s ease;
    }

    .btn-success:hover:not(:disabled) {
        background-color: var(--brand-teal-hover) !important;
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(13, 92, 99, 0.2);
    }

    .btn-primary {
        background-color: var(--brand-teal) !important;
        border: none !important;
        border-radius: 12px;
    }
</style>

<main class="container py-5">
    <h1 class="section-title mb-4 fw-bold">
        <%= t('cart.title') %>
    </h1>

    <% if (error) { %>
        <div class="alert alert-danger shadow-sm border-0 mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <%= error %>
        </div>
        <% } %>

            <% if (cart.length===0) { %>
                <div class="text-center py-5 shadow-sm bg-white rounded border">
                    <i class="bi bi-cart-x fs-1 text-muted mb-3 d-block"></i>
                    <p class="lead text-muted">
                        <%= t('cart.empty_msg') %>
                    </p>
                    <a href="/" class="btn btn-primary px-4 rounded-pill">
                        <%= t('cart.back_to_shop') %>
                    </a>
                </div>
                <% } else { %>
                    <div class="row">
                        <% cart.forEach(item=> { %>
                            <div class="col-md-6 mb-4">
                                <div class="card h-100 shadow-sm border-0 book-card-cart">
                                    <div class="row g-0 h-100">
                                        <div class="col-4">
                                            <img src="<%= item.book.cover_url || '/images/default-cover.jpg' %>"
                                                class="img-fluid rounded-start h-100"
                                                alt="<%= item.book.title %>"
                                                style="object-fit: cover; min-height: 150px;">
                                        </div>
                                        <div class="col-8">
                                            <div class="card-body d-flex flex-column h-100">
                                                <h5 class="card-title text-truncate fw-bold">
                                                    <%= item.book.title %>
                                                </h5>
                                                <p class="text-primary fw-bold mb-1">
                                                    <%= t('cart.price') %>: <%= item.book.price %>€
                                                </p>

                                                <div class="d-flex align-items-center my-2">
                                                    <span class="me-2 small text-muted">
                                                        <%= t('cart.quantity') %>:
                                                    </span>
                                                    <div
                                                        class="qty-controls d-flex align-items-center bg-light rounded border">
                                                        <form action="/cart/add" method="POST" class="m-0">
                                                            <input type="hidden" name="book_id"
                                                                value="<%= item.book_id %>">
                                                            <input type="hidden" name="quantity" value="-1">
                                                            <button type="submit"
                                                                class="btn btn-sm px-2 text-primary">-</button>
                                                        </form>

                                                        <span class="px-3 fw-bold small">
                                                            <%= item.quantity %>
                                                        </span>

                                                        <form action="/cart/add" method="POST" class="m-0">
                                                            <input type="hidden" name="book_id"
                                                                value="<%= item.book_id %>">
                                                            <input type="hidden" name="quantity" value="1">
                                                            <button type="submit"
                                                                class="btn btn-sm px-2 text-primary"
                                                                <%=item.quantity>= item.book.stock ? 'disabled'
                                                                : '' %>>+</button>
                                                        </form>
                                                    </div>
                                                </div>

                                                <p class="card-text fw-bold mt-auto mb-2">
                                                    <%= t('cart.subtotal') %>:
                                                        <span class="text-dark">
                                                            <%= (item.book.price * item.quantity).toFixed(2) %>€
                                                        </span>
                                                </p>

                                                <form action="/cart/add" method="POST" class="mt-1">
                                                    <input type="hidden" name="book_id"
                                                        value="<%= item.book_id %>">
                                                    <input type="hidden" name="quantity"
                                                        value="-<%= item.quantity %>">
                                                    <button type="submit"
                                                        class="btn btn-link btn-sm p-0 text-danger text-decoration-none small">
                                                        <i class="bi bi-trash3 me-1"></i>
                                                        <%= t('cart.remove') %>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>

                    <div class="summary-card mt-5 p-4 rounded-4 text-end">
                        <h3 class="fw-bold mb-4">
                            <%= t('cart.total') %>:
                            <span class="text-success ms-2">
                                <%= total %>€
                            </span>
                        </h3>

                        <form action="/cart/checkout" method="POST" id="checkout-form"
                            class="d-inline-block">
                            <input type="hidden" name="firebase_token" id="firebase-token">
                            <button type="submit" id="checkout-btn"
                                class="btn btn-success btn-lg px-5 shadow-sm rounded-pill" disabled>
                                <%= t('cart.btn_loading') %>
                            </button>
                        </form>
                    </div>

                    <script type="module">
                        import { initCheckout } from '/js/auth.mjs';

                        // Pasamos la traducción del botón final al script si fuera necesario
                        // Pero aquí lo manejamos directamente con EJS en el DOM inicial
                        if (document.readyState === 'loading') {
                            document.addEventListener('DOMContentLoaded', () => {
                                initCheckout();
                                // Una vez inicializado, el script auth.mjs suele habilitar el botón.
                                // Asegúrate de que en auth.mjs cambies el texto a: <%= t('cart.btn_checkout') %>
                            });
                        } else {
                            initCheckout();
                        }
                    </script>
                    <% } %>
</main>

<%- include('../layout/footer') %>


</html>