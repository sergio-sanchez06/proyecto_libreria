<%- include('../layout/header', { 
    title: t('orders.title'), 
    bodyClass: 'bg-user-vistas',
    extraCSS: 'partials/purchaseHistory'
}) %>

    <div class="container my-5 orders-container">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb" style="font-weight:500;">
                <li class="breadcrumb-item">
                    <a href="/user/profile" class="text-decoration-none text-muted">
                        Perfil
                    </a>
                </li>
                <li class="breadcrumb-item active" style="color:var(--brand-teal);">
                    <%= t('orders.title') %>
                </li>
            </ol>
        </nav>

        <!-- ── New Integrated Orders Hero ── -->
        <div class="orders-hero p-4 p-lg-5 mb-5 rounded-5 shadow-lg border-0 position-relative overflow-hidden text-white">
            <div class="hero-overlay"></div>
            <div class="row align-items-center position-relative z-1">
                <div class="col-lg-7 mb-4 mb-lg-0">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="hero-icon-box bg-white text-teal rounded-4 shadow-sm d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; font-size: 2.2rem; flex-shrink: 0;">
                            <i class="bi bi-box-seam-fill"></i>
                        </div>
                        <div>
                            <h1 class="display-5 fw-bold mb-0">Mis Pedidos</h1>
                            <p class="opacity-75 mb-0">Gestiona tus compras y envíos</p>
                        </div>
                    </div>
                    
                    <div class="stats-pills d-flex gap-3 mt-4">
                        <div class="stat-pill px-4 py-2 rounded-pill bg-glass-white text-dark shadow-sm text-center">
                            <span class="small text-muted fw-bold text-uppercase" style="font-size: 0.65rem;">Pedidos Totales</span>
                            <span class="fw-bold fs-4 d-block" style="line-height: 1;"><%= orders.length %></span>
                        </div>
                        <% 
                            let totalSpent = orders.reduce((acc, o) => acc + Number(o.total), 0).toFixed(2);
                        %>
                        <div class="stat-pill px-4 py-2 rounded-pill bg-glass-white text-dark shadow-sm text-center">
                            <span class="small text-muted fw-bold text-uppercase" style="font-size: 0.65rem;">Inversión en Lectura</span>
                            <span class="fw-bold fs-4 d-block" style="line-height: 1;"><%= totalSpent %>€</span>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-5">
                    <div class="d-flex flex-column gap-3">
                        <div class="p-3 rounded-4 bg-glass-white text-dark border shadow-sm">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-teal-soft p-2 rounded-circle">
                                    <i class="bi bi-shield-check text-teal"></i>
                                </div>
                                <div class="small fw-600">Todas tus compras están protegidas por nuestro sistema de garantía.</div>
                            </div>
                        </div>
                        <a href="/user/profile" class="btn btn-white rounded-pill px-4 py-3 fw-bold shadow-sm w-100 border d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-arrow-left"></i> Volver al Perfil
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <% if (orders && orders.length> 0) { %>
            <% orders.forEach(order=> { %>
                <div class="card shadow-sm border-0 order-card">
                    <div
                        class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom-0">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">
                                <%= t('orders.order_no') %> #<%= order.id %>
                            </span>
                            <h5 class="mb-0 fw-bold">
                                <%= t('orders.date_label') %>:
                                    <%= new Date(order.created_at).toLocaleDateString(currentLanguage==='eu' ? 'eu-ES' :
                                        currentLanguage==='ca' ? 'ca-ES' : currentLanguage==='gl' ? 'gl-ES' : 'es-ES' )
                                        %>
                            </h5>
                        </div>
                        <div class="text-end">
                            <% let statusKey='status_pending' ; let badgeClass='bg-warning text-dark' ;
                                switch(order.status) { case 'PENDIENTE' : statusKey='status_pending' ;
                                badgeClass='bg-warning text-dark' ; break; case 'PAGADO' : statusKey='status_paid' ;
                                badgeClass='bg-info text-white' ; break; case 'PROCESANDO' :
                                statusKey='status_processing' ; badgeClass='text-white' ; break; case 'ENVIADO' :
                                statusKey='status_shipped' ; badgeClass='text-white' ; break; case 'ENTREGADO' :
                                statusKey='status_delivered' ; badgeClass='bg-success text-white' ; break;
                                case 'CANCELADO' : statusKey='status_cancelled' ; badgeClass='bg-danger text-white' ;
                                break; } %>
                                <span class="badge rounded-pill status-badge mb-1 px-3 <%= badgeClass %>" <% if
                                    (order.status==='PROCESANDO' || order.status==='ENVIADO' ) { %>
                                    style="background-color: var(--brand-teal);"
                                    <% } %> >
                                        <%= t('orders.' + statusKey) %>
                                </span>
                                <p class="h5 mb-0 fw-bold" style="color: var(--brand-teal);">
                                    <%= Number(order.total).toFixed(2) %>€
                                </p>
                        </div>
                    <div class="card-body p-0">
                        <div class="row g-0">
                            <!-- Left Side: Order Meta & Shipping -->
                            <div class="col-lg-4 border-end bg-light-soft p-4">
                                <div class="mb-4">
                                    <h6 class="fw-bold mb-2 text-uppercase small text-muted" style="letter-spacing: 1px;">Envío a:</h6>
                                    <div class="d-flex align-items-start gap-2">
                                        <i class="bi bi-geo-alt text-teal"></i>
                                        <p class="mb-0 small fw-bold text-dark"><%= order.shipping_address || 'Dirección no especificada' %></p>
                                    </div>
                                </div>
                                <div class="mb-0">
                                    <h6 class="fw-bold mb-2 text-uppercase small text-muted" style="letter-spacing: 1px;">Estado del Pago:</h6>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-check-circle-fill text-success small"></i>
                                        <span class="small fw-bold text-dark">Confirmado</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Side: Items List -->
                            <div class="col-lg-8 p-4">
                                <h6 class="fw-bold mb-3 text-uppercase small text-muted" style="letter-spacing: 1px;">Libros en este pedido</h6>
                                <% if (order.items && order.items.length > 0) { %>
                                    <div class="order-items-compact">
                                        <% order.items.forEach(item => { %>
                                            <div class="d-flex align-items-center justify-content-between py-2 border-bottom border-light last-child-no-border">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="item-thumbnail rounded shadow-sm overflow-hidden" style="width: 45px; height: 65px; flex-shrink: 0; background: #eee;">
                                                        <img src="<%= item.book.cover_url || '/uploads/covers/cover_default.jpg' %>" alt="" class="w-100 h-100 object-fit-cover">
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold text-dark small mb-0"><%= item.book.title %></div>
                                                        <div class="text-muted" style="font-size: 0.75rem;">Cantidad: <%= item.quantity %> • <span class="fw-bold text-teal"><%= Number(item.price_at_time || item.price).toFixed(2) %>€</span></div>
                                                    </div>
                                                </div>
                                                <div class="fw-bold text-dark small text-end">
                                                    <%= (Number(item.price_at_time || item.price) * item.quantity).toFixed(2) %>€
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
                    <% } else { %>
                        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                            <i class="bi bi-cart-x mb-3 d-block"
                                style="font-size: 5rem; color: var(--brand-gold); opacity: 0.5;"></i>
                            <h4 class="fw-bold" style="color: var(--brand-teal);">
                                <%= t('orders.empty_msg') %>
                            </h4>
                            <a href="/books/showAllBooks" class="btn mt-3 rounded-pill px-4 text-white fw-bold"
                                style="background-color: var(--brand-teal);">
                                <i class="bi bi-shop me-2"></i>
                                <%= t('orders.btn_shop') %>
                            </a>
                        </div>
                        <% } %>
    </div>

    <%- include('../layout/footer') %>