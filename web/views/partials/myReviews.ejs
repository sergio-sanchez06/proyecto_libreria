<%- include("../layout/header", { 
    title: user.name + ' - Mis Reseñas' , 
    bodyClass: 'bg-user-vistas',
    extraCSS: 'partials/myReviews'
}) %>

    <main>
        <div class="container mt-5 mb-5">
            <div class="row mb-4">
                <div class="col-12 text-center">
                    <div class="display-6 fw-bold text-primary mb-2">
                        <i class="bi bi-person-circle"></i>
                        <%= user.name %>
                    </div>
                    <p class="text-muted">
                        <%= user.email %>
                    </p>
                    <hr class="w-25 mx-auto opacity-25">
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <h3 class="fw-bold mb-4">
                        <%= t('profile.activity_title') || 'Tu Actividad de Reseñas' %>
                            <span class="badge bg-success rounded-pill ms-2 fs-6">
                                <%= reviews.length %>
                            </span>
                    </h3>

                    <% if (reviews && reviews.length> 0) { %>
                        <div class="reviews-grid">
                            <% reviews.forEach(review=> { %>
                                <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden">
                                    <div class="row g-0">
                                        <div
                                            class="col-md-2 bg-light d-flex align-items-center justify-content-center p-3">
                                            <img src="<%= review.book_cover || '/covers/cover_default.jpg' %>"
                                                alt="<%= review.book_title %>" class="img-fluid rounded-2 shadow-sm"
                                                style="max-height: 120px; object-fit: cover;">
                                        </div>

                                        <div class="col-md-10">
                                            <div class="card-body p-4">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <div>
                                                        <h5 class="fw-bold mb-0">
                                                            <a href="/books/book/<%= review.book_id %>"
                                                                class="text-decoration-none text-dark hover-primary">
                                                                <%= review.book_title %>
                                                            </a>
                                                        </h5>
                                                        <div class="text-warning mt-1">
                                                            <% for(let i=0; i<5; i++) { %>
                                                                <i
                                                                    class="bi bi-star-fill <%= i < review.rating ? '' : 'text-muted opacity-25' %>"></i>
                                                                <% } %>
                                                        </div>
                                                    </div>
                                                    <small class="text-muted">
                                                        <%= new Date(review.created_at).toLocaleDateString() %>
                                                    </small>
                                                </div>

                                                <p class="card-text text-secondary fst-italic">"<%= review.comment %>"
                                                </p>

                                                <div class="d-flex gap-2 mt-3">
                                                    <a href="/books/book/<%= review.book_id %>"
                                                        class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                                        <i class="bi bi-eye"></i>
                                                        <%= t('common.view') || 'Ver' %>
                                                    </a>
                                                    <button type="button"
                                                        class="btn btn-outline-info btn-sm rounded-pill px-3 edit-btn"
                                                        data-id="<%= review.id %>" data-bookid="<%= review.book_id %>"
                                                        data-rating="<%= review.rating %>"
                                                        data-comment="<%= review.comment %>">
                                                        <i class="bi bi-pencil"></i>
                                                        <%= t('common.edit') || 'Editar' %>
                                                    </button>
                                                    <button type="button"
                                                        class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                        onclick="openDeleteModal('<%= review.id %>', '<%= review.book_id %>')">
                                                        <i class="bi bi-trash"></i>
                                                        <%= t('common.delete') || 'Borrar' %>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                        <% } else { %>
                            <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-dashed">
                                <i class="bi bi-chat-square-dots text-muted display-1"></i>
                                <p class="fs-5 text-muted mt-3">Parece que aún no has compartido tu opinión sobre ningún
                                    libro.</p>
                                <a href="/books" class="btn btn-primary rounded-pill px-4 mt-2">Explorar Libros</a>
                            </div>
                            <% } %>
                </div>
            </div>
        </div>
    </main>

    <div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header modal-header-primary border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Editar mi Reseña</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="editReviewForm" method="POST">
                    <input type="hidden" name="book_id" id="editBookId">

                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Puntuación</label>
                            <select name="rating" id="editRating" class="form-select shadow-sm">
                                <option value="1">1 Estrella</option>
                                <option value="2">2 Estrellas</option>
                                <option value="3">3 Estrellas</option>
                                <option value="4">4 Estrellas</option>
                                <option value="5">5 Estrellas</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tu Comentario</label>
                            <textarea name="comment" id="editComment" class="form-control shadow-sm" rows="4"
                                required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light rounded-pill px-4"
                            data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Guardar
                            Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header modal-header-danger border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>¿Eliminar
                        reseña?</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <p class="fs-5">Esta acción no se puede deshacer.</p>
                    <p class="text-muted small">Tu opinión y puntuación desaparecerán del historial del libro.</p>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4"
                        data-bs-dismiss="modal">Cancelar</button>
                    <form id="deleteForm" method="POST">
                        <input type="hidden" name="book_id" id="deleteBookId" value="">
                        <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">Confirmar
                            Eliminación</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <%- include('../layout/footer') %>

        <script>
            // Inicializamos los modales de bootstrap
            const bDeleteModal = new bootstrap.Modal(document.getElementById('modalEliminar'));
            const bEditModal = new bootstrap.Modal(document.getElementById('modalEditar'));

            // Obtenemos los formularios y los campos
            const editForm = document.getElementById('editReviewForm');
            const deleteForm = document.getElementById('deleteForm');

            // Función para Editar
            document.addEventListener('click', function (e) {
                const btn = e.target.closest('.edit-btn');
                if (btn) {
                    // Extraemos los datos de los atributos 'data-'
                    const id = btn.dataset.id;
                    const bookId = btn.dataset.bookid;
                    const rating = btn.dataset.rating;
                    const comment = btn.dataset.comment;

                    // Configuramos el formulario
                    editForm.action = `/review/update/${id}?_method=PUT`;

                    // Rellenamos los campos del modal
                    document.getElementById('editRating').value = rating;
                    document.getElementById('editComment').value = comment;
                    document.getElementById('editBookId').value = bookId;

                    // Mostramos el modal
                    bEditModal.show();
                }
            });

            // Función para Eliminar
            function openDeleteModal(id, book_id) {
                // Configuramos la URL de acción dinámicamente
                deleteForm.action = `/review/delete/${id}?_method=DELETE`;

                // Asignamos el book_id al input hidden
                const inputBookId = document.getElementById('deleteBookId');
                if (inputBookId) {
                    inputBookId.value = book_id;
                }

                bDeleteModal.show();
            }
        </script>