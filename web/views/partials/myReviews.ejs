<%- include("../layout/header", { 
    title: user.name + ' - Mis Reseñas' , 
    bodyClass: 'bg-user-vistas',
    extraCSS: 'partials/myReviews'
}) %>

    <main class="py-5">
        <div class="container profile-reviews-container">
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb" style="font-weight:500;">
                    <li class="breadcrumb-item">
                        <a href="/user/profile" class="text-decoration-none text-muted">
                            Perfil
                        </a>
                    </li>
                    <li class="breadcrumb-item active" style="color:var(--brand-teal);">
                        <%= t('profile.activity_title') || 'Mis Reseñas' %>
                    </li>
                </ol>
            </nav>

            <div class="reviews-hero p-4 p-lg-5 mb-5 rounded-5 shadow-lg border-0 position-relative overflow-hidden text-white">
                <div class="hero-overlay"></div>
                <div class="row align-items-center position-relative z-1">
                    <div class="col-lg-7 mb-4 mb-lg-0">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="hero-icon-box bg-white text-teal rounded-4 shadow-sm d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; font-size: 2rem;">
                                <i class="bi bi-journal-check"></i>
                            </div>
                            <div>
                                <h1 class="display-5 fw-bold mb-0"><%= t('review.reviews_page_title') %></h1>
                                <p class="opacity-75 mb-0"><%= user.name %> • <%= user.email %></p>
                            </div>
                        </div>
                        
                        <div class="reviewer-rank-container mt-4 p-3 rounded-4 bg-glass-white text-dark">
                            <% 
                                let rank = t('reviewer_rank.rank_beginner');
                                let nextRank = t('reviewer_rank.rank_active');
                                let totalRev = typeof allReviews !== 'undefined' ? allReviews.length : (typeof totalReviews !== 'undefined' ? totalReviews : reviews.length);
                                let progress = (totalRev / 5) * 100;
                                let needed = 5 - totalRev;

                                if (totalRev >= 5 && totalRev < 10) {
                                    rank = t('reviewer_rank.rank_active');
                                    nextRank = t('reviewer_rank.rank_expert');
                                    progress = ((totalRev - 5) / 5) * 100;
                                    needed = 10 - totalRev;
                                } else if (totalRev >= 10) {
                                    rank = t('reviewer_rank.rank_expert');
                                    nextRank = t('reviewer_rank.rank_master');
                                    progress = 100;
                                    needed = 0;
                                }
                            %>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge rounded-pill bg-teal text-white px-3 fw-bold"><%= rank %></span>
                                <span class="small fw-bold text-muted">
                                    <% if (needed > 0) { %> 
                                        <%= t('reviewer_rank.progress_needed', { needed, nextRank }) %>
                                    <% } else { %>
                                        <%= t('reviewer_rank.progress_max', { rank }) %>
                                    <% } %>
                                </span>
                            </div>
                            <div class="progress rounded-pill" style="height: 12px; background: rgba(0,0,0,0.05); border: 1px solid rgba(0,0,0,0.05);">
                                <div class="progress-bar bg-teal progress-bar-striped progress-bar-animated" 
                                     role="progressbar" style="width: <%= progress %>%"></div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-5">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="hero-stat-card p-3 rounded-4 bg-glass-white text-dark text-center h-100 border shadow-sm">
                                    <div class="fs-1 fw-bold text-teal"><%= totalRev %></div>
                                    <div class="small text-muted fw-bold text-uppercase" style="letter-spacing: 1px;">Reseñas</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <% 
                                    let avgRating = 0;
                                    let sourceArray = typeof allReviews !== 'undefined' ? allReviews : reviews;
                                    if (sourceArray && sourceArray.length > 0) {
                                        const sum = sourceArray.reduce((acc, r) => acc + r.rating, 0);
                                        avgRating = (sum / sourceArray.length).toFixed(1);
                                    }
                                %>
                                <div class="hero-stat-card p-3 rounded-4 bg-glass-white text-dark text-center h-100 border shadow-sm">
                                    <div class="fs-1 fw-bold text-gold"><%= avgRating %></div>
                                    <div class="small text-muted fw-bold text-uppercase" style="letter-spacing: 1px;">Nota Media</div>
                                </div>
                            </div>
                            <div class="col-12 mt-3">
                                <a href="/user/profile" class="btn bg-glass-white rounded-pill px-4 py-3 fw-bold shadow-sm w-100 border d-flex align-items-center justify-content-center gap-2 transition-all" style="color: var(--brand-teal);">
                                    <i class="bi bi-person-circle"></i> <%= t('favorites.profile_btn') %>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-12">
                    <div class="d-flex justify-content-between align-items-end mb-4">
                        <h3 class="fw-bold mb-0">
                            <%= t('review.review_page_history') %>
                        </h3>
                        <div class="text-muted small">
                            <%= t('review.review_page_order') %>
                        </div>
                    </div>

                    <% if (reviews && reviews.length> 0) { %>
                        <div class="reviews-timeline">
                            <% reviews.forEach(review=> { %>
                                <div class="card border-0 shadow-sm mb-5 rounded-4 overflow-hidden review-modern-card">
                                    <div class="row g-0">
                                        <div class="col-md-3 col-lg-2 bg-light-soft d-flex align-items-center justify-content-center p-4">
                                            <div class="book-cover-wrapper">
                                                <img src="<%= review.book_cover || '/covers/cover_default.jpg' %>"
                                                    alt="<%= review.book_title %>" class="img-fluid rounded-3 shadow"
                                                    style="max-height: 180px; object-fit: cover;">
                                                <% if (review.rating >= 5) { %>
                                                    <span class="top-pick-badge">
                                                        <i class="bi bi-heart-fill"></i>
                                                    </span>
                                                <% } %>
                                            </div>
                                        </div>

                                        <div class="col-md-9 col-lg-10">
                                            <div class="card-body p-4 p-lg-5">
                                                <div class="d-flex justify-content-between align-items-start mb-3">
                                                    <div>
                                                        <h4 class="fw-bold mb-1">
                                                            <a href="/books/book/<%= review.book_id %>"
                                                                class="text-decoration-none text-dark hover-teal">
                                                                <%= review.book_title %>
                                                            </a>
                                                        </h4>
                                                        <div class="review-stars-display mb-2">
                                                            <% for(let i=0; i<5; i++) { %>
                                                                <i class="bi bi-star-fill <%= i < review.rating ? 'text-gold' : 'text-muted-light' %>"></i>
                                                            <% } %>
                                                            <span class="ms-2 fw-bold text-muted small"><%= review.rating %>/5</span>
                                                        </div>
                                                    </div>
                                                    <div class="text-end">
                                                        <div class="badge rounded-pill bg-light text-dark border mb-1">
                                                            <%= new Date(review.created_at).toLocaleDateString() %>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="review-comment-box p-3 rounded-4 mb-4">
                                                    <i class="bi bi-quote fs-2 text-teal opacity-25 d-block mb-n3"></i>
                                                    <p class="card-text text-secondary mb-0 ps-4">
                                                        <%= review.comment %>
                                                    </p>
                                                </div>

                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div class="d-flex gap-2">
                                                        <button type="button"
                                                            class="btn btn-teal-soft btn-sm rounded-pill px-3 edit-btn fw-600"
                                                            data-id="<%= review.id %>" data-bookid="<%= review.book_id %>"
                                                            data-rating="<%= review.rating %>"
                                                            data-comment="<%= review.comment %>">
                                                            <i class="bi bi-pencil-square me-1"></i>
                                                            <%= t('review.edit') %>
                                                        </button>
                                                        <button type="button"
                                                            class="btn btn-danger-soft btn-sm rounded-pill px-3 fw-600"
                                                            onclick="openDeleteModal('<%= review.id %>', '<%= review.book_id %>')">
                                                            <i class="bi bi-trash3 me-1"></i>
                                                            <%= t('review.delete') %>
                                                        </button>
                                                    </div>
                                                    <a href="/books/book/<%= review.book_id %>"
                                                        class="btn btn-link text-teal text-decoration-none fw-bold p-0">
                                                        Ver libro <i class="bi bi-arrow-right small"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                        
                        <!-- ── Paginación Unificada ───────────────────────────── -->
                        <% if (totalPages > 1) { %>
                            <nav class="mt-5 d-flex align-items-center justify-content-between flex-wrap gap-3" aria-label="Paginación de reseñas">
                                <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">
                                    <%= t('review.page') %> <strong><%= currentPage %></strong> de <strong><%= totalPages %></strong>
                                    &nbsp;·&nbsp; <strong><%= totalReviews %></strong> <%= t('review.total_reviews') %>
                                </span>
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                                        <a class="page-link" href="/user/myReviews?page=<%= currentPage - 1 %>">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>
                                    <% for (let p = 1; p <= totalPages; p++) { %>
                                        <% if (totalPages <= 7 || p === 1 || p === totalPages || Math.abs(p - currentPage) <= 1) { %>
                                            <li class="page-item <%= currentPage == p ? 'active' : '' %>">
                                                <a class="page-link" href="/user/myReviews?page=<%= p %>"><%= p %></a>
                                            </li>
                                        <% } else if (p === 2 || p === totalPages - 1) { %>
                                            <li class="page-item disabled"><span class="page-link">...</span></li>
                                        <% } %>
                                    <% } %>
                                    <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                                        <a class="page-link" href="/user/myReviews?page=<%= currentPage + 1 %>">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        <% } %>
                        <% } else { %>
                            <div class="text-center py-5 bg-white rounded-5 shadow-sm border border-dashed my-5 p-5">
                                <div class="empty-reviews-icon mb-4">
                                    <i class="bi bi-journal-richtext text-muted opacity-25" style="font-size: 5rem;"></i>
                                </div>
                                <h4 class="fw-bold text-dark"><%= t('review.empty_reviews_title') %></h4>
                                <p class="text-muted mx-auto mb-4" style="max-width: 400px;">
                                    <%= t('review.empty_reviews_description') %>
                                </p>
                                <a href="/books" class="btn btn-teal rounded-pill px-5 py-3 fw-bold shadow-sm">
                                    <%= t('review.explore_books') %>
                                </a>
                            </div>
                            <% } %>
                </div>
            </div>
        </div>
    </main>

    <div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header modal-header-primary border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Editar mi Reseña</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="editReviewForm" method="POST">
                    <input type="hidden" name="book_id" id="editBookId">
                    <input type="hidden" name="returnTo" id="editReturnTo">

                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Puntuación</label>
                            <select name="rating" id="editRating" class="form-select shadow-sm">
                                <option value="1">1 Estrella</option>
                                <option value="2">2 Estrellas</option>
                                <option value="3">3 Estrellas</option>
                                <option value="4">4 Estrellas</option>
                                <option value="5">5 Estrellas</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tu Comentario</label>
                            <textarea name="comment" id="editComment" class="form-control shadow-sm" rows="4"
                                required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light rounded-pill px-4"
                            data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Guardar
                            Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header modal-header-danger border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>¿Eliminar
                        reseña?</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <p class="fs-5">Esta acción no se puede deshacer.</p>
                    <p class="text-muted small">Tu opinión y puntuación desaparecerán del historial del libro.</p>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4"
                        data-bs-dismiss="modal">Cancelar</button>
                    <form id="deleteForm" method="POST">
                        <input type="hidden" name="book_id" id="deleteBookId" value="">
                        <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">Confirmar
                            Eliminación</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <%- include('../layout/footer') %>

        <script>
            // Inicializamos los modales de bootstrap
            const bDeleteModal = new bootstrap.Modal(document.getElementById('modalEliminar'));
            const bEditModal = new bootstrap.Modal(document.getElementById('modalEditar'));

            // Obtenemos los formularios y los campos
            const editForm = document.getElementById('editReviewForm');
            const deleteForm = document.getElementById('deleteForm');

            // Función para Editar
            document.addEventListener('click', function (e) {
                const btn = e.target.closest('.edit-btn');
                if (btn) {
                    // Extraemos los datos de los atributos 'data-'
                    const id = btn.dataset.id;
                    const bookId = btn.dataset.bookid;
                    const rating = btn.dataset.rating;
                    const comment = btn.dataset.comment;

                    // Configuramos el formulario
                    editForm.action = `/review/update/${id}?_method=PUT`;

                    // Rellenamos los campos del modal
                    document.getElementById('editRating').value = rating;
                    document.getElementById('editComment').value = comment;
                    document.getElementById('editBookId').value = bookId;
                    document.getElementById('editReturnTo').value = "<%= currentUrl %>";

                    // Mostramos el modal
                    bEditModal.show();
                }
            });

            // Función para Eliminar
            function openDeleteModal(id, book_id) {
                // Configuramos la URL de acción dinámicamente
                deleteForm.action = `/review/delete/${id}?_method=DELETE`;

                // Asignamos el book_id al input hidden
                const inputBookId = document.getElementById('deleteBookId');
                if (inputBookId) {
                    inputBookId.value = book_id;
                }

                bDeleteModal.show();
            }
        </script>