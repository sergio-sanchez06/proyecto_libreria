<%- include('../layout/header') %>

<% 
// Asegurar que las variables necesarias existan para evitar ReferenceError
const selectedCountry = locals.selectedCountry || null;
const countriesList = locals.countries || [];
const searchQuery = locals.query || {};
%>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    body {
        background-image: url('/images/author_drawing_pattern.png');
        background-repeat: repeat;
        background-size: 400px;
        background-attachment: fixed;
        background-color: #fcfaf7;
        font-family: 'Inter', sans-serif;
    }

    body::before {
        content: "";
        position: fixed;
        top: 0; left: 0; width: 100vw; height: 100vh;
        background: rgba(252, 250, 247, 0.88);
        z-index: -1;
    }

    .section-title {
        font-weight: 800;
        color: var(--brand-teal);
        position: relative;
        padding-bottom: 8px;
        margin-bottom: 2rem;
    }

    .filter-sidebar {
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.7) !important;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.5);
    }

    .card {
        border: none;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(8px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        transition: all 0.3s ease;
        overflow: hidden;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 25px rgba(0,0,0,0.08);
    }

    .author-img-container {
        width: 100px;
        height: 100px;
        margin: 0 auto 1.5rem;
        border-radius: 50%;
        overflow: hidden;
        border: 3px solid #fff;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .author-img-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .btn-primary { background: #2c3e50; border: none; }
    .btn-outline-primary { 
        border-color: #2c3e50; 
        color: #2c3e50; 
        border-radius: 12px;
        font-weight: 500;
    }
    .btn-outline-primary:hover {
        background: #2c3e50;
        color: #fff;
    }
    
    .pagination .page-link {
        border: none;
        border-radius: 8px;
        margin: 0 3px;
        color: #2c3e50;
    }

    .pagination .page-item.active .page-link {
        background: #2c3e50;
    }

    .scrollable-filter-container {
        max-height: 200px;
        overflow-y: auto;
        padding-right: 5px;
    }
</style>

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="section-title text-center"><%= t('es:authors.title') %></h2>
        <p class="text-muted"><%= t('es:authors.subtitle') %></p>
    </div>

    <div class="row">
        <!-- Sidebar de Filtros -->
        <aside class="col-lg-3 mb-4">
            <div class="filter-sidebar p-4 shadow-sm bg-light rounded-3">
                <h5 class="mb-4 d-flex align-items-center border-bottom pb-2">
                    <i class="bi bi-sliders me-2"></i> Filtros
                </h5>
                
                <form action="/authors/showAllAuthors" method="GET"> 
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-muted">País de origen</label>
                        <div class="scrollable-filter-container">
                            <div class="form-check small">
                                <input class="form-check-input" type="radio" name="country" id="country_all" value="" <%= !selectedCountry ? 'checked' : '' %>>
                                <label class="form-check-label" for="country_all">
                                    Todos los países
                                </label>
                            </div>
                            <% if (countriesList && countriesList.length > 0) { %>
                                <% countriesList.forEach(c => { %>
                                    <div class="form-check small">
                                        <input class="form-check-input" type="radio" name="country" id="country_<%= c %>" value="<%= c %>" <%= selectedCountry == c ? 'checked' : '' %>>
                                        <label class="form-check-label" for="country_<%= c %>">
                                            <%= c %>
                                        </label>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-sm fw-bold">Aplicar</button>
                        <a href="/authors/showAllAuthors" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                    </div>
                </form>
            </div>
        </aside>

        <!-- Lista de Autores -->
        <main class="col-lg-9">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                <% if (authors && authors.length > 0) { %>
                    <% authors.forEach(author=> { %>
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0 text-center p-4">
                                <div class="card-body d-flex flex-column">
                                    <div class="author-img-container bg-light d-flex align-items-center justify-content-center">
                                        <img src="<%= author.photo_url || '/images/default-author.jpg' %>"
                                            alt="<%= author.name %>">
                                    </div>
                                    <h5 class="card-title fw-bold mb-1"><%= author.name %></h5>
                                    <p class="text-muted small mb-2"><%= author.country || 'Desconocido' %></p>
                                    <p class="text-secondary small mb-4 opacity-75"><%= t('es:authors.role') %></p>
                                    
                                    <div class="mt-auto">
                                        <a href="/author/<%= author.id %>" class="btn btn-outline-primary btn-sm w-100">
                                            <%= t('es:authors.view_catalog') %>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12 text-center py-5">
                        <i class="bi bi-emoji-frown display-1 text-muted"></i>
                        <p class="mt-3 fs-5 text-muted">No se encontraron autores para este país.</p>
                    </div>
                <% } %>
            </div>
        </main>

            <!-- Paginación -->
            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { 
                const getPageUrl = (p) => {
                    const params = new URLSearchParams(searchQuery);
                    params.set('page', p);
                    return '?' + params.toString();
                };
            %>
                <nav class="mt-5">
                    <ul class="pagination pagination-sm justify-content-center">
                        <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="<%= getPageUrl(parseInt(currentPage) - 1) %>">&laquo;</a>
                        </li>

                        <% for(let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= currentPage == i ? 'active' : '' %>">
                                <a class="page-link" href="<%= getPageUrl(i) %>"><%= i %></a>
                            </li>
                        <% } %>

                        <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="<%= getPageUrl(parseInt(currentPage) + 1) %>">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            <% } %>
        </main>
    </div>
</div>

<%- include('../layout/footer') %>