<%- include('../layout/header', { 
    title: t('authors.title'),
    bodyClass: 'bg-main-vistas',
    extraCSS: 'partials/authorsTable'
}) %>

<% 
    const selectedCountry=locals.selectedCountry || null; 
    const countriesList=locals.countries || []; 
    const searchQuery=locals.query || {}; 
%>

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="section-title text-center">
            <%= t('authors.title') %>
        </h2>
        <p class="text-muted mt-3" style="font-size: 1.1rem;">
            <%= t('authors.subtitle') %>
        </p>
    </div>

    <div class="row">
        <!-- Sidebar de Filtros -->
        <aside class="col-lg-3 mb-4">
            <div class="filter-sidebar p-4">
                <h5 class="mb-4 d-flex align-items-center border-bottom pb-3 fw-bold" style="color: var(--brand-teal);">
                    <i class="bi bi-funnel-fill me-2 text-warning"></i> Filtros
                </h5>

                <form action="/authors/showAllAuthors" method="GET">
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-muted">País de origen</label>
                        <div class="scrollable-filter-container p-2 bg-white rounded-3 shadow-sm">
                            <div class="form-check mb-2">
                                <input class="form-check-input shadow-sm" type="radio" name="country" id="country_all"
                                    value="" <%=!selectedCountry ? 'checked' : '' %>>
                                <label class="form-check-label text-dark fw-medium" for="country_all">
                                    Todos los países
                                </label>
                            </div>
                            <% if (countriesList && countriesList.length> 0) { %>
                                <% countriesList.forEach(c=> { %>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input shadow-sm" type="radio" name="country"
                                            id="country_<%= c %>" value="<%= c %>" <%=selectedCountry==c
                                            ? 'checked' : '' %>>
                                        <label class="form-check-label text-muted" for="country_<%= c %>">
                                            <%= c %>
                                        </label>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-sm py-2 px-3 shadow-sm rounded-pill"><i class="bi bi-compass me-1"></i> Explorar</button>
                        <a href="/authors/showAllAuthors" class="btn btn-outline-dark btn-sm py-2 rounded-pill"><i class="bi bi-eraser-fill me-1"></i> Limpiar</a>
                    </div>
                </form>
            </div>
        </aside>

        <!-- Lista de Autores -->
        <main class="col-lg-9">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                <% if (authors && authors.length> 0) { %>
                    <% authors.forEach(author=> { %>
                        <% if (author.deleted_at===null) { %>
                            <div class="col">
                                <div class="card h-100 text-center">
                                    <div class="card-header-bg"></div>
                                    <div class="card-body d-flex flex-column pt-0 px-3 pb-4">
                                        <div class="author-img-container">
                                            <img src="<%= author.photo_url || '/images/default-author.jpg' %>"
                                                alt="<%= author.name %>">
                                        </div>
                                        <h5 class="fw-bold mb-1 text-dark" style="font-size: 1.15rem;">
                                            <%= author.name %>
                                        </h5>
                                        <p class="text-muted small fw-medium mb-2">
                                            <i class="bi bi-geo-alt-fill opacity-50 me-1"></i> <%= author.country || 'Desconocido' %>
                                        </p>
                                        <span class="badge bg-light text-secondary border rounded-pill mt-1 mx-auto mb-4 px-3 py-1">
                                            <i class="bi bi-stars text-warning me-1"></i> <%= t('authors.role') %>
                                        </span>

                                        <div class="mt-auto">
                                            <a href="/author/<%= author.id %>"
                                                class="btn btn-outline-primary btn-sm w-100 py-2 rounded-pill shadow-sm">
                                                <%= t('authors.view_catalog') %> <i class="bi bi-arrow-right ms-1"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    <% }) %>
                <% } else { %>
                    <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm border">
                        <div class="mx-auto bg-light rounded-circle d-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px;">
                            <i class="bi bi-people display-4 text-muted opacity-50"></i>
                        </div>
                        <h4 class="fw-bold mb-2 text-dark">No hay autores</h4>
                        <p class="text-muted">No se encontraron autores para este país.</p>
                        <a href="/authors/showAllAuthors" class="btn btn-primary mt-3 px-4 rounded-pill">Quitar filtros</a>
                    </div>
                <% } %>
            </div>

            <!-- Paginación -->
            <% if (typeof totalPages !=='undefined' && totalPages> 1) {
                const getPageUrl = (p) => {
                const params = new URLSearchParams(searchQuery);
                params.set('page', p);
                return '?' + params.toString();
                };
            %>
                <nav class="mt-5 pt-3">
                    <ul class="pagination pagination-sm justify-content-center">
                        <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="<%= getPageUrl(parseInt(currentPage) - 1) %>">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        <% for(let i=1; i <=totalPages; i++) { %>
                            <li class="page-item <%= currentPage == i ? 'active' : '' %>">
                                <a class="page-link" href="<%= getPageUrl(i) %>">
                                    <%= i %>
                                </a>
                            </li>
                        <% } %>

                        <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="<%= getPageUrl(parseInt(currentPage) + 1) %>">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            <% } %>
        </main>
    </div>
</div>

<%- include('../layout/footer') %>