<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= author.name %> - <%= t('author_detail.biography') %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --premium-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
        }

        body {
            background-color: #f8f9fa;
            color: #2d3748;
        }

        /* Imagen lateral fija similar a la portada del libro */
        .author-photo-wrapper {
            position: sticky;
            top: 2rem;
            border-radius: 1.5rem;
            overflow: hidden;
            box-shadow: var(--premium-shadow);
            background: white;
        }

        .author-photo-wrapper img {
            width: 100%;
            height: auto;
            display: block;
            object-fit: cover;
        }

        /* Tarjetas de datos técnicos */
        .spec-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            padding: 1.25rem;
            transition: all 0.2s ease;
        }

        .spec-label {
            color: #94a3b8;
            font-size: 0.7rem;
            text-transform: uppercase;
            font-weight: 800;
            letter-spacing: 0.05em;
            display: block;
            margin-bottom: 0.25rem;
        }

        .spec-value {
            color: #334155;
            font-weight: 700;
            font-size: 1rem;
        }

        /* Estilo de los libros del autor */
        .book-card {
            border: none;
            border-radius: 1.25rem;
            transition: transform 0.3s ease;
            background: white;
        }

        .book-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08) !important;
        }

        .book-card img {
            height: 300px;
            object-fit: cover;
            border-radius: 1.25rem 1.25rem 0 0;
        }
    </style>
</head>

<body>
    <%- include('../layout/header') %>

        <main class="container py-5">
            <div class="row g-5">
                <div class="col-lg-4">
                    <div class="author-photo-wrapper">
                        <img src="<%= author.photo_url || '/images/default-author.jpg' %>" alt="<%= author.name %>">
                    </div>
                </div>

                <div class="col-lg-8">
                    <nav aria-label="breadcrumb" class="mb-3">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Inicio</a>
                            </li>
                            <li class="breadcrumb-item active fw-bold text-primary">Autor</li>
                        </ol>
                    </nav>

                    <h1 class="display-3 fw-bold mb-4" style="letter-spacing: -0.025em;">
                        <%= author.name %>
                    </h1>

                    <div class="row g-3 mb-5">
                        <div class="col-sm-6">
                            <div class="spec-card">
                                <span class="spec-label">Nacionalidad</span>
                                <span class="spec-value"><i class="bi bi-geo-alt-fill me-2 text-primary"></i>
                                    <%= author.country || 'N/A' %>
                                </span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="spec-card">
                                <span class="spec-label">Obras en catálogo</span>
                                <span class="spec-value"><i class="bi bi-book me-2 text-primary"></i>
                                    <%= books.length %> Libros
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-5">
                        <h4 class="fw-bold text-uppercase small text-muted mb-3" style="letter-spacing: 2px;">
                            <%= t('author_detail.biography') %>
                        </h4>
                        <p class="fs-5 lh-lg text-secondary" style="text-align: justify;">
                            <%= author.biography || t('author_detail.no_biography') %>
                        </p>
                    </div>

                    <hr class="my-5 opacity-10">

                    <h3 class="fw-bold mb-4">
                        <%= t('author_detail.books_by', { name: author.name }) %>
                    </h3>
                    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                        <% books.forEach(book=> { %>
                            <div class="col">
                                <div class="card h-100 shadow-sm book-card">
                                    <img src="<%= book.cover_url || '/images/default-cover.jpg' %>" class="card-img-top"
                                        alt="<%= book.title %>">
                                    <div class="card-body p-4">
                                        <h6 class="fw-bold mb-2 text-truncate">
                                            <%= book.title %>
                                        </h6>
                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <span class="fw-bold text-primary fs-5">
                                                <%= book.price %>€
                                            </span>
                                            <a href="/books/book/<%= book.id %>"
                                                class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                                <%= t('author_detail.view_details') %>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>

                    <% if(user && user.role==="ADMIN" ) { %>
                        <div
                            class="mt-5 p-4 bg-dark text-white rounded-4 shadow-lg d-flex align-items-center justify-content-between">
                            <div>
                                <h5 class="fw-bold m-0">
                                    <%= t('admin.panel') %>
                                </h5>
                                <p class="small text-white-50 m-0">Gestión de perfil del autor</p>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="/authors/author/edit/<%= author.id %>"
                                    class="btn btn-primary rounded-pill px-4">
                                    <%= t('author_detail.edit_author') %>
                                </a>
                                <% const confirmMsg=t('admin.confirm').replace(/'/g, "\\'" ); %>
                                    <form action="/authors/author/delete/<%= author.id %>" method="POST"
                                        class="d-inline">
                                        <button type="submit" class="btn btn-danger rounded-pill px-4"
                                            onclick="return confirm('<%= confirmMsg %>')">
                                            <%= t('author_detail.delete_author') %>
                                        </button>
                                    </form>
                            </div>
                        </div>
                        <% } %>
                </div>
            </div>
        </main>
        <%- include('../layout/footer') %>
</body>

</html>