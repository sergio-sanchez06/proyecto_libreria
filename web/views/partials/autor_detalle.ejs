<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= author.name %> - <%= t('author_detail.biography') %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/author_detail.css">
</head>

<body>
    <%- include('../layout/header') %>

        <div class="container py-5">
            <div class="author-header text-center mb-5">
                <img src="<%= author.photo_url || '/images/default-author.jpg' %>" alt="<%= author.name %>"
                    class="rounded-circle mb-3" style="width: 150px; height: 150px; object-fit: cover;">
                <h1 class="fw-bold">
                    <%= author.name %>
                </h1>
                <% if (author.country) { %>
                    <p class="lead text-muted">
                        <%= author.country %>
                    </p>
                    <% } %>
            </div>

            <div class="author-info mb-5">
                <h2 class="text-center mb-4">
                    <%= t('author_detail.biography') %>
                </h2>
                <% if (author.biography) { %>
                    <p class="text-justify">
                        <%= author.biography %>
                    </p>
                    <% } else { %>
                        <p class="text-muted text-center">
                            <%= t('author_detail.no_biography') %>
                        </p>
                        <% } %>
            </div>

            <section class="books-section">
                <h2 class="text-center mb-4">
                    <%= t('author_detail.books_by', { name: author.name }) %>
                </h2>

                <% if (books && books.length> 0) { %>
                    <div class="row justify-content-center g-4">
                        <% books.forEach(book=> { %>
                            <div class="col-md-3">
                                <div class="card h-100 shadow-sm book-card border-0">
                                    <img src="<%= book.cover_url || '/images/default-cover.jpg' %>" class="card-img-top"
                                        alt="<%= book.title %>">
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title text-truncate" title="<%= book.title %>">
                                            <%= book.title %>
                                        </h5>
                                        <p class="card-text text-muted small">
                                            <%= t('author_detail.year') %>: <%= book.releashed_year ||
                                                    t('author_detail.unknown_year') %>
                                        </p>
                                        <p class="card-text fw-bold text-primary mt-auto fs-5">
                                            <%= book.price %>€
                                        </p>
                                        <a href="/books/book/<%= book.id %>"
                                            class="btn btn-primary btn-sm mt-2 rounded-pill">
                                            <%= t('author_detail.view_details') %>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                    <% } else { %>
                        <p class="text-center text-muted">
                            <%= t('author_detail.no_books') %>
                        </p>
                        <% } %>
            </section>

            <div class="mt-5 pt-4 border-top text-center">
                <% if(user && user.role==="ADMIN" ) { %>
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <a href="/authors/author/edit/<%= author.id %>" class="btn btn-warning rounded-pill px-4">
                            <%= t('author_detail.edit_author') %>
                        </a>

                        <%# Guardamos la traducción en una variable para evitar conflictos de comillas %>
                            <% const confirmMsg=t('admin.confirm'); %>

                                <form action="/authors/author/delete/<%= author.id %>" method="POST" class="d-inline">
                                    <input type="hidden" name="id" value="<%= author.id %>">
                                    <button type="submit" class="btn btn-danger rounded-pill px-4"
                                        onclick="return confirm('<%= confirmMsg %>')">
                                        <%= t('author_detail.delete_author') %>
                                    </button>
                                </form>
                    </div>
                    <% } else { %>
                        <div class="mt-4 text-center">
                            <a href="/" class="text-decoration-none">
                                <%= t('author_detail.back') %>
                            </a>
                        </div>
                        <% } %>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <%- include('../layout/footer') %>
</body>

</html>