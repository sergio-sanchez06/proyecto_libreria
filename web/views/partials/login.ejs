<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/login.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>
        <%= t('login.title') %> - Librería
    </title>
</head>

<body>

    <%- include('../layout/header') %>

        <main class="container py-5">
            <div class="row justify-content-center">
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-body p-5">
                            <h1 class="card-title text-center mb-4 fw-bold">
                                <%= t('login.welcome') %>
                            </h1>

                            <% if (error) { %>
                                <div class="alert alert-danger">
                                    <%= error %>
                                </div>
                                <% } %>

                                    <form id="loginForm" action="/login" method="POST">
                                        <input type="hidden" name="idToken" id="idTokenInput">

                                        <div class="mb-3">
                                            <label for="email" class="form-label">
                                                <%= t('login.email') %>
                                            </label>
                                            <input type="email" id="email" class="form-control"
                                                placeholder="ejemplo@correo.com">
                                        </div>

                                        <div class="mb-3">
                                            <label for="password" class="form-label">
                                                <%= t('login.password') %>
                                            </label>
                                            <input type="password" id="password" class="form-control"
                                                placeholder="••••••••">
                                        </div>

                                        <button type="submit" id="btnSubmit"
                                            class="btn btn-primary w-100 mb-3 rounded-pill">
                                            <%= t('login.btn_login') %>
                                        </button>

                                        <div class="text-center my-4 text-muted position-relative">
                                            <hr>
                                            <span
                                                class="px-3 bg-white position-absolute top-50 start-50 translate-middle">
                                                <%= t('login.or_continue') %>
                                            </span>
                                        </div>

                                        <div class="d-grid gap-2">
                                            <button type="button" id="btnGoogle"
                                                class="btn btn-outline-dark rounded-pill">
                                                <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
                                                    width="18" class="me-2">
                                                Google
                                            </button>

                                            <button type="button" id="btnTwitter"
                                                class="btn btn-outline-info rounded-pill">
                                                <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/twitter.svg"
                                                    width="18" class="me-2">
                                                X (Twitter)
                                            </button>
                                        </div>
                                    </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../layout/footer') %>

            <script type="module">
                import { getFirebaseToken, getGoogleToken, getTwitterToken } from "/js/auth.mjs";

                // Capturamos traducciones desde EJS para usar en el JS
                const txtProcessing = "<%= t('login.processing') %>";
                const txtDefaultBtn = "<%= t('login.btn_login') %>";
                const txtErrorAccess = "<%= t('login.error_access') %>";
                const txtErrorSocial = "<%= t('login.error_social') %>";

                const loginForm = document.getElementById("loginForm");
                const idTokenInput = document.getElementById("idTokenInput");
                const btnSubmit = document.getElementById("btnSubmit");
                const btnGoogle = document.getElementById("btnGoogle");
                const btnTwitter = document.getElementById("btnTwitter");

                const setLoading = (isLoading) => {
                    const btns = [btnSubmit, btnGoogle, btnTwitter];
                    btns.forEach(b => b.disabled = isLoading);
                    btnSubmit.textContent = isLoading ? txtProcessing : txtDefaultBtn;
                };

                // --- LOGIN TRADICIONAL ---
                loginForm.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    setLoading(true);

                    const email = document.getElementById("email").value;
                    const password = document.getElementById("password").value;

                    try {
                        const token = await getFirebaseToken(email, password);
                        idTokenInput.value = token;
                        loginForm.action = "/login";
                        loginForm.submit();
                    } catch (error) {
                        alert(txtErrorAccess + error.message);
                        setLoading(false);
                    }
                });

                // --- LOGIN SOCIAL ---
                const handleSocialLogin = async (providerFn) => {
                    setLoading(true);
                    try {
                        const token = await providerFn();
                        idTokenInput.value = token;
                        loginForm.action = "/login-social";
                        loginForm.submit();
                    } catch (error) {
                        console.error(error);
                        alert(txtErrorSocial);
                        setLoading(false);
                    }
                };

                btnGoogle.addEventListener("click", () => handleSocialLogin(getGoogleToken));
                btnTwitter.addEventListener("click", () => handleSocialLogin(getTwitterToken));
            </script>
</body>

</html>