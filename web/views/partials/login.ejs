<%- include('../layout/header') %>

<style>
    body {
        background-image: url('/images/auth_drawing_pattern.png');
        background-repeat: repeat;
        background-size: 400px;
        background-attachment: fixed;
        background-color: #fcfaf7;
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    body::before {
        content: "";
        position: fixed;
        top: 0; left: 0; width: 100vw; height: 100vh;
        background: rgba(252, 250, 247, 0.85); 
        z-index: -1;
    }

    main {
        flex: 1;
        padding-top: 3rem;
        padding-bottom: 3rem;
    }

    .card {
        border: none;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
        transition: transform 0.3s ease;
    }

    .card-title {
        color: var(--brand-teal);
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .form-label {
        font-weight: 600;
        color: #4a5568;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }

    .form-control {
        border-radius: 12px;
        padding: 12px 16px;
        border: 1px solid rgba(0, 0, 0, 0.1);
        background: rgba(255, 255, 255, 0.6);
        transition: all 0.3s ease;
    }

    .form-control:focus {
        background: rgba(255, 255, 255, 0.9);
        border-color: var(--brand-gold);
        box-shadow: 0 0 0 4px rgba(194, 151, 59, 0.15);
    }

    .btn-primary {
        background-color: var(--brand-teal) !important;
        border: none;
        padding: 12px;
        font-weight: 700;
        border-radius: 12px;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background-color: var(--brand-teal-hover) !important;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(13, 92, 99, 0.2);
    }

    .btn-outline-dark, .btn-outline-info {
        border-radius: 12px;
        padding: 10px;
        font-weight: 500;
        border: 1px solid rgba(0, 0, 0, 0.1);
        background: rgba(255, 255, 255, 0.5);
        transition: all 0.3s ease;
    }

    .btn-outline-dark:hover {
        background: #f8fafc;
        border-color: #000;
        transform: translateY(-2px);
    }

    .btn-outline-info {
        color: #1da1f2;
        border-color: rgba(29, 161, 242, 0.2);
    }

    .btn-outline-info:hover {
        background: rgba(29, 161, 242, 0.05);
        border-color: #1da1f2;
        color: #1da1f2;
        transform: translateY(-2px);
    }

    hr {
        opacity: 0.1;
    }

    .bg-white.position-absolute {
        background: #fcfaf7 !important;
        font-size: 0.8rem;
        font-weight: 500;
        color: #a0aec0;
    }

    .password-field-container {
        position: relative;
    }

    .password-field-container .form-control {
        padding-right: 45px;
    }

    .toggle-password-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: none;
        color: #718096;
        cursor: pointer;
        padding: 4px 8px;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s ease;
    }

    .toggle-password-btn:hover {
        color: #2c3e50;
    }
</style>

<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <h1 class="card-title text-center mb-4 fw-bold">
                        <%= t('login.welcome') %>
                    </h1>

                    <% if (error) { %>
                        <div class="alert alert-danger">
                            <%= error %>
                        </div>
                    <% } %>

                    <form id="loginForm" action="/login" method="POST">
                        <input type="hidden" name="idToken" id="idTokenInput">

                        <div class="mb-3">
                            <label for="email" class="form-label">
                                <%= t('login.email') %>
                            </label>
                            <input type="email" id="email" class="form-control"
                                placeholder="ejemplo@correo.com">
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">
                                <%= t('login.password') %>
                            </label>
                            <div class="password-field-container">
                                <input type="password" id="password" class="form-control"
                                    placeholder="••••••••">
                                <button type="button" class="toggle-password-btn" id="togglePasswordBtn" aria-label="Mostrar contraseña">
                                    <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit" id="btnSubmit"
                            class="btn btn-primary w-100 mb-3 rounded-pill">
                            <%= t('login.btn_login') %>
                        </button>

                        <div class="text-center my-4 text-muted position-relative">
                            <hr>
                            <span
                                class="px-3 bg-white position-absolute top-50 start-50 translate-middle">
                                <%= t('login.or_continue') %>
                            </span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="button" id="btnGoogle"
                                class="btn btn-outline-dark rounded-pill">
                                <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
                                    width="18" class="me-2">
                                Google
                            </button>

                            <button type="button" id="btnTwitter"
                                class="btn btn-outline-info rounded-pill">
                                <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/twitter.svg"
                                    width="18" class="me-2">
                                X (Twitter)
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('../layout/footer') %>

<script type="module">
    import { getFirebaseToken, getGoogleToken, getTwitterToken } from "/js/auth.mjs";

    const txtProcessing = "<%= t('login.processing') %>";
    const txtDefaultBtn = "<%= t('login.btn_login') %>";
    const txtErrorAccess = "<%= t('login.error_access') %>";
    const txtErrorSocial = "<%= t('login.error_social') %>";

    const loginForm = document.getElementById("loginForm");
    const idTokenInput = document.getElementById("idTokenInput");
    const btnSubmit = document.getElementById("btnSubmit");
    const btnGoogle = document.getElementById("btnGoogle");
    const btnTwitter = document.getElementById("btnTwitter");

    const setLoading = (isLoading) => {
        const btns = [btnSubmit, btnGoogle, btnTwitter];
        btns.forEach(b => b.disabled = isLoading);
        btnSubmit.textContent = isLoading ? txtProcessing : txtDefaultBtn;
    };

    loginForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        setLoading(true);

        const email = document.getElementById("email").value;
        const password = document.getElementById("password").value;

        try {
            const token = await getFirebaseToken(email, password);
            idTokenInput.value = token;
            loginForm.action = "/login";
            loginForm.submit();
        } catch (error) {
            alert(txtErrorAccess + error.message);
            setLoading(false);
        }
    });

    const handleSocialLogin = async (providerFn) => {
        setLoading(true);
        try {
            const token = await providerFn();
            idTokenInput.value = token;
            loginForm.action = "/login-social";
            loginForm.submit();
        } catch (error) {
            console.error(error);
            alert(txtErrorSocial);
            setLoading(false);
        }
    };

    btnGoogle.addEventListener("click", () => handleSocialLogin(getGoogleToken));
    btnTwitter.addEventListener("click", () => handleSocialLogin(getTwitterToken));

    const togglePasswordBtn = document.getElementById("togglePasswordBtn");
    const passwordInput = document.getElementById("password");
    const togglePasswordIcon = document.getElementById("togglePasswordIcon");

    if (togglePasswordBtn && passwordInput && togglePasswordIcon) {
        togglePasswordBtn.addEventListener("click", () => {
            const type = passwordInput.getAttribute("type") === "password" ? "text" : "password";
            passwordInput.setAttribute("type", type);
            
            togglePasswordIcon.classList.toggle("bi-eye");
            togglePasswordIcon.classList.toggle("bi-eye-slash");
        });
    }
</script>
</body>

</html>