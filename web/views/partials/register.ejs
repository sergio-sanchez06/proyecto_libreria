<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= t('register.title') %>
    </title>
    <link rel="stylesheet" href="/css/register.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <%- include('../layout/header') %>

        <main class="container py-5">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-success text-white text-center py-3">
                            <h2 class="mb-0 fs-4">
                                <%= t('register.title') %>
                            </h2>
                        </div>
                        <div class="card-body p-4">
                            <% if (error) { %>
                                <div class="alert alert-danger">
                                    <%= error %>
                                </div>
                                <% } %>

                                    <form action="/register" method="POST" id="register-form">

                                        <div class="mb-3">
                                            <label for="name" class="form-label fw-bold">
                                                <%= t('register.name') %>
                                                    <%= t('register.required_mark') %>
                                            </label>
                                            <input type="text" name="name" id="name" class="form-control"
                                                value="<%= formData ? formData.name : '' %>" required>
                                        </div>

                                        <div class="mb-3">
                                            <label for="email" class="form-label fw-bold">
                                                <%= t('register.email') %>
                                                    <%= t('register.required_mark') %>
                                            </label>
                                            <input type="email" name="email" id="email" class="form-control"
                                                value="<%= formData ? formData.email : '' %>" required>
                                        </div>

                                        <div class="mb-3">
                                            <label for="password" class="form-label fw-bold">
                                                <%= t('register.password') %>
                                                    <%= t('register.required_mark') %>
                                            </label>
                                            <input type="password" name="password" id="password" class="form-control"
                                                required minlength="6">
                                            <div class="form-text">
                                                <%= t('register.password_hint') %>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="default_address" class="form-label fw-bold">
                                                <%= t('register.address_main') %>
                                                    <%= t('register.required_mark') %>
                                            </label>
                                            <textarea name="default_address" id="default_address" class="form-control"
                                                rows="2"
                                                required><%= formData ? formData.default_address : '' %></textarea>
                                        </div>

                                        <div class="mb-4">
                                            <label for="optional_address" class="form-label fw-bold">
                                                <%= t('register.address_optional') %>
                                            </label>
                                            <textarea name="optional_address" id="optional_address" class="form-control"
                                                rows="2"><%= formData ? formData.optional_address : '' %></textarea>
                                        </div>

                                        <div class="d-grid gap-2">
                                            <button type="submit" id="register-btn"
                                                class="btn btn-success btn-lg rounded-pill">
                                                <span id="btn-text">
                                                    <%= t('register.submit') %>
                                                </span>
                                            </button>
                                        </div>
                                    </form>
                        </div>
                        <div class="card-footer text-center bg-light py-3">
                            <p class="mb-0">
                                <%= t('register.already_account') %>
                                    <a href="/login" class="text-success fw-bold text-decoration-none">
                                        <%= t('register.login_link') %>
                                    </a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../layout/footer') %>

            <script>
                document.getElementById('register-form').addEventListener('submit', function () {
                    const btn = document.getElementById('register-btn');
                    const btnText = document.getElementById('btn-text');
                    btn.disabled = true;
                    btnText.textContent = "Procesando registro...";
                });
            </script>

</body>

</html>