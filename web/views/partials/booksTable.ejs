<%- include('../layout/header', { 
    title: t('catalog.title'),
    bodyClass: 'bg-main-vistas' 
}) %>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    body {
        font-family: 'Inter', sans-serif;
    }

    body::before {
        content: "";
        position: fixed;
        top: 0; left: 0; width: 100vw; height: 100vh;
        background: rgba(252, 250, 247, 0.45);
        z-index: -1;
    }

    .section-title {
        font-weight: 800;
        color: var(--brand-teal);
        position: relative;
        padding-bottom: 12px;
        margin-bottom: 2rem;
        letter-spacing: -0.5px;
        text-transform: uppercase;
        font-size: 2rem;
    }
    
    .section-title::after {
        content: '';
        width: 80px;
        height: 5px;
        background: var(--brand-gold);
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        border-radius: 10px;
    }

    .filter-sidebar {
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.85) !important;
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    }

    .card {
        border: none;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(8px);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid rgba(255,255,255,0.4);
    }

    .card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(30, 64, 175, 0.1);
        border-color: rgba(30, 64, 175, 0.2);
    }

    .book-img-container {
        height: 220px;
        background: rgba(245, 247, 250, 0.5);
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        padding: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .book-img-container img {
        filter: drop-shadow(0 10px 15px rgba(0,0,0,0.15));
        transition: transform 0.3s ease;
    }
    
    .card:hover .book-img-container img {
        transform: scale(1.05);
    }

    .btn-primary {
        background-color: var(--brand-teal);
        border-color: var(--brand-teal);
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    
    .btn-primary:hover {
        background-color: var(--brand-teal-hover);
        border-color: var(--brand-teal-hover);
        box-shadow: 0 6px 15px rgba(30, 64, 175, 0.25);
        transform: translateY(-2px);
    }

    .btn-success {
        background-color: var(--brand-gold);
        border-color: var(--brand-gold);
        color: #1e3a8a;
        border-radius: 12px;
        font-weight: 700;
        transition: all 0.3s ease;
    }
    
    .btn-success:hover {
        background-color: #e5c358;
        border-color: #e5c358;
        color: #1e3a8a;
        box-shadow: 0 6px 15px rgba(212, 175, 55, 0.3);
        transform: translateY(-2px);
    }

    .btn-outline-dark {
        border-radius: 12px;
        font-weight: 600;
        color: var(--brand-teal);
        border-color: var(--brand-teal);
        transition: all 0.3s ease;
    }
    
    .btn-outline-dark:hover {
        background-color: var(--brand-teal);
        color: white;
    }

    .pagination .page-link {
        border: none;
        border-radius: 10px;
        margin: 0 4px;
        color: var(--brand-teal);
        font-weight: 600;
        padding: 0.5rem 1rem;
        transition: all 0.2s ease;
    }

    .pagination .page-item.active .page-link {
        background: var(--brand-teal);
        color: white;
        box-shadow: 0 4px 10px rgba(30, 64, 175, 0.2);
    }

    .scrollable-filter-container {
        max-height: 200px;
        overflow-y: auto;
        padding-right: 8px;
    }
    
    /* Custom Scrollbar for filters */
    .scrollable-filter-container::-webkit-scrollbar {
        width: 6px;
    }
    .scrollable-filter-container::-webkit-scrollbar-track {
        background: rgba(0,0,0,0.05);
        border-radius: 10px;
    }
    .scrollable-filter-container::-webkit-scrollbar-thumb {
        background: rgba(30, 64, 175, 0.2);
        border-radius: 10px;
    }
    .scrollable-filter-container::-webkit-scrollbar-thumb:hover {
        background: rgba(30, 64, 175, 0.5);
    }
    
    .form-check-input:checked {
        background-color: var(--brand-teal);
        border-color: var(--brand-teal);
    }
</style>

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="section-title text-center">
            <%= t('catalog.title') %>
        </h2>
        <p class="text-muted mt-3" style="font-size: 1.1rem;">
            <%= t('catalog.subtitle') %>
        </p>
    </div>

    <div class="row">
        <aside class="col-lg-3 mb-4">
            <div class="filter-sidebar p-4">
                <h5 class="mb-4 d-flex align-items-center border-bottom pb-3 fw-bold" style="color: var(--brand-teal);">
                    <i class="bi bi-funnel-fill me-2 text-warning"></i>
                    <%= t('catalog.filters') || 'Filtrar por' %>
                </h5>

                <form action="/books/showAllBooks" method="GET">
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-muted">Nombre del libro</label>
                        <div class="input-group input-group-sm shadow-sm rounded-3 overflow-hidden">
                            <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="q" class="form-control border-0 py-2" placeholder="Buscar..."
                                value="<%= query.q || '' %>">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-muted">Categoría</label>
                        <div class="scrollable-filter-container p-2 bg-white rounded-3 shadow-sm">
                            <div class="form-check mb-2">
                                <input class="form-check-input shadow-sm" type="radio" name="genre" id="genre_all" value=""
                                    <%=!query.genre ? 'checked' : '' %>>
                                <label class="form-check-label text-dark fw-medium" for="genre_all">
                                    <%= t('catalog.all_genres') || 'Todos los géneros' %>
                                </label>
                            </div>
                            <% if (typeof genres !=='undefined' && genres) { %>
                                <% genres.forEach(g=> { %>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input shadow-sm" type="radio" name="genre"
                                            id="genre_<%= g.id %>" value="<%= g.id %>" <%=query.genre==g.id
                                            ? 'checked' : '' %>>
                                        <label class="form-check-label text-muted" for="genre_<%= g.id %>">
                                            <%= g.name %>
                                        </label>
                                    </div>
                                    <% }) %>
                                        <% } %>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-muted">Autor</label>
                        <div class="scrollable-filter-container p-2 bg-white rounded-3 shadow-sm">
                            <div class="form-check mb-2">
                                <input class="form-check-input shadow-sm" type="radio" name="author" id="author_all" value=""
                                    <%=!query.author ? 'checked' : '' %>>
                                <label class="form-check-label text-dark fw-medium" for="author_all">
                                    Todos los autores
                                </label>
                            </div>
                            <% if (typeof authors !=='undefined' && authors) { %>
                                <% authors.forEach(a=> { %>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input shadow-sm" type="radio" name="author"
                                            id="author_<%= a.id %>" value="<%= a.id %>" <%=query.author==a.id
                                            ? 'checked' : '' %>>
                                        <label class="form-check-label text-muted" for="author_<%= a.id %>">
                                            <%= a.name %>
                                        </label>
                                    </div>
                                    <% }) %>
                                        <% } %>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-muted mb-3 d-flex justify-content-between">
                            <span>Precio máx:</span> 
                            <span class="badge bg-primary text-white rounded-pill px-3"><span id="priceVal"><%= query.maxPrice || 100 %></span>€</span>
                        </label>
                        <input type="range" name="maxPrice" class="form-range" min="0" max="150" step="5"
                            id="priceRange" value="<%= query.maxPrice || 100 %>"
                            oninput="document.getElementById('priceVal').innerText = this.value">
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-sm py-2 px-3 shadow-sm rounded-pill"><i class="bi bi-funnel-fill me-1"></i> Aplicar Filtros</button>
                        <a href="/books/showAllBooks" class="btn btn-outline-dark btn-sm py-2 rounded-pill"><i class="bi bi-eraser-fill me-1"></i> Limpiar</a>
                    </div>
                </form>
            </div>
        </aside>

        <main class="col-lg-9">
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
                <% if (books && books.length> 0) { %>
                    <% books.forEach(book=> { %>
                        <% if (book.deleted_at===null) { %>
                            <div class="col">
                                <div class="card h-100 p-2">
                                    <div class="book-img-container">
                                        <img src="<%= book.cover_url || '/images/default-cover.jpg' %>"
                                            class="mh-100 mw-100" style="object-fit: contain;"
                                            alt="<%= book.title %>">
                                    </div>

                                    <div class="card-body d-flex flex-column px-2 pb-2 pt-3 text-center">
                                        <h6 class="card-title fw-bold mb-2 text-dark"
                                            style="font-size: 0.95rem; min-height: 2.7rem; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"
                                            title="<%= book.title %>">
                                            <%= book.title %>
                                        </h6>

                                        <p class="mb-3" style="font-size: 1.25rem; font-weight: 800; color: var(--brand-teal);">
                                            <%= book.price %>€
                                        </p>

                                        <div class="mt-auto">
                                            <div class="d-flex flex-column gap-2">
                                                <a href="/books/book/<%= book.id %>"
                                                    class="btn btn-outline-dark btn-sm py-2 w-100">
                                                    <i class="bi bi-eye"></i> Detalles
                                                </a>

                                                <form action="/cart/add" method="POST" class="d-flex gap-2">
                                                    <input type="hidden" name="book_id" value="<%= book.id %>">
                                                    <input type="number" name="quantity" value="1" min="1"
                                                        class="form-control form-control-sm text-center shadow-sm"
                                                        style="width: 60px; border-radius: 8px; border: 1px solid rgba(0,0,0,0.1);">
                                                    <button type="submit"
                                                        class="btn btn-success btn-sm flex-grow-1 shadow-sm px-0">
                                                        <i class="bi bi-cart-plus-fill me-1"></i> Añadir
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% } %>
                                <% }) %>
                                    <% } else { %>
                                        <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm">
                                            <div class="mx-auto bg-light rounded-circle d-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px;">
                                                <i class="bi bi-search display-4 text-muted opacity-50"></i>
                                            </div>
                                            <h4 class="fw-bold mb-2 text-dark">No hay resultados</h4>
                                            <p class="text-muted">Intenta cambiar los filtros o el término de búsqueda.</p>
                                            <a href="/books/showAllBooks" class="btn btn-primary mt-3 px-4 rounded-pill">Quitar filtros</a>
                                        </div>
                                        <% } %>
            </div>

            <% if (typeof totalPages !=='undefined' && totalPages> 1) {
                const getPageUrl = (p) => {
                const params = new URLSearchParams(query);
                params.set('page', p);
                return '?' + params.toString();
                };
                %>
                <nav class="mt-5 pt-3">
                    <ul class="pagination pagination-sm justify-content-center">
                        <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="<%= getPageUrl(parseInt(currentPage) - 1) %>">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        <% for(let i=1; i <=totalPages; i++) { %>
                            <li class="page-item <%= currentPage == i ? 'active' : '' %>">
                                <a class="page-link" href="<%= getPageUrl(i) %>">
                                    <%= i %>
                                </a>
                            </li>
                            <% } %>
                                <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                                    <a class="page-link"
                                        href="<%= getPageUrl(parseInt(currentPage) + 1) %>">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                    </ul>
                </nav>
                <% } %>
        </main>
    </div>
</div>

<%- include('../layout/footer') %>