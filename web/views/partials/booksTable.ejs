<%- include('../layout/header') %>

<div class="container py-3">
    <div class="text-center mb-3">
        <h2 class="fw-bold text-dark mb-1">
            <%= t('catalog.title') %>
        </h2>
        <p class="text-muted small">
            <%= t('catalog.subtitle') %>
        </p>
    </div>

    <div class="row">
        <aside class="col-lg-3 mb-4">
            <div class="filter-sidebar p-4 shadow-sm bg-light rounded-3">
                <h5 class="mb-4 d-flex align-items-center border-bottom pb-2">
                    <i class="bi bi-sliders me-2"></i> <%= t('catalog.filters') || 'Filtrar por' %>
                </h5>
                
                <form action="/books/showAllBooks" method="GET"> 
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-muted">Nombre del libro</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                            <input type="text" name="q" class="form-control border-start-0" 
                                   placeholder="Buscar..." value="<%= query.q || '' %>">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-muted">Categoría</label>
                        <div class="scrollable-filter-container">
                            <div class="form-check small">
                                <input class="form-check-input" type="radio" name="genre" id="genre_all" value="" <%= !query.genre ? 'checked' : '' %>>
                                <label class="form-check-label" for="genre_all">
                                    <%= t('catalog.all_genres') || 'Todos los géneros' %>
                                </label>
                            </div>
                            <% if (typeof genres !== 'undefined' && genres) { %>
                                <% genres.forEach(g => { %>
                                    <div class="form-check small">
                                        <input class="form-check-input" type="radio" name="genre" id="genre_<%= g.id %>" value="<%= g.id %>" <%= query.genre == g.id ? 'checked' : '' %>>
                                        <label class="form-check-label" for="genre_<%= g.id %>">
                                            <%= g.name %>
                                        </label>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-muted">Autor</label>
                        <div class="scrollable-filter-container">
                            <div class="form-check small">
                                <input class="form-check-input" type="radio" name="author" id="author_all" value="" <%= !query.author ? 'checked' : '' %>>
                                <label class="form-check-label" for="author_all">
                                    Todos los autores
                                </label>
                            </div>
                            <% if (typeof authors !== 'undefined' && authors) { %>
                                <% authors.forEach(a => { %>
                                    <div class="form-check small">
                                        <input class="form-check-input" type="radio" name="author" id="author_<%= a.id %>" value="<%= a.id %>" <%= query.author == a.id ? 'checked' : '' %>>
                                        <label class="form-check-label" for="author_<%= a.id %>">
                                            <%= a.name %>
                                        </label>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-muted">
                            Precio máx: <span id="priceVal" class="text-success"><%= query.maxPrice || 100 %></span>€
                        </label>
                        <input type="range" name="maxPrice" class="form-range" min="0" max="150" step="5" 
                               id="priceRange" value="<%= query.maxPrice || 100 %>"
                               oninput="document.getElementById('priceVal').innerText = this.value">
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-sm fw-bold">Aplicar</button>
                        <a href="/books/showAllBooks" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                    </div>
                </form>
            </div>
        </aside>

        <main class="col-lg-9">
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3">
                <% if (books && books.length > 0) { %>
                    <% books.forEach(book => { %>
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0 rounded-3">
                                <div style="height: 180px; overflow: hidden; background: #f8f9fa;" class="rounded-top d-flex align-items-center justify-content-center">
                                    <img src="<%= book.cover_url || '/images/default-cover.jpg' %>"
                                         class="mh-100 mw-100" style="object-fit: contain; padding: 5px;" alt="<%= book.title %>">
                                </div>

                                <div class="card-body d-flex flex-column p-2">
                                    <h6 class="card-title fw-bold mb-1" style="font-size: 0.85rem; height: 2.4rem; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;" title="<%= book.title %>">
                                        <%= book.title %>
                                    </h6>
                                    
                                    <p class="text-success fw-bold mb-2" style="font-size: 1rem;">
                                        <%= book.price %>€
                                    </p>

                                    <div class="mt-auto">
                                        <div class="d-grid gap-1">
                                            <a href="/books/book/<%= book.id %>" class="btn btn-outline-dark btn-sm py-1" style="font-size: 0.75rem;">Detalles</a>
                                            
                                            <form action="/cart/add" method="POST" class="d-flex gap-1">
                                                <input type="hidden" name="book_id" value="<%= book.id %>">
                                                <input type="number" name="quantity" value="1" min="1" 
                                                       class="form-control form-control-sm px-1" style="width: 40px; font-size: 0.75rem;">
                                                <button type="submit" class="btn btn-success btn-sm flex-grow-1 py-1" style="font-size: 0.75rem;">
                                                    Añadir 🛒
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12 text-center py-5">
                        <i class="bi bi-emoji-frown display-1 text-muted"></i>
                        <p class="mt-3 fs-5 text-muted">No hay resultados para esta búsqueda.</p>
                    </div>
                <% } %>
            </div>

            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { 
                const getPageUrl = (p) => {
                    const params = new URLSearchParams(query);
                    params.set('page', p);
                    return '?' + params.toString();
                };
            %>
                <nav class="mt-5">
                    <ul class="pagination pagination-sm justify-content-center">
                        <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="<%= getPageUrl(parseInt(currentPage) - 1) %>">&laquo;</a>
                        </li>
                        <% for(let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= currentPage == i ? 'active' : '' %>">
                                <a class="page-link" href="<%= getPageUrl(i) %>"><%= i %></a>
                            </li>
                        <% } %>
                        <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="<%= getPageUrl(parseInt(currentPage) + 1) %>">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            <% } %>
        </main>
    </div>
</div>

<%- include('../layout/footer') %>