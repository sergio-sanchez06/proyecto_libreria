<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Explorar Géneros Literarios</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/main.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

        body {
            background-image: url('/images/book_drawing_pattern.png');
            background-repeat: repeat;
            background-size: 500px;
            background-attachment: fixed;
            background-color: #fcfaf7;
            font-family: 'Inter', sans-serif;
        }

        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(252, 250, 247, 0.88);
            z-index: -1;
        }

        .section-title {
            font-weight: 800;
            color: var(--brand-teal);
            position: relative;
            padding-bottom: 8px;
            margin-bottom: 1.5rem;
        }

        .genre-card {
            border: none;
            border-radius: 24px;
            background: rgba(255, 255, 255, 0.8) !important;
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.04);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .genre-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08) !important;
            background: rgba(255, 255, 255, 0.95) !important;
        }

        .icon-box {
            width: 70px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 20px;
            background-color: #fcfaf7;
            color: var(--brand-teal);
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.03);
            transition: all 0.3s ease;
        }

        .genre-card:hover .icon-box {
            background-color: var(--brand-teal);
            color: #fff;
            transform: scale(1.1) rotate(5deg);
        }

        .btn-outline-primary {
            border-color: var(--brand-teal);
            color: var(--brand-teal);
            border-radius: 14px;
            font-weight: 700;
            padding: 10px;
            transition: all 0.3s ease;
        }

        .btn-outline-primary:hover {
            background-color: var(--brand-teal);
            border-color: var(--brand-teal);
            color: #fff;
            transform: translateY(-2px);
        }
    </style>
</head>

<body class="bg-light">

    <%- include('../layout/header') %>

        <div class="container py-5">
            <header class="text-center mb-5">
                <h1 class="display-4 fw-bold">
                    <%= t('genres.title') %>
                </h1>
                <p class="text-muted">
                    <%= t('genres.subtitle') %>
                </p>
                <hr class="w-25 mx-auto border-primary border-2 opacity-75">
            </header>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                <% genres.forEach(genre=> { %>
                    <div class="col">
                        <div class="card h-100 shadow-sm genre-card">
                            <div class="card-body d-flex flex-column align-items-center text-center p-4">
                                <div class="icon-box">
                                    <i class="bi bi-book-half fs-4"></i>
                                </div>

                                <h5 class="card-title fw-bold mb-3">
                                    <%= genre.name %>
                                </h5>

                                <p class="card-text small text-muted mb-4">
                                    <%= t('genres.description', { name: genre.name }) %>
                                </p>

                                <a href="/genres/<%= genre.name %>"
                                    class="btn btn-outline-primary btn-sm mt-auto w-100 rounded-pill">
                                    <%= t('genres.explore') %>
                                </a>
                            </div>
                        </div>
                    </div>
                    <% }) %>
            </div>
        </div>

        <%- include('../layout/footer') %>

</body>

</html>