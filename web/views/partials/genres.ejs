<%- include('../layout/header', { 
    bodyClass: 'bg-main-vistas',
    extraCSS: 'partials/genres'
}) %>

<div class="container py-5">
    <header class="text-center mb-5 pb-3">
        <h1 class="section-title text-center mx-auto" style="width: fit-content;">
            <%= t('genres.title') %>
        </h1>
        <p class="text-muted mt-3" style="font-size: 1.15rem;">
            <%= t('genres.subtitle') %>
        </p>
    </header>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        <% genres.forEach(genre=> { %>
            <div class="col">
                <div class="card h-100 shadow-sm genre-card p-2">
                    <div class="card-body d-flex flex-column align-items-center text-center p-4">
                        <div class="icon-box">
                            <i class="bi bi-bookmarks-fill fs-3"></i>
                        </div>

                        <h5 class="card-title fw-bold mb-3 text-dark" style="font-size: 1.25rem;">
                            <%= genre.name %>
                        </h5>

                        <p class="card-text small text-muted mb-4 opacity-75">
                            <%= t('genres.description', { name: genre.name }) || 'Explora todos los libros de esta categoría.' %>
                        </p>

                        <a href="/genres/<%= genre.name %>"
                            class="btn btn-outline-primary btn-sm mt-auto w-100 rounded-pill">
                            <%= t('genres.explore') %> <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<%- include('../layout/footer') %>