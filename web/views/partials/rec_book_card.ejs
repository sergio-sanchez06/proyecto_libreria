<% 
    const coverUrl = book.cover_url || '/images/default-cover.jpg'; 
    const title = book.title || 'Sin título'; 
    const price = parseFloat(book.price || 0).toFixed(2); 
    const score = parseFloat(book.score || 0); 
    const isRecommended = typeof showScore !== 'undefined' && showScore && score > 0;
%>

<div class="card h-100 book-card shadow-sm border-0">
    <div class="position-relative overflow-hidden">
        <img src="<%= coverUrl %>"
            class="card-img-top p-2 p-md-3 bg-light"
            style="height: clamp(150px, 20vh, 250px); object-fit: contain;"
            alt="<%= title %>" width="180" height="220" loading="lazy">
        
        <% if (isRecommended) { %>
            <div class="position-absolute top-0 end-0 m-2">
                <span class="badge bg-warning text-dark shadow-sm">
                    <i class="bi bi-star-fill me-1"></i><%= (score * 100).toFixed(0) %>% Match
                </span>
            </div>
        <% } %>
    </div>

    <div class="card-body d-flex flex-column p-2 p-md-3">
        <p class="card-title text-truncate fw-bold text-dark mb-1"
            style="font-size: var(--fs-sm);">
            <%= title %>
        </p>
        <p class="text-muted small mb-2 text-truncate">
            <% 
                const relations = (typeof bookAuthors !== 'undefined') ? bookAuthors.filter(ba => Number(ba.book_id) === Number(book.id)) : [];
                if (relations.length > 0) {
                    relations.forEach((ba, idx) => { %>
                        <a href="/author/<%= ba.author_id %>" class="text-decoration-none text-muted fw-medium">
                            <%= ba.author ? ba.author.name : t('index.unknown_country') %>
                        </a>
                        <%= idx < relations.length - 1 ? ', ' : '' %>
                    <% }); 
                } else { %>
                    <%= t('index.unknown_country') %>
                <% } %>
        </p>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="fs-5 fw-bold" style="color: var(--brand-teal);">
                <%= price %>€
            </span>
        </div>

        <div class="mt-auto d-flex flex-column gap-2">
            <a href="/books/book/<%= book.id %>"
                class="btn btn-primary btn-sm w-100">
                <i class="bi bi-eye me-1"></i>
                <%= t('index.view_details') %>
            </a>
            <form action="/cart/add" method="POST" class="w-100 m-0">
                <input type="hidden" name="book_id" value="<%= book.id %>">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="btn btn-success btn-sm w-100"
                    <%=book.stock <=0 ? 'disabled' : '' %>>
                    <i class="bi <%= book.stock <=0 ? 'bi-x-circle' : 'bi-bag-plus-fill' %> me-1"></i>
                    <span class="d-none d-sm-inline">
                        <%= book.stock <=0 ? t('book.out_of_stock') : t('book.add_to_cart') %>
                    </span>
                    <span class="d-inline d-sm-none">
                        <%= book.stock <=0 ? 'X' : '+' %>
                    </span>
                </button>
            </form>
        </div>
    </div>
</div>