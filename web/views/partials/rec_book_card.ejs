<% 
    const coverUrl = book.cover_url || null; 
    const title = book.title || 'Sin título'; 
    const price = parseFloat(book.price || 0).toFixed(2); 
    const score = parseFloat(book.score || 0); 
    const isRecommended = typeof showScore !== 'undefined' && showScore && score > 0;
%>

<a href="/books/book/<%= book.id %>" class="cinematic-card">
    <img src="<%= coverUrl %>" alt="<%= title %>" class="cinematic-card-img" loading="lazy">
    
    <div class="cinematic-overlay">
        <% if (isRecommended) { %>
            <div class="cinematic-match">
                <%= (score * 100).toFixed(0) %>% Match
            </div>
        <% } else if (typeof badgeText !== 'undefined' && badgeText) { %>
            <div class="cinematic-match" style="color: #fff; font-weight: 600;">
                <%= badgeText %>
            </div>
        <% } %>
        
        <h5 class="cinematic-title"><%= title %></h5>
        
        <div class="cinematic-btn">
            <%= price %>€ - Ver detalles
        </div>
    </div>
</a>