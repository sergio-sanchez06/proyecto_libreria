<% const coverUrl=book.cover_url || null; const title=book.title || 'Sin título' ; const price=parseFloat(book.price ||
    0).toFixed(2); const avgRating=parseFloat(book.avgRating || book.avg_rating || 0); const
    totalSold=parseInt(book.totalSold || book.total_sold || 0); const score=parseFloat(book.score || 0); const
    matchCount=parseInt(book.matchCount || book.match_count || 0); // Simulamos o extraemos una descripción corta const
    description=book.synopsis || 'Una recomendación especial basada en tus gustos literarios y preferencias de género.'
    ; %>

    <div class="book-card shadow-sm">
        <!-- Contenedor de Imagen (Vertical) -->
        <div class="book-img-container">
            <img src="<%= coverUrl %>" alt="<%= title %>" loading="lazy">

            <!-- Badge de afinidad (mantenemos el toque de recomendación)[cite: 3] -->
            <% if (typeof showScore !=='undefined' && showScore && score> 0) { %>
                <div class="badge-floating-score"
                    style="position: absolute; top: 10px; right: 10px; background: var(--brand-teal); color: white; padding: 4px 12px; border-radius: 20px; font-weight: bold; font-size: 0.8rem; z-index: 2;">
                    <%= (score * 100).toFixed(0) %>% Match
                </div>
                <% } %>
        </div>

        <!-- Cuerpo de la Tarjeta[cite: 5, 6] -->
        <div class="card-body d-flex flex-column p-3 text-center">
            <!-- Badge de Género o Info[cite: 5] -->
            <div class="mb-2">
                <span class="badge"
                    style="background-color: rgba(20, 184, 166, 0.1); color: var(--brand-teal); border: 1px solid rgba(20, 184, 166, 0.2);">
                    Recomendado
                </span>
            </div>

            <h5 class="fw-bold mb-2 text-dark"
                style="font-size: 1.05rem; min-height: 2.5rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                <%= title %>
            </h5>

            <!-- Sinopsis truncada[cite: 5, 6] -->
            <p class="text-muted small text-start mb-3"
                style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; min-height: 3.5rem;">
                <%= book.description || book.synopsis || 'Sin descripción disponible.' %>
            </p>

            <!-- Precio y Botón (Estilo Género)[cite: 3, 5] -->
            <div class="mt-auto">
                <div class="mb-2 fw-bold color-teal fs-5">
                    <%= parseFloat(book.price || 0).toFixed(2) %>€
                </div>
                <a href="/books/book/<%= book.id %>"
                    class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-bold py-2"
                    style="border-color: var(--brand-teal); color: var(--brand-teal);">
                    Ver detalles <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>