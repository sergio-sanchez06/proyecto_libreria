<%- include('../layout/header', { 
    title: t('publishers.title'),
    bodyClass: 'bg-main-vistas'
}) %>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

    body {
        font-family: 'Inter', sans-serif;
    }

    body::before {
        content: "";
        position: fixed;
        top: 0; left: 0; width: 100vw; height: 100vh;
        background: rgba(252, 250, 247, 0.45);
        z-index: -1;
    }

    .section-title {
        font-weight: 800;
        color: var(--brand-teal);
        position: relative;
        padding-bottom: 12px;
        margin-bottom: 2rem;
        letter-spacing: -0.5px;
        text-transform: uppercase;
        font-size: 2rem;
    }
    
    .section-title::after {
        content: '';
        width: 80px;
        height: 5px;
        background: var(--brand-gold);
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        border-radius: 10px;
    }

    .card {
        border: none;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.95) !important;
        backdrop-filter: blur(8px);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid rgba(255,255,255,0.4);
        overflow: hidden;
    }

    .card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(30, 64, 175, 0.1);
        border-color: rgba(30, 64, 175, 0.2);
    }

    .publisher-logo-container {
        width: 100px;
        height: 100px;
        margin: 0 auto 1.5rem;
        background: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 15px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.08);
        transition: transform 0.3s ease;
        border: 2px solid rgba(30, 64, 175, 0.05);
    }

    .card:hover .publisher-logo-container {
        transform: rotate(5deg) scale(1.05);
        border-color: var(--brand-gold);
    }
    
    .publisher-logo-container img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .btn-outline-primary {
        border-color: var(--brand-teal);
        color: var(--brand-teal);
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-outline-primary:hover {
        background: var(--brand-teal);
        color: #fff;
        box-shadow: 0 4px 10px rgba(30, 64, 175, 0.2);
        transform: translateY(-2px);
    }

    .pagination .page-link {
        border: none;
        border-radius: 10px;
        margin: 0 4px;
        color: var(--brand-teal);
        font-weight: 600;
        padding: 0.5rem 1rem;
        transition: all 0.2s ease;
    }

    .pagination .page-item.active .page-link {
        background: var(--brand-teal);
        color: white;
        box-shadow: 0 4px 10px rgba(30, 64, 175, 0.2);
    }
</style>

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="section-title text-center">
            <%= t('publishers.title') %>
        </h2>
        <p class="text-muted mt-3" style="font-size: 1.1rem;">
            <%= t('publishers.subtitle') %>
        </p>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        <% publishers.forEach(pub=> { %>
            <% if(!pub.deleted_at) { %>
                <div class="col">
                    <div class="card h-100 p-4 text-center">
                        <div class="card-body d-flex flex-column align-items-center justify-content-center p-0">
                            <div class="publisher-logo-container">
                                <img src="<%= pub.image_url || '/images/default-publisher.jpg' %>"
                                    alt="Logo <%= pub.name %>">
                            </div>

                            <h5 class="card-title fw-bold mb-4 text-dark" style="font-size: 1.25rem;">
                                <%= pub.name %>
                            </h5>

                            <div class="mt-auto w-100">
                                <a href="/publisher/<%= pub.id %>" class="btn btn-outline-primary btn-sm w-100 py-2 rounded-pill shadow-sm">
                                    <%= t('publishers.view_catalog') %> <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        <% }) %>
    </div>

    <div class="mt-5 pt-3">
        <nav aria-label="Navegación de editoriales">
            <ul class="pagination pagination-sm justify-content-center">
                <% const miRuta="/publisher/showAllPublishers"; %>

                <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="<%= miRuta %>?page=<%= parseInt(currentPage) - 1 %>">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                <% for(let i=1; i <=totalPages; i++) { %>
                    <li class="page-item <%= currentPage == i ? 'active' : '' %>">
                        <a class="page-link" href="<%= miRuta %>?page=<%= i %>">
                            <%= i %>
                        </a>
                    </li>
                <% } %>

                <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                    <a class="page-link" href="<%= miRuta %>?page=<%= parseInt(currentPage) + 1 %>">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<%- include('../layout/footer') %>