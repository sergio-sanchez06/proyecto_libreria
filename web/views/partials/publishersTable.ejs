<%- include('../layout/header', { 
    title: t('publishers.title'),
    bodyClass: 'bg-main-vistas',
    extraCSS: 'partials/publishersTable'
}) %>

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="section-title text-center">
            <%= t('publishers.title') %>
        </h2>
        <p class="text-muted mt-3" style="font-size: 1.1rem;">
            <%= t('publishers.subtitle') %>
        </p>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        <% publishers.forEach(pub=> { %>
            <% if(!pub.deleted_at) { %>
                <div class="col">
                    <div class="card h-100 p-4 text-center">
                        <div class="card-body d-flex flex-column align-items-center justify-content-center p-0">
                            <div class="publisher-logo-container">
                                <img src="<%= pub.image_url || '/images/default-publisher.jpg' %>"
                                    alt="Logo <%= pub.name %>">
                            </div>

                            <h5 class="card-title fw-bold mb-4 text-dark" style="font-size: 1.25rem;">
                                <%= pub.name %>
                            </h5>

                            <div class="mt-auto w-100">
                                <a href="/publisher/<%= pub.id %>" class="btn btn-outline-primary btn-sm w-100 py-2 rounded-pill shadow-sm">
                                    <%= t('publishers.view_catalog') %> <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        <% }) %>
    </div>

    <div class="mt-5 pt-3">
        <nav aria-label="Navegación de editoriales">
            <ul class="pagination pagination-sm justify-content-center">
                <% const miRuta="/publisher/showAllPublishers"; %>

                <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="<%= miRuta %>?page=<%= parseInt(currentPage) - 1 %>">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                <% for(let i=1; i <=totalPages; i++) { %>
                    <li class="page-item <%= currentPage == i ? 'active' : '' %>">
                        <a class="page-link" href="<%= miRuta %>?page=<%= i %>">
                            <%= i %>
                        </a>
                    </li>
                <% } %>

                <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                    <a class="page-link" href="<%= miRuta %>?page=<%= parseInt(currentPage) + 1 %>">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<%- include('../layout/footer') %>