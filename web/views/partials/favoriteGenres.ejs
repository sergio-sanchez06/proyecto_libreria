<%- include('../layout/header', { title: user.name + ' - Mis Géneros Favoritos' , bodyClass: 'bg-user-vistas' ,
    extraCSS: 'partials/favoriteGenres' }) %>

    <main class="py-5">
        <div class="container favorites-container">

            <!-- ── Cabecera ───────────────────────────────────────── -->
            <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
                <div>
                    <h2 class="fw-bold mb-1" style="color:var(--brand-blue);">
                        <i class="bi bi-heart-fill me-2" style="color:var(--brand-teal);"></i>Mis Géneros Favoritos
                    </h2>
                    <p class="text-muted mb-0 small fw-500">
                        Marca tus géneros preferidos y recibirás recomendaciones personalizadas.
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <a href="/user/recommendations" class="btn btn-outline-primary rounded-pill px-4 fw-600 shadow-sm">
                        <i class="bi bi-stars me-1"></i>Ver recomendaciones
                    </a>
                    <a href="/user/profile"
                        class="btn btn-light border rounded-pill px-4 fw-600 shadow-sm text-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Mi perfil
                    </a>
                </div>
            </div>

            <!-- ── Mensajes de Estado (Flash) ─────────────────────── -->
            <% if (flash) { %>
                <div class="alert alert-<%= flash.type === 'success' ? 'success' : 'danger' %> alert-dismissible fade show rounded-4 mb-4 border-0 shadow-sm"
                    role="alert">
                    <div class="d-flex align-items-center">
                        <i
                            class="bi bi-<%= flash.type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill' %> me-2 fs-5"></i>
                        <div>
                            <%= flash.message %>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>

                    <!-- ── Géneros seleccionados actualmente ──────────────── -->
                    <!-- El div 'bg-white' asegura el fondo solicitado -->
                    <div class="brand-card mb-4 border-0 bg-white">
                        <div class="favorites-card-header bg-white border-bottom">
                            <div class="d-flex align-items-center justify-content-between">
                                <h5 class="fw-bold mb-0" style="color: var(--brand-blue);">
                                    <i class="bi bi-bookmark-heart-fill me-2 text-teal"></i>
                                    Tu selección actual
                                </h5>
                                <% if (favoriteGenres.length> 0) { %>
                                    <span class="badge rounded-pill bg-teal px-3">
                                        <%= favoriteGenres.length %> géneros
                                    </span>
                                    <% } %>
                            </div>
                        </div>
                        <div class="p-4 bg-white rounded-bottom-4">
                            <% if (favoriteGenres.length===0) { %>
                                <div class="text-center py-4">
                                    <div class="bg-light d-inline-flex p-3 rounded-circle mb-3">
                                        <i class="bi bi-heart text-muted fs-2"></i>
                                    </div>
                                    <p class="text-muted mb-0 fw-500">Aún no tienes géneros favoritos seleccionados.</p>
                                </div>
                                <% } else { %>
                                    <div class="d-flex flex-wrap gap-2">
                                        <% favoriteGenres.forEach(function(g) { %>
                                            <div class="favorite-tag bg-light border">
                                                <i class="bi bi-bookmark-fill text-teal small"></i>
                                                <span class="fw-600">
                                                    <%= g.genre_name %>
                                                </span>

                                                <form action="/user/favorites/<%= user.id %>" method="POST"
                                                    data-requires-token class="d-inline">
                                                    <% favoriteGenres.forEach(function(other) { %>
                                                        <% if (other.genre_id !==g.genre_id) { %>
                                                            <input type="hidden" name="genre_ids"
                                                                value="<%= other.genre_id %>">
                                                            <% } %>
                                                                <% }) %>
                                                                    <button type="submit"
                                                                        class="favorite-tag-remove ms-1"
                                                                        title="Quitar <%= g.genre_name %>">
                                                                        <i class="bi bi-x-lg"></i>
                                                                    </button>
                                                </form>
                                            </div>
                                            <% }) %>
                                    </div>
                                    <% } %>
                        </div>
                    </div>

                    <!-- ── Formulario de Selección Completo ────────────────── -->
                    <!-- bg-white aplicado al contenedor principal del formulario -->
                    <div class="brand-card border-0 bg-white shadow-sm">
                        <div class="favorites-card-header bg-white border-bottom">
                            <h5 class="fw-bold mb-0 text-secondary">
                                <i class="bi bi-grid-fill me-2"></i>Explorar y elegir géneros
                            </h5>
                        </div>
                        <div class="p-4 bg-white rounded-bottom-4">
                            <% if (!allGenres || allGenres.length===0) { %>
                                <div class="text-center py-5">
                                    <p class="text-muted mb-0">No hay géneros disponibles.</p>
                                </div>
                                <% } else { %>
                                    <% const favoriteIds=favoriteGenres.map(g=> g.genre_id); %>
                                        <form action="/user/favorites/<%= user.id %>" method="POST" data-requires-token
                                            id="favoritesForm">

                                            <!-- Grid de elementos con fondo blanco individual mediante el CSS ya definido -->
                                            <div class="genres-grid my-4 bg-white">
                                                <% allGenres.forEach(function(genre) { const
                                                    isFav=favoriteIds.includes(genre.id); %>
                                                    <div>
                                                        <input type="checkbox" class="btn-check" name="genre_ids"
                                                            value="<%= genre.id %>" id="genre_<%= genre.id %>" <%=isFav
                                                            ? 'checked' : '' %>>
                                                        <!-- El CSS .genre-check-label ya maneja el fondo blanco -->
                                                        <label class="genre-check-label bg-white"
                                                            for="genre_<%= genre.id %>">
                                                            <i
                                                                class="bi bi-bookmark<%= isFav ? '-fill' : '' %> genre-icon"></i>
                                                            <span class="genre-name">
                                                                <%= genre.name %>
                                                            </span>
                                                            <i class="bi bi-check-circle-fill genre-check-mark"></i>
                                                        </label>
                                                    </div>
                                                    <% }) %>
                                            </div>

                                            <!-- Barra de acciones inferior -->
                                            <div
                                                class="action-bar d-flex align-items-center justify-content-between flex-wrap gap-3 rounded-4 p-3 border shadow-sm bg-white">
                                                <p class="text-muted small mb-0 fw-500">
                                                    <i class="bi bi-info-circle me-1"></i>
                                                    Seleccionados: <span id="selectedCount" class="text-dark fw-bold">
                                                        <%= favoriteIds.length %>
                                                    </span>
                                                </p>
                                                <div class="d-flex gap-2">
                                                    <button type="button"
                                                        class="btn btn-outline-secondary rounded-pill px-4 fw-600"
                                                        onclick="clearAll()">
                                                        <i class="bi bi-trash3 me-1"></i>Limpiar
                                                    </button>
                                                    <button type="submit"
                                                        class="btn btn-brand rounded-pill px-5 fw-bold shadow-sm">
                                                        <i class="bi bi-cloud-check me-1"></i>Guardar cambios
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                        <% } %>
                        </div>
                    </div>

        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const checkBoxes = document.querySelectorAll('.btn-check');
            checkBoxes.forEach(cb => {
                cb.addEventListener('change', function () {
                    const label = document.querySelector(`label[for="${this.id}"]`);
                    const icon = label.querySelector('.genre-icon');
                    if (this.checked) {
                        icon.classList.replace('bi-bookmark', 'bi-bookmark-fill');
                    } else {
                        icon.classList.replace('bi-bookmark-fill', 'bi-bookmark');
                    }
                    updateCount();
                });
            });
        });

        function updateCount() {
            const total = document.querySelectorAll('.btn-check:checked').length;
            const counter = document.getElementById('selectedCount');
            if (counter) counter.textContent = total;
        }

        function clearAll() {
            if (confirm('¿Deseas desmarcar todos los géneros?')) {
                document.querySelectorAll('.btn-check:checked').forEach(cb => {
                    cb.checked = false;
                    cb.dispatchEvent(new Event('change'));
                });
                updateCount();
            }
        }
    </script>

    <%- include('../layout/footer') %>