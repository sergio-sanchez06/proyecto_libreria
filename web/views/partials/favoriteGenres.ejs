<%- include('../layout/header', { title: user.name + ' - ' + t('favorites.page_title'), bodyClass: 'bg-user-vistas', extraCSS: 'partials/favoriteGenres' })
    %>

    <!-- Cargamos el CSS de recomendaciones para heredar el diseño del Hero e Iconos -->
    <link rel="stylesheet" href="/CSS/recommendations.css">

    <div class="container py-5">

        <!-- ── Breadcrumb ────────────────── -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb" style="font-weight:500;">
                <li class="breadcrumb-item">
                    <a href="/user/profile" class="text-decoration-none text-muted">
                        <%= t('favorites.breadcrumb_profile') %>
                    </a>
                </li>
                <li class="breadcrumb-item active" style="color:var(--brand-teal);">
                    <%= t('favorites.breadcrumb_current') %>
                </li>
            </ol>
        </nav>

        <!-- ── Hero ────────────── -->
        <div class="rec-hero p-4 p-md-5 mb-5 d-flex flex-column flex-md-row justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-4 mb-4 mb-md-0">
                <div class="rec-icon-container">
                    <i class="bi bi-heart-fill"></i>
                </div>
                <div>
                    <p class="text-uppercase fw-bold m-0"
                        style="color:var(--brand-gold); letter-spacing:1px; font-size:.85rem;">
                        <%= t('favorites.personalization_label') %>
                    </p>
                    <h1 class="display-5 fw-bold m-0" style="color:var(--brand-teal); letter-spacing:-1px;">
                        <%= t('favorites.hero_title') %>
                    </h1>
                    <p class="text-muted mb-0 mt-1" style="font-size:.9rem;">
                        <%= t('favorites.hero_subtitle') %>
                    </p>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a href="/user/recommendations"
                    class="btn btn-outline-dark rounded-pill px-4 py-2 fw-medium shadow-sm d-flex align-items-center gap-2">
                    <i class="bi bi-stars"></i>
                    <%= t('favorites.view_recommendations_btn') %>
                </a>
                <a href="/user/profile"
                    class="btn btn-outline-dark rounded-pill px-4 py-2 fw-medium shadow-sm d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i>
                    <%= t('favorites.profile_btn') %>
                </a>
            </div>
        </div>

        <!-- ── Mensajes de Estado (Flash) ─────────────────────── -->
        <% if (flash) { %>
            <div class="alert alert-<%= flash.type === 'success' ? 'success' : 'danger' %> alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4"
                role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i
                        class="bi bi-<%= flash.type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill' %> fs-5"></i>
                    <div>
                        <%= flash.message %>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>

                <!-- ── Sección: Tu selección actual ────────────────────── -->
                <div class="brand-card mb-5 border-0 bg-white shadow-sm rounded-4">
                    <div class="favorites-card-header bg-white border-bottom p-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <h5 class="fw-bold mb-0" style="color: var(--brand-blue);">
                                <i class="bi bi-bookmark-heart-fill me-2 text-teal"></i>
                                <%= t('favorites.current_selection_title') %>
                            </h5>
                            <% if (favoriteGenres.length> 0) { %>
                                <span class="badge rounded-pill px-3 py-2"
                                    style="background:var(--brand-teal); color:white;">
                                    <%= favoriteGenres.length %>
                                        <%= t('favorites.genres_count_label') %>
                                </span>
                                <% } %>
                        </div>
                    </div>
                    <div class="p-4 bg-white rounded-bottom-4">
                        <% if (favoriteGenres.length===0) { %>
                            <div class="text-center py-4">
                                <div class="bg-light d-inline-flex p-3 rounded-circle mb-3">
                                    <i class="bi bi-heart text-muted fs-2"></i>
                                </div>
                                <p class="text-muted mb-0 fw-500">
                                    <%= t('favorites.no_favorites_message') %>
                                </p>
                            </div>
                            <% } else { %>
                                <div class="d-flex flex-wrap gap-2">
                                    <% favoriteGenres.forEach(function(g) { %>
                                        <div class="favorite-tag bg-light border">
                                            <i class="bi bi-bookmark-fill text-teal small"></i>
                                            <span class="fw-600">
                                                <%= g.genre_name %>
                                            </span>
                                            <form action="/user/favorites/<%= user.id %>" method="POST"
                                                data-requires-token class="d-inline">
                                                <% favoriteGenres.forEach(function(other) { %>
                                                    <% if (other.genre_id !==g.genre_id) { %>
                                                        <input type="hidden" name="genre_ids"
                                                            value="<%= other.genre_id %>">
                                                        <% } %>
                                                            <% }) %>
                                                                <button type="submit" class="favorite-tag-remove ms-1"
                                                                    title="<%= t('favorites.remove_title') %> <%= g.genre_name %>">
                                                                    <i class="bi bi-x-lg"></i>
                                                                </button>
                                            </form>
                                        </div>
                                        <% }) %>
                                </div>
                                <% } %>
                    </div>
                </div>

                <!-- ── Sección: Explorar Géneros ────── -->
                <div class="brand-card border-0 bg-white shadow-sm rounded-4">
                    <div class="favorites-card-header bg-white border-bottom p-4">
                        <h5 class="fw-bold mb-0 text-secondary">
                            <i class="bi bi-grid-fill me-2"></i>
                            <%= t('favorites.explore_title') %>
                        </h5>
                    </div>
                    <div class="p-4">
                        <% if (!allGenres || allGenres.length===0) { %>
                            <div class="text-center py-5">
                                <p class="text-muted mb-0">
                                    <%= t('favorites.no_genres_available') %>
                                </p>
                            </div>
                            <% } else { %>
                                <% const favoriteIds=favoriteGenres.map(g=> g.genre_id); %>
                                    <form action="/user/favorites/<%= user.id %>" method="POST" data-requires-token
                                        id="favoritesForm">

                                        <div class="genres-grid my-4">
                                            <% allGenres.forEach(function(genre) { const
                                                isFav=favoriteIds.includes(genre.id); %>
                                                <div>
                                                    <input type="checkbox" class="btn-check" name="genre_ids"
                                                        value="<%= genre.id %>" id="genre_<%= genre.id %>" <%=isFav
                                                        ? 'checked' : '' %>>
                                                    <label class="genre-check-label"
                                                        for="genre_<%= genre.id %>">
                                                        <i
                                                            class="bi bi-bookmark<%= isFav ? '-fill' : '' %> genre-icon"></i>
                                                        <span class="genre-name mt-2">
                                                            <%= genre.name %>
                                                        </span>
                                                        <i class="bi bi-check-circle-fill genre-check-mark"></i>
                                                    </label>
                                                </div>
                                                <% }) %>
                                        </div>

                                        <!-- Barra de acción inferior -->
                                        <div
                                            class="action-bar d-flex align-items-center justify-content-between flex-wrap gap-3 rounded-4 p-4 border shadow-sm bg-white mt-4">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-info-circle text-teal"></i>
                                                <p class="text-muted small mb-0 fw-500">
                                                    <%= t('favorites.selected_label') %>: <span id="selectedCount"
                                                            class="text-dark fw-bold">
                                                            <%= favoriteIds.length %>
                                                        </span>
                                                </p>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button type="button"
                                                    class="btn btn-outline-secondary rounded-pill px-4 fw-600"
                                                    onclick="clearAll()">
                                                    <i class="bi bi-trash3 me-1"></i>
                                                    <%= t('favorites.clear_btn') %>
                                                </button>
                                                <button type="submit" class="btn btn-brand"
                                                    style="background:var(--brand-teal); color:white;">
                                                    <i class="bi bi-cloud-check me-1"></i>
                                                    <%= t('favorites.save_changes_btn') %>
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                    <% } %>
                    </div>
                </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const checkBoxes = document.querySelectorAll('.btn-check');
            checkBoxes.forEach(cb => {
                cb.addEventListener('change', function () {
                    const label = document.querySelector(`label[for="${this.id}"]`);
                    const icon = label.querySelector('.genre-icon');
                    if (this.checked) {
                        icon.classList.replace('bi-bookmark', 'bi-bookmark-fill');
                    } else {
                        icon.classList.replace('bi-bookmark-fill', 'bi-bookmark');
                    }
                    updateCount();
                });
            });
        });

        function updateCount() {
            const total = document.querySelectorAll('.btn-check:checked').length;
            const counter = document.getElementById('selectedCount');
            if (counter) counter.textContent = total;
        }

        function clearAll() {
            if (confirm('<%= t("favorites.confirm_clear") %>')) {
                document.querySelectorAll('.btn-check:checked').forEach(cb => {
                    cb.checked = false;
                    cb.dispatchEvent(new Event('change'));
                });
                updateCount();
            }
        }
    </script>

    <%- include('../layout/footer') %>