<%- include('../layout/header', { title: user.name + ' - ' + t('recommendations.page_title'), bodyClass: 'bg-user-vistas', extraCSS: 'partials/recommendations' }) %>

<div class="container py-5">

    <!-- ── Breadcrumb ────────────────────────────── -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb" style="font-weight:500;">
            <li class="breadcrumb-item">
                <a href="/user/profile" class="text-decoration-none text-muted">
                    <%= t('recommendations.breadcrumb_profile') %>
                </a>
            </li>
            <li class="breadcrumb-item active" style="color:var(--brand-teal);">
                <%= t('recommendations.breadcrumb_current') %>
            </li>
        </ol>
    </nav>

    <!-- ── New Integrated Recommendations Hero ── -->
    <div class="recommendations-hero p-4 p-lg-5 mb-5 rounded-5 shadow-lg border-0 position-relative overflow-hidden text-white" style="background: linear-gradient(135deg, #1e293b 0%, var(--brand-teal) 100%); border: 1px solid rgba(255, 255, 255, 0.1);">
        <div class="hero-overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: url('https://www.transparenttextures.com/patterns/cubes.png'); opacity: 0.1; z-index: 0;"></div>
        <div class="row align-items-center position-relative z-1">
            <div class="col-lg-7 mb-4 mb-lg-0">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="hero-icon-box bg-white rounded-4 shadow-sm d-flex align-items-center justify-content-center overflow-hidden" style="width: 70px; height: 70px; flex-shrink: 0; border: 1px solid rgba(212, 175, 55, 0.2);">
                        <i class="bi bi-stars text-teal" style="font-size: 2.2rem; color: var(--brand-teal) !important;"></i>
                    </div>
                    <div>
                        <p class="text-uppercase fw-bold m-0 opacity-75" style="letter-spacing:1px; font-size:.85rem;">
                            <%= t('favorites.personalization_label') || 'Personalización' %>
                        </p>
                        <h1 class="display-5 fw-bold mb-0"><%= t('recommendations.page_title') || 'Recomendados para ti' %></h1>
                    </div>
                </div>
                <p class="opacity-75 mb-0 fw-medium">
                    <%= t('recommendations.hero_subtitle', 'Descubre lecturas seleccionadas a medida basándonos en tus géneros preferidos.') %>
                </p>
            </div>
            
            <div class="col-lg-5">
                <div class="d-flex flex-column gap-3">
                    <a href="/user/favorites" class="btn btn-white rounded-pill px-4 py-3 fw-bold shadow-sm w-100 border d-flex align-items-center justify-content-center gap-2 transition-all">
                        <i class="bi bi-gear-fill text-teal"></i> <%= t('recommendations.my_genres_btn') || 'Mis Géneros' %>
                    </a>
                    <a href="/user/profile" class="btn bg-glass-white rounded-pill px-4 py-3 fw-bold shadow-sm w-100 border d-flex align-items-center justify-content-center gap-2 transition-all" style="color: var(--brand-teal);">
                        <i class="bi bi-person-circle"></i> <%= t('favorites.profile_btn') %>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Aviso sin favoritos ────────────────────── -->
    <% if (!hasFavorites) { %>
        <div class="alert brand-alert mb-5 d-flex align-items-center gap-3 p-4">
            <i class="bi bi-lightbulb-fill fs-3 text-warning flex-shrink-0" style="filter: drop-shadow(0 0 10px rgba(255,193,7,0.5));"></i>
            <div>
                <strong style="color: var(--brand-teal);">
                    <%= t('recommendations.no_favorites_title') %>
                </strong> — <span class="text-muted"><%= t('recommendations.no_favorites_hint') %></span>
                <a href="/user/favorites" class="fw-bold ms-2 px-3 py-1 rounded-pill" style="background: var(--brand-teal); color: white; text-decoration: none;">
                    <%= t('recommendations.configure_favorites') %> <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    <% } %>

    <!-- ── Sin nada que mostrar ───────────────────── -->
    <% if (favoriteGenres.length === 0 && mostSold.length === 0 && bestRated.length === 0) { %>
        <div class="brand-alert text-center py-5 shadow-sm border-0">
            <div class="mb-4"><i class="bi bi-bookmark-heart text-muted fs-1"></i></div>
            <h4 class="fw-bold text-dark">
                <%= t('recommendations.empty_title') %>
            </h4>
            <p class="text-muted mx-auto mb-4" style="max-width:450px;">
                <%= t('recommendations.empty_description') %>
            </p>
            <a href="/user/favorites" class="btn rounded-pill px-5 fw-bold shadow-sm"
                style="background:var(--brand-teal); color:white;">
                <%= t('recommendations.my_genres_btn') %>
            </a>
        </div>
    <% } else { %>

        <!-- ── Spotlight Hero ────────────────────────── -->
        <% 
            let topBook = null;
            let topBadge = "";
            let topScore = 0;
            if (hasFavorites && combined.length > 0) {
                topBook = combined[0];
                topBadge = t('recommendations.tab_special') || "Selección Especial";
                topScore = parseFloat(topBook.score || 0);
            } else if (mostSold.length > 0) {
                topBook = mostSold[0];
                topBadge = t('recommendations.tab_trending') || "Tendencias";
            } else if (bestRated.length > 0) {
                topBook = bestRated[0];
                topBadge = t('recommendations.tab_best_rated') || "Aclamado";
            }
        %>

        <% if (topBook) { %>
            <div class="spotlight-hero p-4 p-md-5 mb-5 rounded-5 border-0 shadow-lg position-relative overflow-hidden text-white" style="min-height: auto;">
                <img src="<%= topBook.cover_url %>" class="spotlight-backdrop" alt="backdrop">
                <div class="spotlight-overlay"></div>
                
                <div class="spotlight-content d-flex flex-column flex-md-row align-items-center gap-4 gap-md-5">
                    <div class="flex-shrink-0 text-center">
                        <img src="<%= topBook.cover_url %>" class="spotlight-cover" alt="<%= topBook.title %>" style="max-height: 220px; width: auto; object-fit: cover;">
                    </div>
                    <div style="flex-grow: 1;">
                        <div class="mb-2 d-flex align-items-center gap-2">
                            <span class="badge" style="background: rgba(255,255,255,0.2); backdrop-filter: blur(5px); font-size: 0.85rem;"><i class="bi bi-star-fill text-warning me-1"></i> <%= topBadge %></span>
                            <% if (topScore > 0) { %>
                                <span class="fw-bold" style="color: var(--brand-gold);"><%= (topScore * 100).toFixed(0) %>% Match</span>
                            <% } %>
                        </div>
                        <h3 class="fw-bold mb-2 text-white" style="font-size: 2rem; text-shadow: 0 2px 4px rgba(0,0,0,0.5);"><%= topBook.title %></h3>
                        <p class="spotlight-desc small opacity-90 mb-3" style="max-width: 100%;">
                            <%= topBook.description || topBook.synopsis || "Explora esta recomendación destacada basada en lo que más te gusta. Una lectura imprescindible." %>
                        </p>
                        <div class="d-flex gap-3 align-items-center">
                            <a href="/books/book/<%= topBook.id %>" class="btn btn-spotlight btn-sm px-4 py-2">
                                <i class="bi bi-book-half me-1"></i> <%= t('recommendations.see_details') %>
                            </a>
                            <span class="text-white fs-4 fw-bold ms-3"><%= parseFloat(topBook.price || 0).toFixed(2) %>€</span>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>

        <!-- ── Estanterías (Carruseles) ───────────────── -->

        <!-- ── Estanterías (Carruseles Bootstrap) ───────────────── -->

        <% if (hasFavorites && combined.length > 0) { %>
            <div class="mb-5">
                <h2 class="section-title text-start section-title-left">
                    <i class="bi bi-stars text-warning me-2"></i>
                    <%= t('recommendations.tab_special') %> <span class="text-muted fs-6 ms-2 fw-normal"><%= combined.length %> títulos</span>
                </h2>
                <div id="carouselSpecial" class="carousel slide px-4 px-md-5" data-bs-ride="carousel">
                    <div class="carousel-inner py-3">
                        <% const booksPerSlide = 4; for (let i = 0; i < combined.length; i += booksPerSlide) { 
                            const group = combined.slice(i, i + booksPerSlide); 
                            const isActive = i === 0 ? "active" : ""; %>
                            <div class="carousel-item <%= isActive %>">
                                <div class="row justify-content-center">
                                    <% group.forEach(book => { %>
                                        <div class="col-6 col-md-3 mb-4">
                                            <%- include('../partials/rec_book_card', { book, showScore: true, badgeText: null }) %>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                    <% if (combined.length > booksPerSlide) { %>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselSpecial" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon shadow" aria-hidden="true"></span>
                            <span class="visually-hidden">Anterior</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselSpecial" data-bs-slide="next">
                            <span class="carousel-control-next-icon shadow" aria-hidden="true"></span>
                            <span class="visually-hidden">Siguiente</span>
                        </button>
                    <% } %>
                </div>
            </div>
        <% } %>

        <% if (mostSold.length > 0) { %>
            <div class="mb-5">
                <h2 class="section-title text-start section-title-left">
                    <i class="bi bi-activity text-danger me-2"></i>
                    <%= t('recommendations.tab_trending') %> <span class="text-muted fs-6 ms-2 fw-normal"><%= mostSold.length %> títulos</span>
                </h2>
                <div id="carouselTrending" class="carousel slide px-4 px-md-5" data-bs-ride="carousel">
                    <div class="carousel-inner py-3">
                        <% const booksPerSlide = 4; for (let i = 0; i < mostSold.length; i += booksPerSlide) { 
                            const group = mostSold.slice(i, i + booksPerSlide); 
                            const isActive = i === 0 ? "active" : ""; %>
                            <div class="carousel-item <%= isActive %>">
                                <div class="row justify-content-center">
                                    <% group.forEach(book => { %>
                                        <div class="col-6 col-md-3 mb-4">
                                            <%- include('../partials/rec_book_card', { book, showScore: false, badgeText: null }) %>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                    <% if (mostSold.length > booksPerSlide) { %>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselTrending" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon shadow" aria-hidden="true"></span>
                            <span class="visually-hidden">Anterior</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselTrending" data-bs-slide="next">
                            <span class="carousel-control-next-icon shadow" aria-hidden="true"></span>
                            <span class="visually-hidden">Siguiente</span>
                        </button>
                    <% } %>
                </div>
            </div>
        <% } %>

        <% if (bestRated.length > 0) { %>
            <div class="mb-5">
                <h2 class="section-title text-start section-title-left">
                    <i class="bi bi-trophy text-warning me-2"></i>
                    <%= t('recommendations.tab_best_rated') %> <span class="text-muted fs-6 ms-2 fw-normal"><%= bestRated.length %> títulos</span>
                </h2>
                <div id="carouselBestRated" class="carousel slide px-4 px-md-5" data-bs-ride="carousel">
                    <div class="carousel-inner py-3">
                        <% const booksPerSlide = 4; for (let i = 0; i < bestRated.length; i += booksPerSlide) { 
                            const group = bestRated.slice(i, i + booksPerSlide); 
                            const isActive = i === 0 ? "active" : ""; %>
                            <div class="carousel-item <%= isActive %>">
                                <div class="row justify-content-center">
                                    <% group.forEach(book => { %>
                                        <div class="col-6 col-md-3 mb-4">
                                            <%- include('../partials/rec_book_card', { book, showScore: false, badgeText: null }) %>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                    <% if (bestRated.length > booksPerSlide) { %>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselBestRated" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon shadow" aria-hidden="true"></span>
                            <span class="visually-hidden">Anterior</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselBestRated" data-bs-slide="next">
                            <span class="carousel-control-next-icon shadow" aria-hidden="true"></span>
                            <span class="visually-hidden">Siguiente</span>
                        </button>
                    <% } %>
                </div>
            </div>
        <% } %>

    <% } %>

</div>


<%- include('../layout/footer') %>