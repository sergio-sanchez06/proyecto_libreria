<%- include('../layout/header', { title: user.name + ' - ' + (t('profile.title') || 'Mi Perfil' ),
    bodyClass: 'bg-main-vistas' , extraCSS: 'partials/perfil' }) %>

    <main class="py-5">
        <div class="container profile-container">
            <div class="brand-card shadow-sm border-0">
                <div class="profile-header text-center">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="mb-0 fw-bold m-0">
                            <%= t('profile.title') || 'Mi Perfil' %>
                        </h3>
                        <a href="/user/edit/<%= user.id %>" class="btn btn-light rounded-pill px-4 fw-bold shadow-sm"
                            style="color: var(--brand-teal);">
                            <i class="bi bi-pencil-square me-1"></i>
                            <%= t('profile.edit_data') || 'Editar Datos' %>
                        </a>
                    </div>
                </div>

                <div class="profile-avatar-wrapper text-center">
                    <div class="profile-avatar mb-3">
                        <i class="bi bi-person-fill text-muted" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark">
                        <%= user.name %>
                    </h3>
                    <span class="badge rounded-pill px-3 py-2"
                        style="background-color: var(--brand-gold); color: #1e293b; font-weight: 700; font-size: 0.8rem; letter-spacing: 0.5px;">
                        <i class="bi bi-award-fill me-1"></i>
                        <%= user.role==='ADMIN' ? 'ADMINISTRADOR' : (t('profile.role_client') || 'CLIENTE'
                            ).toUpperCase() %>
                    </span>
                </div>

                <div class="card-body p-4 p-md-5">
                    <ul class="info-list mb-5 list-unstyled">
                        <li class="info-item d-flex align-items-center mb-3">
                            <div class="info-icon me-3 text-teal"><i class="bi bi-envelope-fill fs-4"></i></div>
                            <div class="info-content">
                                <strong class="d-block">
                                    <%= t('profile.email') || 'Correo Electrónico' %>
                                </strong>
                                <span class="text-muted">
                                    <%= user.email %>
                                </span>
                            </div>
                        </li>
                        <li class="info-item d-flex align-items-center mb-3">
                            <div class="info-icon me-3 text-teal"><i class="bi bi-house-door-fill fs-4"></i></div>
                            <div class="info-content">
                                <strong class="d-block">
                                    <%= t('profile.address_main') || 'Dirección Principal' %>
                                </strong>
                                <span class="text-muted">
                                    <%= user.default_address || t('profile.not_defined') || 'No definida' %>
                                </span>
                            </div>
                        </li>
                        <li class="info-item d-flex align-items-center mb-3">
                            <div class="info-icon me-3 text-teal"><i class="bi bi-geo-alt-fill fs-4"></i></div>
                            <div class="info-content">
                                <strong class="d-block">
                                    <%= t('profile.address_opt') || 'Dirección Secundaria' %>
                                </strong>
                                <span class="text-muted">
                                    <% if (user.optional_address && user.optional_address.trim() !=='' ) { %>
                                        <%= user.optional_address %>
                                            <% } else { %>
                                                <i class="small text-muted opacity-50">
                                                    <%= t('profile.not_defined') || 'No definida' %>
                                                </i>
                                                <% } %>
                                </span>
                            </div>
                        </li>
                    </ul>

                    <div class="row g-3 mb-5">
                        <div class="col-sm-6">
                            <a href="/user/myOrders"
                                class="btn d-block action-button p-4 border rounded shadow-sm text-center bg-white">
                                <i class="bi bi-bag-check fs-1 d-block mb-2" style="color: var(--brand-teal);"></i>
                                <span class="fw-bold text-dark">
                                    <%= t('profile.view_orders') || 'Mis Pedidos' %>
                                </span>
                            </a>
                        </div>
                        <div class="col-sm-6">
                            <a href="/user/myReviews"
                                class="btn d-block action-button p-4 border rounded shadow-sm text-center bg-white">
                                <i class="bi bi-star-half fs-1 d-block mb-2 text-warning"></i>
                                <span class="fw-bold text-dark">
                                    <%= t('profile.view_reviews') || 'Mis Reseñas' %>
                                </span>
                            </a>
                        </div>
                        <% if (provider == "password") { %>
                            <div class="col-sm-6">
                                <a href="/user/changePass"
                                    class="btn d-block action-button p-4 border rounded shadow-sm text-center bg-white">
                                    <i class="bi bi-star-half fs-1 d-block mb-2 text-warning"></i>
                                    <span class="fw-bold text-dark">
                                        <%= 'Cambiar Contraseña' %>
                                    </span>
                                </a>
                            </div>
                        <% } %>
                    </div>

                    <div class="text-center pt-4 border-top">
                        <button type="button" class="btn btn-outline-danger rounded-pill px-4 fw-bold"
                            data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            <%= t('profile.delete_account') || 'Eliminar Mi Cuenta' %>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-hidden="true" style="z-index: 9999;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-danger text-white border-0">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-shield-exclamation me-2"></i>
                        <%= t('profile.delete_title') || '¿Cómo deseas marcharte?' %>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted mb-4 small">
                        <%= t('profile.delete_intro') || 'Selecciona una opción para continuar:' %>
                    </p>

                    <form action="/user/dismissSelf" method="post" id="deleteAccountForm" data-requires-token>
                        <input type="hidden" name="id" value="<%= user.id %>">
                        <input type="hidden" name="firebase_uid" value="<%= user.firebase_uid %>">
                        <input type="hidden" name="mode" id="deleteMode" value="soft">

                        <div class="mb-3">
                            <input type="radio" class="btn-check" name="modeSelect" id="modeSoft" checked
                                onchange="document.getElementById('deleteMode').value = 'soft'">
                            <label class="btn btn-outline-secondary w-100 text-start p-3 custom-card" for="modeSoft">
                                <strong class="d-block text-dark">
                                    <%= t('profile.mode_soft_title') || 'Desactivar cuenta' %>
                                </strong>
                                <small class="text-muted">
                                    <%= t('profile.mode_soft_description') || 'Podrás recuperarla después.' %>
                                </small>
                            </label>
                        </div>

                        <div class="mb-3">
                            <input type="radio" class="btn-check" name="modeSelect" id="modeHard"
                                onchange="document.getElementById('deleteMode').value = 'hard'">
                            <label class="btn btn-outline-danger w-100 text-start p-3 custom-card" for="modeHard">
                                <strong class="d-block">
                                    <%= t('profile.mode_hard_title') || 'Borrado permanente' %>
                                </strong>
                                <small class="text-muted">
                                    <%= t('profile.mode_hard_description') || 'Eliminación total de datos (RGPD).' %>
                                </small>
                            </label>
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4"
                        data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" form="deleteAccountForm" id="confirmDeleteBtn"
                        class="btn btn-danger rounded-pill px-4 fw-bold">
                        <%= t('profile.confirm_soft') || 'Confirmar y Desactivar' %>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <style>
        /* Estilos para las tarjetas de selección */
        .custom-card {
            border: 2px solid #e2e8f0 !important;
            background-color: white !important;
            transition: all 0.2s ease;
        }

        .btn-check:checked+.custom-card {
            border-color: var(--brand-teal) !important;
            background-color: #f0fdfa !important;
        }

        .btn-check:checked+.btn-outline-danger {
            border-color: #dc3545 !important;
            background-color: #fff5f5 !important;
        }

        .text-teal {
            color: var(--brand-teal);
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const btnConfirm = document.getElementById('confirmDeleteBtn');
            const radioSoft = document.getElementById('modeSoft');
            const radioHard = document.getElementById('modeHard');

            // Textos traducidos (puedes pasarlos desde EJS)
            const textSoft = "<%= t('profile.confirm_soft') || 'Confirmar y Desactivar' %>";
            const textHard = "<%= t('profile.confirm_hard') || 'Confirmar y Borrar Permanentemente' %>";

            function updateButtonText() {
                if (radioHard.checked) {
                    btnConfirm.innerText = textHard;
                    btnConfirm.classList.replace('btn-danger', 'btn-dark'); // Opcional: cambio de color para advertir
                } else {
                    btnConfirm.innerText = textSoft;
                    btnConfirm.classList.replace('btn-dark', 'btn-danger');
                }
            }

            // Escuchar cambios
            radioSoft.addEventListener('change', updateButtonText);
            radioHard.addEventListener('change', updateButtonText);

            // Ejecutar al cargar por si acaso
            updateButtonText();
        });
    </script>

    <%- include('../layout/footer') %>