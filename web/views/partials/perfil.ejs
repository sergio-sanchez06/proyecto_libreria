<%- include('../layout/header', { 
    title: user.name + ' - ' + (t('profile.title') || 'Mi Perfil'),
    bodyClass: 'bg-main-vistas',
    extraCSS: 'partials/perfil'
}) %>

<main class="py-5">
    <div class="container profile-container">
        <div class="brand-card">
            <div class="profile-header text-center">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="mb-0 fw-bold m-0"><%= t('profile.title') || 'Mi Perfil' %></h3>
                    <a href="/user/edit/<%= user.id %>" class="btn btn-light rounded-pill px-4 fw-bold shadow-sm" style="color: var(--brand-teal);">
                        <i class="bi bi-pencil-square me-1"></i> <%= t('profile.edit_data') || 'Editar Datos' %>
                    </a>
                </div>
            </div>

            <div class="profile-avatar-wrapper">
                <div class="profile-avatar">
                    <i class="bi bi-person-fill text-muted" style="font-size: 4rem;"></i>
                </div>
                <h3 class="fw-bold mt-3 mb-1 text-dark"><%= user.name %></h3>
                <span class="badge rounded-pill px-3 py-2" style="background-color: var(--brand-gold); color: #1e293b; font-weight: 700; font-size: 0.8rem; letter-spacing: 0.5px;">
                    <i class="bi bi-award-fill me-1"></i> <%= user.role === 'ADMIN' ? 'ADMINISTRADOR' : (t('profile.role_client') || 'CLIENTE').toUpperCase() %>
                </span>
            </div>

            <div class="card-body p-4 p-md-5 pt-0">
                <ul class="info-list mb-5">
                    <li class="info-item">
                        <div class="info-icon"><i class="bi bi-envelope-fill"></i></div>
                        <div class="info-content">
                            <strong><%= t('profile.email') || 'Correo Electrónico' %></strong>
                            <span><%= user.email %></span>
                        </div>
                    </li>
                    <li class="info-item">
                        <div class="info-icon"><i class="bi bi-house-door-fill"></i></div>
                        <div class="info-content">
                            <strong><%= t('profile.address_main') || 'Dirección Principal' %></strong>
                            <span><%= user.default_address || t('profile.not_defined') || 'No definida' %></span>
                        </div>
                    </li>
                    <% if (user.optional_address) { %>
                    <li class="info-item">
                        <div class="info-icon"><i class="bi bi-building-fill"></i></div>
                        <div class="info-content">
                            <strong><%= t('profile.address_opt') || 'Dirección Adicional' %></strong>
                            <span><%= user.optional_address %></span>
                        </div>
                    </li>
                    <% } %>
                </ul>

                <div class="row g-3 mb-5">
                    <div class="col-sm-6">
                        <a href="/user/myOrders" class="btn d-block action-button p-3 border shadow-sm text-center" style="background: white; border-color: #cbd5e1;">
                            <i class="bi bi-bag-check fs-2 d-block mb-2" style="color: var(--brand-teal);"></i>
                            <span class="text-dark"><%= t('profile.view_orders') || 'Mis Pedidos' %></span>
                        </a>
                    </div>
                    <div class="col-sm-6">
                        <a href="/user/myReviews" class="btn d-block action-button p-3 border shadow-sm text-center" style="background: white; border-color: #cbd5e1;">
                            <i class="bi bi-star-half fs-2 d-block mb-2 text-warning"></i>
                            <span class="text-dark"><%= t('profile.view_reviews') || 'Mis Reseñas' %></span>
                        </a>
                    </div>
                </div>

                <div class="text-center pt-4 border-top">
                    <% const confirmDel = t('profile.delete_confirm') || '¿Estás seguro de que deseas eliminar tu cuenta permanentemente?'; %>
                    <form action="/user/dismissSelf" method="post">
                        <input type="hidden" name="id" value="<%= user.id %>">
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-4 shadow-sm fw-bold" onclick="return confirm('<%= confirmDel %>')">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            <%= t('profile.delete_account') || 'Eliminar Mi Cuenta' %>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('../layout/footer') %>