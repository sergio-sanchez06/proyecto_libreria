<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= publisher.name %> - Editorial
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .publisher-hero-card {
            background: white;
            border-radius: 1.5rem;
            border: none;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
            overflow: hidden;
        }

        .logo-box {
            background: #f1f5f9;
            border-radius: 1.25rem;
            width: 120px;
            height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .spec-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            padding: 1.25rem;
            height: 100%;
        }

        .spec-label {
            color: #94a3b8;
            font-size: 0.7rem;
            text-transform: uppercase;
            font-weight: 800;
            letter-spacing: 0.05em;
            display: block;
            margin-bottom: 0.25rem;
        }

        .spec-value {
            color: #334155;
            font-weight: 700;
            font-size: 1rem;
        }

        .book-card {
            border: none;
            border-radius: 1.25rem;
            transition: transform 0.3s ease;
        }

        .book-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08) !important;
        }
    </style>
</head>

<body>
    <%- include('../layout/header') %>

        <main class="container py-5">
            <div class="publisher-hero-card p-4 p-md-5 mb-5 border border-light">
                <div class="row align-items-center">
                    <div class="col-md-2 mb-4 mb-md-0 d-flex justify-content-center">
                        <div class="logo-box shadow-sm">
                            <% if (publisher.image_url) { %>
                                <img src="<%= publisher.image_url %>" alt="Logo" class="img-fluid p-3">
                                <% } else { %>
                                    <i class="bi bi-building text-primary display-4"></i>
                                    <% } %>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h1 class="display-4 fw-bold mb-1">
                            <%= publisher.name %>
                        </h1>
                        <p class="text-primary fw-bold mb-0"><i class="bi bi-geo-alt me-1"></i>
                            <%= publisher.country || 'Internacional' %>
                        </p>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <a href="<%= publisher.website %>" target="_blank"
                            class="btn btn-dark btn-lg rounded-pill px-4 fw-bold">
                            <%= t('publisher_detail.website') %> <i class="bi bi-box-arrow-up-right ms-2 small"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-5">
                <div class="col-lg-8">
                    <h4 class="fw-bold text-uppercase small text-muted mb-3" style="letter-spacing: 2px;">
                        <%= t('publisher_detail.description') %>
                    </h4>
                    <p class="fs-5 text-secondary lh-lg">
                        <%= publisher.descripcion || 'No hay descripción disponible para esta editorial.' %>
                    </p>
                </div>
                <div class="col-lg-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="spec-card shadow-sm">
                                <span class="spec-label">Sede Central</span>
                                <span class="spec-value">
                                    <%= publisher.country %>
                                </span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="spec-card shadow-sm">
                                <span class="spec-label">Catálogo Activo</span>
                                <span class="spec-value">
                                    <%= books.length %> Títulos publicados
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <h3 class="fw-bold mb-4 text-center text-md-start">
                <%= t('publisher_detail.books_by', { name: publisher.name }) %>
            </h3>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
                <% books.forEach(book=> { %>
                    <div class="col">
                        <div class="card h-100 shadow-sm book-card">
                            <img src="<%= book.cover_url || '/images/default-cover.jpg' %>" class="card-img-top"
                                style="height: 280px; object-fit: cover; border-radius: 1.25rem 1.25rem 0 0;">
                            <div class="card-body p-4">
                                <h6 class="fw-bold mb-2 text-truncate">
                                    <%= book.title %>
                                </h6>
                                <p class="text-muted small mb-3">
                                    <%= t('publisher_detail.year') %>: <%= book.releashed_year %>
                                </p>
                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                    <span class="fw-bold text-dark">
                                        <%= book.price %>€
                                    </span>
                                    <a href="/books/book/<%= book.id %>"
                                        class="btn btn-sm btn-primary rounded-pill px-3">
                                        <%= t('publisher_detail.view_book') %>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
            </div>

            <% if(user && user.role==="ADMIN" ) { %>
                <div
                    class="p-4 bg-dark text-white rounded-4 shadow-lg d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold m-0"><i class="bi bi-shield-lock me-2"></i>Admin Mode</h5>
                    <div class="d-flex gap-2">
                        <a href="/publisher/edit/<%= publisher.id %>" class="btn btn-outline-light rounded-pill px-4">
                            <%= t('publisher_detail.edit') %>
                        </a>
                        <% const confirmMsgPub=t('admin.confirm').replace(/'/g, "\\'" ); %>
                            <form action="/publisher/delete/<%= publisher.id %>" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-danger rounded-pill px-4"
                                    onclick="return confirm('<%= confirmMsgPub %>')">
                                    <%= t('publisher_detail.delete') %>
                                </button>
                            </form>
                    </div>
                </div>
                <% } %>
        </main>

        <%- include('../layout/footer') %>
</body>

</html>