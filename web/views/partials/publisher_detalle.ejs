<%- include('../layout/header', { title: publisher.name + ' - ' + t('nav.publishers'), bodyClass: 'bg-main-vistas' ,
    extraCSS: 'partials/publisher_detalle' }) %>

    <main class="container py-5">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb" style="font-weight: 500;">
                <li class="breadcrumb-item"><a href="/publisher/showAllPublishers"
                        class="text-decoration-none text-muted"><%= t('catalog.breadcrumb') %></a></li>
                <li class="breadcrumb-item active" style="color: var(--brand-teal);"><%= publisher.name %></li>
            </ol>
        </nav>

        <div class="publisher-hero-card p-4 p-md-5 mb-5 border border-light">
            <div class="row align-items-center">
                <div class="col-md-3 col-xl-2 mb-4 mb-md-0 d-flex justify-content-center">
                    <div class="logo-box shadow-sm">
                        <% if (publisher.image_url) { %>
                            <img src="<%= publisher.image_url %>" alt="Logo de <%= publisher.name %>"
                                class="img-fluid p-3" style="max-height: 100px; object-fit: contain;">
                            <% } else { %>
                                <i class="bi bi-building text-muted display-3 opacity-50"></i>
                                <% } %>
                    </div>
                </div>
                <div class="col-md-5 col-xl-6 text-center text-md-start">
                    <h1 class="display-4 fw-bold mb-2" style="color: var(--brand-teal); letter-spacing: -1px;">
                        <%= publisher.name %>
                    </h1>
                    <p class="fs-5 fw-medium mb-0" style="color: #64748b;">
                        <i class="bi bi-geo-alt-fill me-1 opacity-75 text-warning"></i>
                        <%= publisher.country %>
                    </p>
                </div>
                <div class="col-md-4 text-center text-md-end mt-4 mt-md-0">
                    <a href="<%= publisher.website %>" target="_blank"
                        class="btn btn-dark btn-lg rounded-pill px-4 fw-bold shadow-sm d-inline-flex align-items-center gap-2 transition"
                        style="background-color: var(--brand-teal); border: none;">
                        <span>
                            <%= t('publisher_detail.website') %>
                        </span> <i class="bi bi-box-arrow-up-right fs-6"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-lg-8">
                <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border h-100"
                    style="border-color: rgba(0,0,0,0.05) !important;">
                    <h4 class="fw-bold mb-4" style="color: var(--brand-teal);">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <%= t('publisher_detail.description') %>
                    </h4>

                    <div class="description-wrapper"
                        style="max-height: 120px; overflow: hidden; position: relative; transition: max-height 0.6s ease;">
                        <p id="publisher-desc" class="fs-5 text-secondary description-content"
                            style="line-height: 1.8; text-align: justify;">
                            <%= publisher.descripcion || t('book.no_desc') %>
                        </p>
                        <div class="read-more-overlay"
                            style="position: absolute; bottom: 0; left: 0; width: 100%; height: 50px; background: linear-gradient(transparent, white); pointer-events: none;">
                        </div>
                    </div>

                    <button id="btn-read-more" class="btn btn-link p-0 mt-2 text-decoration-none fw-bold"
                        style="color: var(--brand-teal); display: none;">
                        <span class="btn-text">Ver más</span> <i class="bi bi-chevron-down ms-1"></i>
                    </button>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="row g-3">
                    <div class="col-12">
                        <div class="spec-card">
                            <span class="spec-label"><i class="bi bi-house-door-fill me-1"></i><%= t('publisher_detail.country') %></span>
                            <span class="spec-value text-dark">
                                <%= publisher.country || t('publisher_detail.country_not_specified') %>
                            </span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="spec-card">
                            <span class="spec-label"><i class="bi bi-journal-bookmark-fill me-1"></i>
                                <%= t('publisher_detail.books_count', { count: books.length }) %>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <hr class="my-5 border-0"
            style="height: 2px; background: linear-gradient(90deg, transparent, rgba(30,64,175,0.2), transparent);">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold m-0" style="color: var(--brand-teal);">
                <%= t('publisher_detail.books_by', { name: publisher.name }) %>
            </h3>
            <span class="badge rounded-pill px-3 py-2 fs-6"
                style="background-color: var(--brand-gold); color: #1e3a8a;">
                <%= books.length %> Publicaciones
            </span>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4 mb-5">
            <% books.forEach(book=> { %>
                <div class="col">
                    <div class="card h-100 book-card p-2">
                        <div class="book-img-container">
                            <img src="<%= book.cover_url || '/images/default-cover.jpg' %>" class="mh-100 mw-100"
                                style="object-fit: contain;" alt="<%= book.title %>">
                        </div>

                        <div class="card-body d-flex flex-column px-2 pb-2 pt-3 text-center">
                            <h6 class="card-title fw-bold mb-2 text-dark"
                                style="font-size: 0.95rem; min-height: 2.7rem; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"
                                title="<%= book.title %>">
                                <%= book.title %>
                            </h6>
                            <p class="text-muted small mb-2 opacity-75">
                                <%= t('publisher_detail.year') %>: <%= book.releashed_year || '-' %>
                            </p>
                            <p class="mb-3" style="font-size: 1.25rem; font-weight: 800; color: var(--brand-teal);">
                                <%= book.price %>€
                            </p>
                            <div class="mt-auto">
                                <div class="d-flex flex-column gap-2">
                                    <a href="/books/book/<%= book.id %>"
                                        class="btn btn-outline-dark btn-sm py-2 w-100 rounded-pill"
                                        style="border-radius: 12px !important; font-weight: 600; border-color: var(--brand-teal); color: var(--brand-teal);">
                                        <i class="bi bi-eye ms-1"></i>
                                        <%= t('publisher_detail.view_book') %>
                                    </a>
                                    <form action="/cart/add" method="POST" class="d-flex gap-2">
                                        <input type="hidden" name="book_id" value="<%= book.id %>">
                                        <input type="number" name="quantity" value="1" min="1"
                                            class="form-control form-control-sm text-center shadow-sm"
                                            style="width: 60px; border-radius: 8px; border: 1px solid rgba(0,0,0,0.1);">
                                        <button type="submit" class="btn btn-sm flex-grow-1 shadow-sm px-0 text-dark"
                                            style="background-color: var(--brand-gold); font-weight: 700; border-radius: 8px; border: none;">
                                            <i class="bi bi-cart-plus-fill me-1"></i>  <%= t('book.add_to_cart') %>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>

                    <% if(books.length===0) { %>
                        <div class="col-12 text-center py-5">
                            <i class="bi bi-journals text-muted display-4 mb-3 d-block opacity-50"></i>
                            <h5 class="fw-bold text-muted"><%= t('publisher_detail.no_books') %></h5>
                        </div>
                        <% } %>
        </div>

        <!-- ADMIN PANEL -->
        <% if(user && user.role==="ADMIN" ) { %>
            <div class="mt-5 p-4 rounded-4 shadow-lg position-relative overflow-hidden"
                style="background: linear-gradient(135deg, var(--brand-teal), #1e3a8a); border-top: 6px solid var(--brand-gold);">
                <div class="position-absolute top-0 end-0 opacity-10" style="transform: translate(20%, -20%);">
                    <i class="bi bi-shield-check" style="font-size: 15rem;"></i>
                </div>
                <div
                    class="d-flex flex-column flex-md-row align-items-center justify-content-between position-relative z-index-1">
                    <div class="text-white mb-4 mb-md-0 text-center text-md-start">
                        <h5 class="fw-bold m-0 fs-4"><i class="bi bi-gear-fill me-2 text-warning"></i><%= t('admin.panel')
                                %>
                        </h5>
                        <p class="small text-white-50 m-0 mt-1"><%= t('admin.panel_body') %></p>
                    </div>
                    <div class="d-flex gap-3">
                        <a href="/publisher/edit/<%= publisher.id %>"
                            class="btn bg-white rounded-pill px-4 py-2 shadow-sm d-flex align-items-center gap-2"
                            style="color: var(--brand-teal); font-weight: 700;">
                            <i class="bi bi-pencil-square"></i>
                            <%= t('publisher_detail.edit') %>
                        </a>
                        <button type="button"
                            class="btn btn-outline-light rounded-pill px-4 py-2 fw-bold d-flex align-items-center gap-2"
                            data-bs-toggle="modal" data-bs-target="#modalDeletePublisher">
                            <i class="bi bi-trash3"></i>
                            <%= t('publisher_detail.delete') %>
                        </button>
                    </div>
                </div>
            </div>
            <% } %>

                <% if (user && user.role==="ADMIN" ) { %>
                    <div class="modal fade" id="modalDeletePublisher" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content border-0 shadow-lg rounded-4">
                                <div class="modal-header border-0"
                                    style="background: linear-gradient(135deg, #dc2626, #991b1b);">
                                    <h5 class="modal-title fw-bold text-white">
                                        <i class="bi bi-trash3-fill me-2"></i><%= t('admin.delete_publisher')%>
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white"
                                        data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body p-4 text-center">
                                    <div class="mb-3">
                                        <i class="bi bi-exclamation-triangle-fill text-danger"
                                            style="font-size: 3rem;"></i>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-2">
                                        <%= t('admin.delete_publisher') %>: "<%= publisher.name %>"
                                    </h6>
                                    <p class="text-muted small mb-0">
                                        <%= t('admin.delete_publisher_message') %>
                                    </p>
                                </div>
                                <div class="modal-footer border-0 justify-content-center pb-4 gap-3">
                                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold"
                                        data-bs-dismiss="modal">
                                        <i class="bi bi-x-lg me-1"></i><%= t('admin.cancel') %>
                                    </button>
                                    <form action="/publisher/delete/<%= publisher.id %>" method="POST"
                                        data-requires-token class="m-0">
                                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                                            <i class="bi bi-trash3 me-1"></i><%= t('admin.delete_publisher') %>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>

    </main>

    <script src="/js/viewsFunctions.mjs"></script>

