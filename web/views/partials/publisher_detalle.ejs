<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= publisher.name %> - Editorial
    </title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/publisher_detail.css">
</head>

<body>

    <%- include('../layout/header') %>

        <div class="container py-5">
            <div class="publisher-header text-center mb-5">
                <h1 class="fw-bold">
                    <%= publisher.name || t('publisher_detail.not_available') %>
                </h1>
                <% if (publisher.country) { %>
                    <p class="lead text-muted">
                        <%= publisher.country %>
                    </p>
                    <% } %>
            </div>

            <div class="publisher-info mb-5 p-4 bg-light rounded shadow-sm">
                <h3 class="mb-4">
                    <%= t('publisher_detail.title_info') %>
                </h3>

                <p><strong>
                        <%= t('publisher_detail.website') %>:
                    </strong>
                    <% if (publisher.website) { %>
                        <a href="<%= publisher.website %>" target="_blank">
                            <%= publisher.website %>
                        </a>
                        <% } else { %>
                            <%= t('publisher_detail.not_available') %>
                                <% } %>
                </p>

                <% if (publisher.descripcion) { %>
                    <p><strong>
                            <%= t('publisher_detail.description') %>:
                        </strong>
                        <%= publisher.descripcion %>
                    </p>
                    <% } %>

                        <% if (publisher.image_url) { %>
                            <div class="mt-3">
                                <strong>
                                    <%= t('publisher_detail.image') %>:
                                </strong><br>
                                <img src="<%= publisher.image_url %>" alt="<%= publisher.name %>"
                                    class="img-fluid mt-2 rounded" style="max-height: 100px;">
                            </div>
                            <% } %>
            </div>

            <h2 class="text-center mb-4">
                <%= t('publisher_detail.books_by', { name: publisher.name }) %>
            </h2>

            <% if (books && books.length> 0) { %>
                <div class="row justify-content-center g-4">
                    <% books.forEach(book=> { %>
                        <div class="col-md-3">
                            <div class="card h-100 shadow-sm book-card border-0">
                                <img src="<%= book.cover_url || '/images/default-cover.jpg' %>" class="card-img-top"
                                    alt="<%= book.title %>">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title text-truncate" title="<%= book.title %>">
                                        <%= book.title %>
                                    </h5>
                                    <p class="card-text text-muted small">
                                        <%= t('publisher_detail.year') %>: <%= book.releashed_year ||
                                                t('publisher_detail.unknown') %>
                                    </p>
                                    <p class="card-text fw-bold text-primary mt-auto fs-5">
                                        <%= book.price %>€
                                    </p>
                                    <a href="/books/book/<%= book.id %>"
                                        class="btn btn-outline-primary btn-sm mt-3 rounded-pill">
                                        <%= t('publisher_detail.view_book') %>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% } else { %>
                    <p class="text-center text-muted py-5">
                        <%= t('publisher_detail.no_books') %>
                    </p>
                    <% } %>

                        <div class="mt-5 pt-4 border-top text-center">
                            <% if (user && user.role==="ADMIN" ) { %>
                                <% const confirmMsg=t('admin.confirm'); %>
                                    <div class="d-flex justify-content-center gap-3 mb-3">
                                        <a href="/publisher/edit/<%= publisher.id %>"
                                            class="btn btn-warning rounded-pill px-4">
                                            <%= t('publisher_detail.edit') %>
                                        </a>
                                        <form action="/publisher/delete/<%= publisher.id %>" method="post"
                                            class="d-inline">
                                            <input type="hidden" name="id" value="<%= publisher.id %>">
                                            <button type="submit" class="btn btn-danger rounded-pill px-4"
                                                onclick="return confirm('<%= confirmMsg %>')">
                                                <%= t('publisher_detail.delete') %>
                                            </button>
                                        </form>
                                    </div>
                                    <% } %>

                                        <div class="back-link mt-3">
                                            <a href="/" class="text-decoration-none">
                                                <%= t('publisher_detail.back') %>
                                            </a>
                                        </div>
                        </div>
        </div>

        <%- include('../layout/footer') %>

            <!-- Bootstrap JS (para efectos si los añades) -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>