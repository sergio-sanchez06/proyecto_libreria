<%- include('../layout/header', { title: t('profile.edit_data') || 'Actualizar Perfil' , bodyClass: 'bg-main-vistas' })
    %>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            color: var(--text-dark);
        }

        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(252, 250, 247, 0.45);
            z-index: -1;
        }

        .profile-form-container {
            max-width: 600px;
            margin: 0 auto;
        }

        .brand-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.05);
            overflow: hidden;
        }

        .brand-card-header {
            background: linear-gradient(135deg, var(--brand-teal), #1e3a8a);
            color: white;
            padding: 2rem;
            border-bottom: 6px solid var(--brand-gold);
            text-align: center;
        }

        .form-label {
            font-weight: 700;
            color: #1e293b;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.5rem;
        }

        .form-control {
            border-radius: 12px;
            border: 1px solid #cbd5e1;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
            background-color: #f8fafc;
        }

        .form-control:focus {
            border-color: var(--brand-teal);
            box-shadow: 0 0 0 4px rgba(30, 64, 175, 0.1);
            background-color: white;
        }

        .btn-brand-teal {
            background-color: var(--brand-teal);
            color: white;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-brand-teal:hover {
            background-color: var(--brand-teal-hover);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(30, 64, 175, 0.25);
            color: white;
        }
    </style>

    <main class="py-5">
        <div class="container profile-form-container">

            <div class="brand-card">
                <div class="brand-card-header">
                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
                        style="width: 80px; height: 80px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                        <i class="bi bi-person-lines-fill text-primary" style="font-size: 2.5rem;"></i>
                    </div>
                    <h2 class="mb-0 fw-bold">
                        <%= t('profile.edit_data') || 'Actualizar mis Datos' %>
                    </h2>
                    <p class="text-white-50 mt-2 mb-0">Mantén tu información personal al día</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <% if (locals.error) { %>
                        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                            <div>
                                <%= error %>
                            </div>
                        </div>
                        <% } %>

                            <form action="/user/edit/<%= user.id %>" method="POST" data-requires-token>

                                <div class="mb-4">
                                    <label class="form-label"><i class="bi bi-person me-1"></i>
                                        <%= t('addUser.label_name') || 'Nombre Completo' %> *
                                    </label>
                                    <input type="text" name="name" class="form-control" value="<%= user.name %>"
                                        required>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label text-muted"><i class="bi bi-envelope me-1"></i>
                                        <%= t('addUser.label_email') || 'Correo Electrónico' %> <i
                                                class="bi bi-lock-fill ms-1" title="No editable"></i>
                                    </label>
                                    <input type="email" name="email" class="form-control" value="<%= user.email %>"
                                        readonly
                                        style="background-color: #e2e8f0; color: #64748b; cursor: not-allowed;">
                                </div>

                                <div class="mb-4">
                                    <label class="form-label"><i class="bi bi-house-door me-1"></i>
                                        <%= t('addUser.label_address_default') || 'Dirección Principal' %>
                                    </label>
                                    <textarea name="default_address" class="form-control"
                                        rows="2"><%= user.default_address %></textarea>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label"><i class="bi bi-building me-1"></i>
                                        <%= t('addUser.label_address_optional') || 'Dirección Opcional' %>
                                    </label>
                                    <textarea name="optional_address" class="form-control"
                                        rows="2"><%= user.optional_address %></textarea>
                                </div>

                                <div class="mb-4 d-none">
                                    <label class="form-label text-muted">Firebase UID</label>
                                    <input type="text" name="firebase_uid" class="form-control"
                                        value="<%= user.firebase_uid %>" disabled>
                                </div>

                                <div class="d-flex justify-content-center gap-3 mt-5 pt-4 border-top">
                                    <a href="/user/profile"
                                        class="btn btn-light px-4 py-2 rounded-pill fw-bold text-secondary border shadow-sm">
                                        <%= t('addAuthor.btn_cancel') || 'Cancelar' %>
                                    </a>
                                    <button type="submit"
                                        class="btn btn-brand-teal px-5 py-2 fw-bold rounded-pill text-white shadow-sm d-flex align-items-center gap-2">
                                        <i class="bi bi-save2"></i>
                                        <%= t('editAuthor.btn_save') || 'Guardar Cambios' %>
                                    </button>
                                </div>
                            </form>
                </div>
            </div>
        </div>
    </main>

    <%- include('../layout/footer') %>