<%- include("../layout/header") %>

    <link rel="stylesheet" href="/css/libro_detalle.css">
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, var(--brand-teal) 0%, var(--brand-teal-hover) 100%);
        }

        body {
            background-color: var(--bg-cream);
        }

        /* Contenedor de la Portada */
        .book-cover-wrapper {
            position: sticky;
            top: 2rem;
            border-radius: 1.5rem;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            transition: transform 0.4s ease;
        }

        .book-cover-wrapper:hover {
            transform: translateY(-5px);
        }

        /* Detalles Estéticos */
        .book-title {
            font-weight: 850;
            color: var(--brand-teal);
            letter-spacing: -0.025em;
        }

        .spec-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            padding: 1.25rem;
            transition: all 0.2s ease;
        }

        .spec-label {
            color: #94a3b8;
            font-size: 0.7rem;
            text-transform: uppercase;
            font-weight: 800;
            letter-spacing: 0.05em;
            display: block;
            margin-bottom: 0.25rem;
        }

        .spec-value {
            color: #334155;
            font-weight: 700;
            font-size: 1rem;
        }

        /* Tarjeta de Precio y Acción */
        .purchase-card {
            background: white;
            border-radius: 1.5rem;
            border: none;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
            overflow: hidden;
        }

        .price-display {
            font-size: 3rem;
            font-weight: 850;
            color: #2d3436;
            line-height: 1;
        }

        .badge-genre {
            background-color: white;
            color: var(--brand-teal);
            border: 1px solid var(--brand-gold);
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .badge-genre:hover {
            background-color: #c3dafe;
        }

        .review-card {
            border-left: 6px solid var(--brand-gold) !important;
            background: white;
            box-shadow: var(--shadow-soft);
        }

        .synopsis-text {
            overflow: hidden;
            line-height: 1.5em;
            height: 4.5em;
            /* 1.5em * 3 líneas = altura fija inicial */
        }

        .synopsis-text.expanded {
            height: auto;
        }

        #toggle-synopsis {
            background: none;
            font-size: 16px;
            border: none;
            color: #007bff;
            cursor: pointer;
            padding: 0;
            font-weight: bold;
            margin-top: 5px;
            margin-bottom: 10px;
        }

        .author-link:hover {
            color: #14b8a6 !important;
            /* Un tono más claro del teal para el hover */
            text-decoration: underline !important;
        }
    </style>

    <div class="book-detail-main py-5">
        <div class="row g-5">
            <div class="col-lg-4">
                <div class="book-cover-wrapper">
                    <img src="<%= book.cover_url || '/images/default-cover.jpg' %>" alt="<%= book.title %>"
                        class="w-100 d-block">
                </div>
            </div>

            <div class="col-lg-8">
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/books" class="text-decoration-none text-muted">Libros</a>
                        </li>
                        <li class="breadcrumb-item active fw-bold">
                            <%= book.format %>
                        </li>
                    </ol>
                </nav>

                <h1 class="book-title display-3 mb-3">
                    <%= book.title || t('book.no_synopsis') %>
                </h1>

                <div class="d-flex align-items-center mb-4 flex-wrap">
                    <span class="text-muted me-2">
                        <%= t('book.author') %>:
                    </span>

                    <% authors.forEach((author, index)=> { %>
                        <% if (author.deleted_at) { %>
                            <span class="fw-bold fs-5 text-secondary opacity-75"
                                title="Este autor ya no está disponible en el catálogo activo">
                                <%= author.name %>
                                    <small class="fw-normal" style="font-size: 0.7rem;">(No disponible)</small>
                            </span>
                            <% } else { %>
                                <a href="/author/<%= author.id %>" class="fw-bold fs-5 text-decoration-none author-link"
                                    style="color: var(--brand-teal); transition: color 0.2s;">
                                    <%= author.name %>
                                </a>
                                <% } %>

                                    <% if (index < authors.length - 1) { %>
                                        <span class="me-1">,</span>
                                        <% } %>
                                            <% }) %>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-5">
                    <% genres.forEach(genre=> { %>
                        <a href="/genres/<%= genre.genre.name %>"
                            class="badge badge-genre text-decoration-none px-4 py-2 rounded-pill shadow-sm">
                            <%= genre.genre.name %> &nbsp; <small class="opacity-75">(<%= t('book.view') %>) </small>
                        </a>
                        <% }) %>
                </div>

                <div class="purchase-card p-4 p-md-5 mb-5 border border-light">
                    <div class="row align-items-center">
                        <div class="col-md-6 mb-4 mb-md-0">
                            <span class="text-muted small fw-bold d-block mb-1">PVP RECOMENDADO</span>
                            <h2 class="price-display mb-0">
                                <%= book.price %>€
                            </h2>
                            <div class="mt-2 text-center text-md-start">
                                <span class="badge px-4 py-2 rounded-pill"
                                    style="background-color: var(--brand-teal); font-weight: 700;">
                                    <i class="bi bi-box-seam me-1"></i>
                                    <%= book.stock> 0 ? 'Stock Disponible' : 'Agotado' %>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <form action="/cart/add" method="POST" class="bg-light p-3 rounded-4">
                                <input type="hidden" name="book_id" value="<%= book.id %>">
                                <div class="row g-2">
                                    <div class="col-4">
                                        <label class="small fw-bold text-muted ms-1">
                                            <%= t('book.quantity') %>
                                        </label>
                                        <input type="number" name="quantity" value="1" min="1" max="<%= book.stock %>"
                                            class="form-control form-control-lg border-0 shadow-sm">
                                    </div>
                                    <div class="col-8 d-flex align-items-end">
                                        <button type="submit" class="btn btn-lg w-100 fw-bold shadow-sm py-3 text-white"
                                            style="background-color: var(--brand-teal); border-radius: 12px;"
                                            <%=book.stock <=0 ? 'disabled' : '' %>>
                                            <%= t('book.add_to_cart') %> 🛒
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="synopsis-container">
                    <p>
                        <%= book.synopsis.substring(0, 300) %>...
                            <span id="extra-text" style="display:none;">
                                <%= book.synopsis.substring(300) %>
                            </span>
                    </p>
                    <button id="toggle-synopsis" class="btn btn-sm fw-bold"
                        style="color: var(--brand-teal); border: 1px solid var(--brand-gold); border-radius: 20px; padding: 5px 20px;">Leer
                        más</button>
                </div>

                <div class="row g-3 mb-5">
                    <div class="col-6 col-md-4">
                        <div class="spec-card">
                            <span class="spec-label">
                                <%= t('book.isbn') %>
                            </span>
                            <span class="spec-value">
                                <%= book.isbn %>
                            </span>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="spec-card">
                            <span class="spec-label">
                                <%= t('book.publisher') %>
                            </span>

                            <% if(publisher.deleted_at){ %>
                                <span class="spec-value text-decoration-none" style="color: var(--brand-teal);">
                                    <%= publisher.name %> (No se encuentra disponible)
                                </span>
                                <% }else{ %>
                                    <a href="/publisher/<%= publisher.id %>" class="spec-value text-decoration-none"
                                        style="color: var(--brand-teal);">
                                        <%= publisher.name %>
                                    </a>
                                    <% } %>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="spec-card">
                            <span class="spec-label">
                                <%= t('book.release') %>
                            </span>
                            <span class="spec-value">
                                <%= book.releashed_year || 'No disponible' %>
                            </span>
                        </div>
                    </div>
                    <div class="col-4 col-md-4">
                        <div class="spec-card">
                            <span class="spec-label">
                                <%= t('book.format') %>
                            </span>
                            <span class="spec-value">
                                <%= book.format %>
                            </span>
                        </div>
                    </div>
                    <div class="col-4 col-md-4">
                        <div class="spec-card">
                            <span class="spec-label">
                                <%= t('book.language') %>
                            </span>
                            <span class="spec-value">
                                <%= book.language %>
                            </span>
                        </div>
                    </div>
                    <div class="col-4 col-md-4">
                        <div class="spec-card">
                            <span class="spec-label">
                                <%= t('book.pages') %>
                            </span>
                            <span class="spec-value">
                                <%= book.pages %>
                            </span>
                        </div>
                    </div>
                </div>

                <hr class="my-5 border-0 bg-secondary opacity-10" style="height: 1px;">

                <div class="row g-4">
                    <div class="col-md-5">
                        <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                            <h4 class="fw-bold mb-4 fs-5">
                                <%= t('review.add_review') %>
                            </h4>
                            <form action="/review/create" method="POST">
                                <input type="hidden" name="book_id" value="<%= book.id %>">
                                <div class="mb-3">
                                    <label class="form-label fw-bold small text-muted">
                                        <%= t('review.rating') %>
                                    </label>
                                    <select name="rating" class="form-select border-light bg-light">
                                        <option value="5">⭐⭐⭐⭐⭐ (5)</option>
                                        <option value="4">⭐⭐⭐⭐ (4)</option>
                                        <option value="3">⭐⭐⭐ (3)</option>
                                        <option value="2">⭐⭐ (2)</option>
                                        <option value="1">⭐ (1)</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold small text-muted">
                                        <%= t('review.comment') %>
                                    </label>
                                    <textarea name="comment" class="form-control border-light bg-light" rows="4"
                                        required></textarea>
                                </div>
                                <button type="submit" class="btn w-100 rounded-pill py-3 fw-bold text-white"
                                    style="background-color: var(--brand-teal);">
                                    <%= t('review.add_review') %> ✍️
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="col-md-7">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h3 class="fw-bold m-0" style="color: var(--brand-teal);">
                                <%= t('review.reviews') %>
                            </h3>
                            <span class="badge rounded-pill px-3" style="background-color: var(--brand-gold);">
                                <%= reviews.length %>
                            </span>
                        </div>
                        <div class="reviews-list">
                            <% if (reviews && reviews.length> 0) { %>
                                <% reviews.forEach(review=> { %>
                                    <div class="card border-0 shadow-sm mb-3 rounded-4 p-3 review-card">
                                        <div class="d-flex justify-content-between">
                                            <h6 class="fw-bold m-0" style="color: var(--brand-teal);">
                                                <%= review.user_email %>
                                            </h6>

                                            <% if (user && user.email===review.user_email) { %>
                                                <button class="btn btn-sm btn-outline-secondary border-0 rounded-pill"
                                                    onclick="toggleEditReview('<%= review.id %>')">
                                                    <i class="bi bi-pencil-square"></i>
                                                    <%= t('review.edit') %>
                                                </button>
                                                <% } %>

                                                    <% if (user && user.email===review.user_email) { %>
                                                        <form action="/review/delete/<%= review.id %>" method="POST"
                                                            style="display: inline;">
                                                            <input type="hidden" name="book_id" value="<%= book.id %>">
                                                            <button type="submit"
                                                                class="btn btn-sm btn-outline-danger border-0 rounded-pill"
                                                                onclick="return confirm('¿Estás seguro de que quieres eliminar esta reseña?')">
                                                                <i class="bi bi-trash"></i>
                                                                <%= t('review.delete') %>
                                                            </button>
                                                        </form>
                                                        <% } %>

                                        </div>

                                        <div id="review-display-<%= review.id %>">
                                            <div class="text-warning my-2">
                                                <% for(let i=0; i<5; i++) { %>
                                                    <i
                                                        class="bi bi-star-fill <%= i < review.rating ? '' : 'text-muted opacity-25' %>"></i>
                                                    <% } %>
                                            </div>
                                            <p class="mb-0 text-secondary">"<%= review.comment %>"</p>
                                        </div>

                                        <div id="review-edit-form-<%= review.id %>" style="display: none;" class="mt-3">
                                            <form action="/review/update/<%= review.id %>" method="POST">
                                                <input type="hidden" name="book_id" value="<%= book.id %>">

                                                <select name="rating" class="form-select border-light bg-light mb-2">
                                                    <option value="5" <%=review.rating===5 ? 'selected' : '' %>
                                                        >⭐⭐⭐⭐⭐</option>
                                                    <option value="4" <%=review.rating===4 ? 'selected' : '' %>>⭐⭐⭐⭐
                                                    </option>
                                                    <option value="3" <%=review.rating===3 ? 'selected' : '' %>>⭐⭐⭐
                                                    </option>
                                                    <option value="2" <%=review.rating===2 ? 'selected' : '' %>>⭐⭐
                                                    </option>
                                                    <option value="1" <%=review.rating===1 ? 'selected' : '' %>>⭐
                                                    </option>
                                                </select>

                                                <textarea name="comment" class="form-control border-light bg-light mb-2"
                                                    rows="3" required><%= review.comment %></textarea>

                                                <div class="d-flex gap-2">
                                                    <button type="submit"
                                                        class="btn btn-success btn-sm rounded-pill px-3 fw-bold">
                                                        <%= t('review.save') %>
                                                    </button>
                                                    <button type="button" class="btn btn-light btn-sm rounded-pill px-3"
                                                        onclick="toggleEditReview('<%= review.id %>')">
                                                        <%= t('review.cancel') %>
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="text-center py-5 bg-white rounded-4 border border-dashed">
                                                <i class="bi bi-chat-heart text-muted display-4"></i>
                                                <p class="text-muted mt-2">
                                                    <%= t('review.no_reviews_yet') %>
                                                </p>
                                            </div>
                                            <% } %>
                        </div>
                    </div>
                </div>

                <% if(user && user.role==="ADMIN" ) { %>
                    <div class="mt-5 p-4 text-white rounded-4 shadow-lg d-flex align-items-center justify-content-between"
                        style="background-color: var(--brand-teal); border-left: 6px solid var(--brand-gold);">
                        <div>
                            <h5 class="fw-bold m-0"><i class="bi bi-shield-lock-fill me-2"></i>
                                <%= t('admin.panel') %>
                            </h5>
                            <p class="small text-white-50 m-0">Opciones de gestión exclusivas para administradores
                            </p>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="/admin/books/update/<%= book.id %>" class="btn btn-light rounded-pill px-4 fw-bold"
                                style="color: var(--brand-teal);">
                                <i class="bi bi-pencil me-1"></i>
                                <%= t('book.edit_book') %>
                            </a>
                            <form action="/admin/books/delete/<%= book.id %>" method="POST">
                                <button type="submit" class="btn btn-outline-light rounded-pill px-4 fw-bold">
                                    <i class="bi bi-trash me-1"></i>
                                    <%= t('book.delete_book') %>
                                </button>
                            </form>
                        </div>
                    </div>
                    <% } %>
            </div>
        </div>
    </div>

    <%- include('../layout/footer') %>

        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script>
            $(document).ready(function () {
                $('#toggle-synopsis').click(function () {
                    const btn = $(this);
                    // 500ms de duración
                    $('#extra-text').slideToggle(500, function () {
                        // Al terminar el slide, cambiamos el texto del botón
                        if ($(this).is(':visible')) {
                            btn.text('Leer menos');
                        } else {
                            btn.text('Leer más');
                        }
                    });
                });

            });

            // Función que permite mostrar y ocultar el formulario de edición de una reseña

            function toggleEditReview(reviewId) {
                const displayDiv = document.getElementById(`review-display-${reviewId}`);
                const editFormDiv = document.getElementById(`review-edit-form-${reviewId}`);

                if (editFormDiv.style.display === "none") {
                    displayDiv.style.display = "none";
                    editFormDiv.style.display = "block";
                } else {
                    displayDiv.style.display = "block";
                    editFormDiv.style.display = "none";
                }
            }

        </script>