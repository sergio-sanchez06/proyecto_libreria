<%- include('../layout/header', { title: book.title + ' - ' + book.format, bodyClass: 'bg-main-vistas' ,
    extraCSS: 'partials/libro_detalle' }) %>

    <div class="book-detail-main py-5">
        <div class="row g-5">
            <!-- Columna Izquierda: Portada -->
            <div class="col-md-5 col-lg-4 col-xl-3">
                <div class="book-cover-wrapper bg-white">
                    <img src="<%= book.cover_url || '/images/default-cover.jpg' %>" alt="<%= book.title %>"
                        class="w-100 d-block" style="object-fit: cover;" width="300" height="auto" loading="eager">
                </div>
            </div>

            <!-- Columna Derecha: Detalles -->
            <div class="col-md-7 col-lg-8 col-xl-9">
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb" style="font-weight: 500;">
                        <li class="breadcrumb-item"><a href="/books/showAllBooks"
                                class="text-decoration-none text-muted">Catálogo</a></li>
                        <li class="breadcrumb-item active" style="color: var(--brand-teal);">
                            <%= book.format %>
                        </li>
                    </ol>
                </nav>

                <h1 class="book-title mb-3">
                    <%= book.title || t('book.no_synopsis') %>
                </h1>

                <div class="d-flex align-items-center mb-4 flex-wrap fs-5">
                    <span class="text-muted me-2 fw-medium">
                        <i class="bi bi-pen-fill me-1 opacity-50"></i>
                        <%= t('book.author') %>:
                    </span>

                    <% authors.forEach((author, index)=> { %>
                        <% if (author.deleted_at) { %>
                            <span class="fw-bold text-secondary opacity-75">
                                <%= author.name %> <small class="fw-normal fs-6">(No disponible)</small>
                            </span>
                            <% } else { %>
                                <a href="/author/<%= author.id %>" class="fw-bold text-decoration-none author-link">
                                    <%= author.name %>
                                </a>
                                <% } %>
                                    <% if (index < authors.length - 1) { %> <span class="me-2 text-muted">,</span>
                                        <% } %>
                                            <% }) %>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-5">
                    <% genres.forEach(item=> { %>
                        <% const genreData=item.genre; %>


                            <% const isDeleted=genreData.deleted_at !=null; %>

                                <% console.log("El genero es: ", genreData.name) %>

                                <% console.log(" El genero esta eliminado?: ", genreData.deleted_at) %>

                                    <% if (isDeleted) { %>
                                        <span class=" badge rounded-pill bg-light text-secondary border px-4 py-2
                                    opacity-75" style="border-style: dashed !important;" title="Género no disponible">
                                    <i class="bi bi-lock-fill me-1 opacity-50"></i>
                                    <%= genreData.name %>
                                        </span>
                                        <% } else { %>
                                            <a href="/genres/<%= encodeURIComponent(genreData.name) %>"
                                                class="badge badge-genre text-decoration-none px-4 py-2 rounded-pill">
                                                <i class="bi bi-tag-fill me-1 opacity-50"></i>
                                                <%= genreData.name %>
                                            </a>
                                            <% } %>
                                                <% }) %>
                </div>

                <!-- Ficha de Compra -->
                <div
                    class="purchase-card p-4 p-md-5 mb-5 align-items-center d-flex flex-column flex-md-row justify-content-between">
                    <div class="mb-4 mb-md-0 text-center text-md-start">
                        <span
                            class="text-muted small fw-bold d-block mb-1 text-uppercase letter-spacing-1">Precio</span>
                        <h2 class="price-display mb-0">
                            <%= Number(book.price).toFixed(2) %>€
                        </h2>
                        <div class="mt-3">
                            <span class="badge px-4 py-2 rounded-pill fs-6 border"
                                style="background-color: var(--brand-gold); color: #1e3a8a; border-color: #d4af37 !important;">
                                <i class="bi bi-box-seam-fill me-1"></i>
                                <span class="d-none d-sm-inline">
                                    <%= book.stock> 0 ? 'En Stock ('+book.stock+')' : 'Agotado' %>
                                </span>
                                <span class="d-inline d-sm-none">
                                    <%= book.stock> 0 ? 'Stock: '+book.stock : 'Agotado' %>
                                </span>
                            </span>
                        </div>
                    </div>

                    <div class="w-100" style="max-width: 400px;">
                        <form action="/cart/add" method="POST" class="bg-white p-3 rounded-4 shadow-sm border"
                            style="border-color: rgba(30,64,175,0.1) !important;">
                            <input type="hidden" name="book_id" value="<%= book.id %>">
                            <div class="row g-3 align-items-end">
                                <div class="col-4">
                                    <label class="small fw-bold text-muted ms-1 mb-1 text-uppercase">
                                        Cant.
                                    </label>
                                    <input type="number" name="quantity" value="1" min="1" max="<%= book.stock %>"
                                        class="form-control form-control-lg text-center fw-bold"
                                        style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                                </div>
                                <div class="col-8">
                                    <button type="submit"
                                        class="btn btn-purchase btn-lg w-100 py-3 d-flex justify-content-center align-items-center gap-2"
                                        <%=book.stock <=0 ? 'disabled' : '' %>>
                                        <span>
                                            <%= t('book.add_to_cart') %>
                                        </span>
                                        <i class="bi bi-cart-plus-fill fs-5"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="mb-5 bg-white p-4 p-md-5 rounded-4 shadow-sm border"
                    style="border-color: rgba(0,0,0,0.05) !important;">
                    <h4 class="fw-bold mb-4" style="color: var(--brand-teal);">
                        <i class="bi bi-book-half me-2"></i>Sinopsis
                    </h4>

                    <div class="description-wrapper"
                        style="max-height: 120px; overflow: hidden; position: relative; transition: max-height 0.6s ease;">
                        <p id="publisher-desc" class="fs-5 text-secondary description-content"
                            style="line-height: 1.8; text-align: justify;">
                            <%= book.synopsis || 'No hay synopsis disponible...' %>
                        </p>
                        <div class="read-more-overlay"
                            style="position: absolute; bottom: 0; left: 0; width: 100%; height: 50px; background: linear-gradient(transparent, white); pointer-events: none;">
                        </div>
                    </div>

                    <button id="btn-read-more" class="btn btn-link p-0 mt-2 text-decoration-none fw-bold"
                        style="color: var(--brand-teal); display: none;">
                        <span class="btn-text">Ver más</span> <i class="bi bi-chevron-down ms-1"></i>
                    </button>

                    <!-- <div class="synopsis-container synopsis-text">
                        <% if (book.synopsis && book.synopsis.length> 400) { %>
                            <div class="mb-0 text-secondary" style="white-space: pre-line; line-height: 1.7;">
                                <span>
                                    <%= book.synopsis.substring(0, 400) %>
                                </span><span id="dots">...</span><span id="extra-text" style="display:none;">
                                    <%= book.synopsis.substring(400) %>
                                </span>
                            </div>
                            <button id="toggle-synopsis" class="btn btn-link p-0 mt-3 text-decoration-none fw-bold"
                                style="color: var(--brand-teal);">
                                Seguir leyendo <i class="bi bi-chevron-down ms-1 fs-6"></i>
                            </button>
                            <% } else { %>
                                <p class="mb-0 text-secondary" style="white-space: pre-line; line-height: 1.7;">
                                    <%= book.synopsis || 'No hay sinopsis disponible.' %>
                                </p>
                                <% } %>
                    </div> -->
                </div>

                <h4 class="fw-bold mb-4" style="color: var(--brand-teal);"><i
                        class="bi bi-info-circle-fill me-2"></i>Ficha Técnica</h4>
                <div class="row g-3 mb-5">
                    <div class="col-6 col-md-4">
                        <div class="spec-card">
                            <span class="spec-label"><i class="bi bi-upc-scan me-1"></i>
                                <%= t('book.isbn') %>
                            </span>
                            <span class="spec-value">
                                <%= book.isbn %>
                            </span>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="spec-card text-truncate">
                            <span class="spec-label"><i class="bi bi-building-fill me-1"></i>
                                <%= t('book.publisher') %>
                            </span>
                            <% if(publisher && publisher.deleted_at){ %>
                                <span class="spec-value text-secondary">
                                    <%= publisher.name %>
                                </span>
                                <% }else if(publisher){ %>
                                    <a href="/publisher/<%= publisher.id %>"
                                        class="spec-value text-decoration-none author-link">
                                        <%= publisher.name %>
                                    </a>
                                    <% } else { %>
                                        <span class="spec-value">-</span>
                                        <% } %>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="spec-card">
                            <span class="spec-label"><i class="bi bi-calendar3 me-1"></i>
                                <%= t('book.release') %>
                            </span>
                            <span class="spec-value">
                                <%= book.releashed_year || '-' %>
                            </span>
                        </div>
                    </div>
                    <div class="col-4 col-md-4">
                        <div class="spec-card">
                            <span class="spec-label"><i class="bi bi-layout-text-window me-1"></i>
                                <%= t('book.format') %>
                            </span>
                            <span class="spec-value">
                                <%= book.format %>
                            </span>
                        </div>
                    </div>
                    <div class="col-4 col-md-4">
                        <div class="spec-card">
                            <span class="spec-label"><i class="bi bi-globe me-1"></i>
                                <%= t('book.language') %>
                            </span>
                            <span class="spec-value">
                                <%= book.language %>
                            </span>
                        </div>
                    </div>
                    <div class="col-4 col-md-4">
                        <div class="spec-card">
                            <span class="spec-label"><i class="bi bi-file-earmark-text-fill me-1"></i>
                                <%= t('book.pages') %>
                            </span>
                            <span class="spec-value">
                                <%= book.pages %>
                            </span>
                        </div>
                    </div>
                </div>

                <hr class="my-5 border-0"
                    style="height: 2px; background: linear-gradient(90deg, transparent, rgba(30,64,175,0.2), transparent);">

                <!-- SECCIÓN RESEÑAS -->
                <div class="row g-5">
                    <div class="col-md-5">
                        <div class="card border-0 shadow-sm p-4 rounded-4"
                            style="background: rgba(255,255,255,0.85); backdrop-filter: blur(10px);">
                            <h4 class="fw-bold mb-4 fs-5" style="color: var(--brand-teal);">
                                <i class="bi bi-chat-quote-fill me-2 text-warning"></i>Escribir Reseña
                            </h4>
                            <% if(user) { %>
                                <form action="/review/create" method="POST">
                                    <input type="hidden" name="book_id" value="<%= book.id %>">
                                    <div class="mb-3">
                                        <label
                                            class="form-label fw-bold small text-muted text-uppercase">Valoración</label>
                                        <select name="rating"
                                            class="form-select border-0 shadow-sm py-2 fw-bold text-warning"
                                            style="background-color: white;">
                                            <option value="5">⭐⭐⭐⭐⭐ (5)</option>
                                            <option value="4">⭐⭐⭐⭐ (4)</option>
                                            <option value="3">⭐⭐⭐ (3)</option>
                                            <option value="2">⭐⭐ (2)</option>
                                            <option value="1">⭐ (1)</option>
                                        </select>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label fw-bold small text-muted text-uppercase">Tu
                                            opinión</label>
                                        <textarea name="comment" class="form-control border-0 shadow-sm p-3" rows="4"
                                            placeholder="¿Qué te pareció este libro?" required
                                            style="background-color: white;"></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-purchase w-100 py-3 shadow-sm">
                                        Enviar Reseña <i class="bi bi-send-fill ms-1"></i>
                                    </button>
                                </form>
                                <% } else { %>
                                    <div class="text-center py-4">
                                        <i class="bi bi-person-lock fs-1 text-muted opacity-50 mb-3 d-block"></i>
                                        <p class="text-muted fw-medium mb-4">Inicia sesión para dejar una reseña.</p>
                                        <a href="/login"
                                            class="btn btn-outline-primary btn-sm rounded-pill px-4 fw-bold">Iniciar
                                            Sesión</a>
                                    </div>
                                    <% } %>
                        </div>
                    </div>

                    <div class="col-md-7">
                        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                            <h3 class="fw-bold m-0" style="color: var(--brand-teal);">
                                Comunidad
                            </h3>
                            <span class="badge rounded-pill px-3 py-2 fs-6"
                                style="background-color: var(--brand-gold); color: #1e3a8a;">
                                <%= reviews.length %> Reseñas
                            </span>
                        </div>

                        <div class="reviews-list">
                            <% if (reviews && reviews.length> 0) { %>
                                <% reviews.forEach(review=> { %>
                                    <div class="card border-0 mb-4 rounded-4 p-4 review-card">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-muted fw-bold shadow-sm"
                                                    style="width: 40px; height: 40px; border: 1px solid rgba(0,0,0,0.05);">
                                                    <%= review.user_email.charAt(0).toUpperCase() %>
                                                </div>
                                                <div>
                                                    <h6 class="fw-bold m-0 text-dark">
                                                        <%= review.user_email.split('@')[0] %>
                                                    </h6>
                                                    <div class="text-warning small mt-1">
                                                        <% for(let i=0; i<5; i++) { %>
                                                            <i
                                                                class="bi bi-star-fill <%= i < review.rating ? '' : 'text-muted opacity-25' %>"></i>
                                                            <% } %>
                                                    </div>
                                                </div>
                                            </div>

                                            <% if (user && user.email===review.user_email) { %>
                                                <div class="dropdown">
                                                    <button class="btn btn-sm btn-light rounded-circle" type="button"
                                                        data-bs-toggle="dropdown">
                                                        <i class="bi bi-three-dots-vertical"></i>
                                                    </button>
                                                    <ul
                                                        class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                                        <li><button class="dropdown-item small"
                                                                onclick="toggleEditReview('<%= review.id %>')"><i
                                                                    class="bi bi-pencil-square me-2 text-primary"></i>Editar</button>
                                                        </li>
                                                        <li>
                                                            <hr class="dropdown-divider">
                                                        </li>
                                                        <li>
                                                            <form action="/review/delete/<%= review.id %>"
                                                                method="POST">
                                                                <input type="hidden" name="book_id"
                                                                    value="<%= book.id %>">
                                                                <button type="submit"
                                                                    class="dropdown-item small text-danger"
                                                                    onclick="return confirm('¿Seguro que quieres borrar la reseña?')"><i
                                                                        class="bi bi-trash me-2"></i>Eliminar</button>
                                                            </form>
                                                        </li>
                                                    </ul>
                                                </div>
                                                <% } %>
                                        </div>

                                        <div id="review-display-<%= review.id %>" class="mt-3">
                                            <p class="mb-0 text-secondary fs-6" style="line-height: 1.6;">"<%=
                                                    review.comment %>"</p>
                                        </div>

                                        <div id="review-edit-form-<%= review.id %>" style="display: none;"
                                            class="mt-4 bg-light p-3 rounded-3 border">
                                            <form action="/review/update/<%= review.id %>" method="POST">
                                                <input type="hidden" name="book_id" value="<%= book.id %>">
                                                <label class="small fw-bold text-muted mb-1">Editar valoración</label>
                                                <select name="rating" class="form-select border-0 shadow-sm py-2 mb-3">
                                                    <option value="5" <%=review.rating===5 ? 'selected' : '' %>>⭐⭐⭐⭐⭐
                                                    </option>
                                                    <option value="4" <%=review.rating===4 ? 'selected' : '' %>>⭐⭐⭐⭐
                                                    </option>
                                                    <option value="3" <%=review.rating===3 ? 'selected' : '' %>>⭐⭐⭐
                                                    </option>
                                                    <option value="2" <%=review.rating===2 ? 'selected' : '' %>>⭐⭐
                                                    </option>
                                                    <option value="1" <%=review.rating===1 ? 'selected' : '' %>>⭐
                                                    </option>
                                                </select>
                                                <label class="small fw-bold text-muted mb-1">Editar comentario</label>
                                                <textarea name="comment" class="form-control border-0 shadow-sm mb-3"
                                                    rows="3" required><%= review.comment %></textarea>
                                                <div class="d-flex gap-2 justify-content-end">
                                                    <button type="button"
                                                        class="btn btn-light btn-sm rounded-pill px-4 fw-bold"
                                                        onclick="toggleEditReview('<%= review.id %>')">Cancelar</button>
                                                    <button type="submit"
                                                        class="btn btn-purchase btn-sm rounded-pill px-4">Guardar</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="text-center py-5">
                                                <i
                                                    class="bi bi-stars text-warning display-4 mb-3 d-block opacity-50"></i>
                                                <h5 class="fw-bold text-muted">Sé el primero en opinar</h5>
                                                <p class="text-muted small">Ayuda a otros lectores compartiendo lo que
                                                    piensas sobre este libro.</p>
                                            </div>
                                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- ADMIN PANEL -->
                <% if(user && user.role==="ADMIN" ) { %>
                    <div class="mt-5 p-4 rounded-4 shadow-lg position-relative overflow-hidden"
                        style="background: linear-gradient(135deg, var(--brand-teal), #1e3a8a); border-top: 6px solid var(--brand-gold);">
                        <div class="position-absolute top-0 end-0 opacity-10" style="transform: translate(20%, -20%);">
                            <i class="bi bi-shield-check" style="font-size: 15rem;"></i>
                        </div>
                        <div
                            class="d-flex flex-column flex-md-row align-items-center justify-content-between position-relative z-index-1">
                            <div class="text-white mb-4 mb-md-0 text-center text-md-start">
                                <h5 class="fw-bold m-0 fs-4"><i
                                        class="bi bi-gear-fill me-2 text-warning"></i>Administración</h5>
                                <p class="small text-white-50 m-0 mt-1">Este panel solo es visible porque eres
                                    administrador.</p>
                            </div>
                            <div class="d-flex gap-3">
                                <a href="/admin/books/update/<%= book.id %>"
                                    class="btn bg-white rounded-pill px-4 py-2 shadow-sm d-flex align-items-center gap-2"
                                    style="color: var(--brand-teal); font-weight: 700;">
                                    <i class="bi bi-pencil-square"></i>Editar Ficha
                                </a>
                                <form action="/admin/books/delete/<%= book.id %>" method="POST" class="m-0"
                                    data-requires-token>
                                    <button type="submit"
                                        class="btn btn-outline-light rounded-pill px-4 py-2 fw-bold d-flex align-items-center gap-2"
                                        onclick="return confirm('¿Seguro crítico que quieres borrar el libro entero?')">
                                        <i class="bi bi-trash3"></i>Borrar
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <% } %>

            </div>
        </div>
    </div>

    <%- include('../layout/footer') %>

        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="/js/viewsFunctions.mjs"></script>
