<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= book.title || t('book.details_title') %> - <%= t('book.details_title') %>
    </title>
    <link rel="stylesheet" href="/css/libro_detalle.css">
</head>

<body>

    <%- include("../layout/header") %>
        <div class="container">
            <h1>
                <%= book.title || t('book.no_synopsis') %>
            </h1>

            <div class="book-details-wrapper">
                <div class="book-cover-column">
                    <img src="<%= book.cover_url || '/images/default-cover.jpg' %>" alt="<%= book.title %>">
                </div>

                <div class="book-info-column">
                    <p><strong>
                            <%= t('book.author') %>:
                        </strong>
                        <% authors.forEach(author=> { %>
                            <a href="/author/<%= author.id %>" class="text-decoration-none">
                                <%= author.name %>
                            </a>
                            <% }) %>
                    </p>

                    <p><strong>
                            <%= t('book.synopsis') %>:
                        </strong>
                        <%= book.synopsis || t('book.no_synopsis') %>
                    </p>

                    <p><strong>
                            <%= t('book.isbn') %>:
                        </strong>
                        <%= book.isbn %>
                    </p>

                    <p><strong>
                            <%= t('book.publisher') %>:
                        </strong>
                        <a href="/publisher/<%= publisher.id %>">
                            <%= publisher.name %>
                        </a>
                    </p>

                    <p><strong>
                            <%= t('book.release') %>:
                        </strong>
                        <%= book.releashed_year %>
                    </p>

                    <p><strong>
                            <%= t('book.format') %>:
                        </strong>
                        <%= book.format %>
                    </p>

                    <p><strong>
                            <%= t('book.language') %>:
                        </strong>
                        <%= book.language %>
                    </p>

                    <p><strong>
                            <%= t('book.pages') %>:
                        </strong>
                        <%= book.pages %>
                    </p>

                    <p><strong>
                            <%= t('book.genres') %>:
                        </strong>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <% genres.forEach(genre=> { %>
                            <span class="badge bg-primary fs-6 px-3 py-2">
                                <%= genre.genre.name %>
                                    <a href="/genres/<%= genre.genre.name %>" class="text-white ms-2"
                                        style="font-size: 0.8rem;">
                                        (<%= t('book.view') %>)
                                    </a>
                            </span>
                            <% }) %>
                    </div>
                    </p>

                    <h3 class="text-success mb-3">
                        <%= book.price %>€
                    </h3>

                    <div class="cart-section">
                        <form action="/cart/add" method="POST" class="row g-3 align-items-center">
                            <input type="hidden" name="book_id" value="<%= book.id %>">
                            <div class="col-auto">
                                <label class="form-label mb-0">
                                    <%= t('book.quantity') %>:
                                </label>
                                <input type="number" name="quantity" value="1" min="1" max="<%= book.stock %>"
                                    class="form-control" style="width: 80px;">
                            </div>
                            <div class="col-auto mt-4">
                                <button type="submit" class="btn btn-success" <%=book.stock <=0 ? 'disabled' : '' %>>
                                    <%= t('book.add_to_cart') %> 🛒
                                </button>
                            </div>
                        </form>
                    </div>

                    <% if(user && user.role==="ADMIN" ) { %>
                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <a href="/authors/author/edit/<%= author.id %>" class="btn btn-warning rounded-pill px-4">
                                <%= t('author_detail.edit_author') %>
                            </a>

                            <%# Guardamos la traducción en una variable para evitar conflictos de comillas %>
                                <% const confirmMsg=t('admin.confirm'); %>

                                    <form action="/authors/author/delete/<%= author.id %>" method="POST"
                                        class="d-inline">
                                        <input type="hidden" name="id" value="<%= author.id %>">
                                        <button type="submit" class="btn btn-danger rounded-pill px-4"
                                            onclick="return confirm('<%= confirmMsg %>')">
                                            <%= t('author_detail.delete_author') %>
                                        </button>
                                    </form>
                        </div>
                        <% } else { %>
                            <div class="mt-4 text-center">
                                <a href="/" class="text-decoration-none">
                                    <%= t('author_detail.back') %>
                                </a>
                            </div>
                            <% } %>

                                <div class="mt-4">
                                    <a href="/" class="back-link-nav text-decoration-none">
                                        <%= t('book.back') %>
                                    </a>
                                </div>
                </div>
            </div>
        </div>

        <%- include('../layout/footer') %>
</body>

</html>