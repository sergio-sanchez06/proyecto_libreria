<%- include('../layout/header', { title: genreData.name + ' - ' + t('genres.title'), bodyClass: 'bg-main-vistas' ,
    extraCSS: 'partials/genre_detalle' }) %>

    <div class="container py-5">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb" style="font-weight: 500;">
                <li class="breadcrumb-item"><a href="/genres" class="text-decoration-none text-muted">
                        <%= t('genres.title') %>
                    </a></li>
                <li class="breadcrumb-item active" style="color: var(--brand-teal);">
                    <%= t('genre_results.title') + " " + genreData.name %>
                </li>
            </ol>
        </nav>

        <div
            class="genre-hero p-4 p-md-5 mb-5 d-flex flex-column flex-md-row justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-4 mb-4 mb-md-0">
                <div class="genre-icon-container">
                    <i class="bi bi-bookmark-star-fill"></i>
                </div>
                <div>
                    <p class="text-uppercase fw-bold m-0"
                        style="color: var(--brand-gold); letter-spacing: 1px; font-size: 0.85rem;">
                        <%= t('genres.category') %>
                    </p>
                    <h1 class="display-5 fw-bold m-0" style="color: var(--brand-teal); letter-spacing: -1px;">
                        <%= genreData.name %>
                    </h1>
                </div>
            </div>
            <a href="/genres"
                class="btn btn-outline-dark rounded-pill px-4 py-2 fw-medium shadow-sm d-flex align-items-center gap-2">
                <i class="bi bi-arrow-left"></i>
                <%= t('genres.back') %>
            </a>
        </div>

        <% if(bookGenre.length===0) { %>
            <div class="text-center py-5 bg-white rounded-4 border border-light shadow-sm">
                <i class="bi bi-journals display-1 text-muted opacity-25 mb-4 d-block"></i>
                <h3 class="fw-bold text-dark mb-3">
                    <%= t('genres.no_books') %>
                </h3>
                <p class="text-muted fs-5">
                    <%= t('genres.no_books') %>
                </p>
            </div>
            <% } else { %>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold m-0" style="color: var(--brand-teal);">
                        <%= t('genres.books_available') %>
                    </h4>
                    <span class="badge rounded-pill px-3 py-2 fs-6"
                        style="background-color: var(--brand-gold); color: #1e3a8a;">
                        <%= bookGenre.length %> Títulos
                    </span>
                </div>

                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
                    <% bookGenre.forEach(item=> { %>
                        <div class="col">
                            <div class="book-card h-100 d-flex flex-column p-2">
                                <div class="book-img-container">
                                    <img src="<%= item.book.cover_url || '/images/default-cover.jpg' %>"
                                        alt="<%= item.book.title %>">
                                </div>
                                <div class="card-body d-flex flex-column flex-grow-1 px-2 pb-2 pt-3 text-center">
                                    <span class="badge mx-auto mb-2"
                                        style="background-color: rgba(30, 64, 175, 0.1); color: var(--brand-teal); border: 1px solid rgba(30, 64, 175, 0.2);">
                                        <%= item.genre.name %>
                                    </span>
                                    <h5 class="fw-bold mb-2 text-dark" style="font-size: 1.05rem; min-height: 2.5rem;">
                                        <%= item.book.title %>
                                    </h5>
                                    <p class="book-synopsis mb-4 text-start">
                                        <%= item.book.synopsis || 'Sin sinopsis disponible.' %>
                                    </p>
                                    <a href="/books/book/<%= item.book.id %>"
                                        class="btn btn-outline-primary btn-sm w-100 rounded-pill mt-auto fw-bold py-2 shadow-sm"
                                        style="border-radius: 12px !important; border-color: var(--brand-teal); color: var(--brand-teal);">
                                        <%= t('genre_results.view_details') %> <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% } %>

                    <!-- ADMIN PANEL -->
                    <% if(user && user.role==="ADMIN" ) { %>
                        <div class="mt-5 p-4 rounded-4 shadow-lg position-relative overflow-hidden"
                            style="background: linear-gradient(135deg, var(--brand-teal), #1e3a8a); border-top: 6px solid var(--brand-gold);">
                            <div class="position-absolute top-0 end-0 opacity-10"
                                style="transform: translate(20%, -20%);">
                                <i class="bi bi-shield-check" style="font-size: 15rem;"></i>
                            </div>
                            <div
                                class="d-flex flex-column flex-md-row align-items-center justify-content-between position-relative z-index-1">
                                <div class="text-white mb-4 mb-md-0 text-center text-md-start">
                                    <h5 class="fw-bold m-0 fs-4"><i
                                            class="bi bi-gear-fill me-2 text-warning"></i><%= t('admin.panel') %></h5>
                                    <p class="small text-white-50 m-0 mt-1"><%= t('admin.panel_body') %></p>
                                </div>
                                <div class="d-flex gap-3">
                                    <a href="/genres/edit/<%= genreData.id %>"
                                        class="btn bg-white rounded-pill px-4 py-2 shadow-sm d-flex align-items-center gap-2"
                                        style="color: var(--brand-teal); font-weight: 700;">
                                        <i class="bi bi-pencil-square"></i>
                                        <%= t('genre_results.edit_genre') %>
                                    </a>
                                    <button type="button"
                                        class="btn btn-outline-light rounded-pill px-4 py-2 fw-bold d-flex align-items-center gap-2"
                                        data-bs-toggle="modal" data-bs-target="#modalDeleteGenre">
                                        <i class="bi bi-trash3"></i>
                                        <%= t('genre_results.delete_genre') %>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <% } %>

                            <% if (user && user.role==="ADMIN" ) { %>
                                <div class="modal fade" id="modalDeleteGenre" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow-lg rounded-4">
                                            <div class="modal-header border-0"
                                                style="background: linear-gradient(135deg, #dc2626, #991b1b);">
                                                <h5 class="modal-title fw-bold text-white">
                                                    <i class="bi bi-trash3-fill me-2"></i><%= t('admin.delete_genre')
                                                        %>
                                                </h5>
                                                <button type="button" class="btn-close btn-close-white"
                                                    data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body p-4 text-center">
                                                <div class="mb-3">
                                                    <i class="bi bi-exclamation-triangle-fill text-danger"
                                                        style="font-size: 3rem;"></i>
                                                </div>
                                                <h6 class="fw-bold text-dark mb-2">
                                                    <%= t('admin.delete_genre') %> "<%= genreData.name %>"?
                                                </h6>
                                                <p class="text-muted small mb-0">
                                                    <%= t('admin.delete_genre_message') %>
                                                </p>
                                            </div>
                                            <div class="modal-footer border-0 justify-content-center pb-4 gap-3">
                                                <button type="button" class="btn btn-light rounded-pill px-4 fw-bold"
                                                    data-bs-dismiss="modal">
                                                    <i class="bi bi-x-lg me-1"></i><%= t('admin.cancel') %>
                                                </button>
                                                <form action="/genres/delete/<%= genreData.id %>" method="post"
                                                    data-requires-token class="m-0">
                                                    <button type="submit"
                                                        class="btn btn-danger rounded-pill px-4 fw-bold">
                                                        <i class="bi bi-trash3 me-1"></i><%= t('admin.delete_genre') %>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% } %>

    </div>

    <%- include('../layout/footer') %>