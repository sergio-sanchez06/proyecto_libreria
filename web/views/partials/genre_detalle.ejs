<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= genreData.name %> - <%= t('genres.title') %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .book-cover {
            max-width: 100%;
            height: auto;
            border-radius: 4px;
        }

        .book-card {
            background: white;
            border-radius: 8px;
            overflow: hidden;
            height: 100%;
            display: flex;
            flex-direction: column;
            padding: 1rem;
        }

        .book-synopsis {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            font-size: 0.85rem;
            color: #6c757d;
        }
    </style>
</head>

<body>
    <%- include('../layout/header') %>

        <div class="container my-5">
            <% if(bookGenre.length===0) { %>
                <div class="alert alert-warning text-center">
                    <%= t('genre_results.no_books') %>
                </div>
                <div class="text-center">
                    <a href="/genres" class="btn btn-primary rounded-pill">
                        <%= t('genre_results.back') %>
                    </a>
                </div>
                <% } else { %>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h1>
                            <%= t('genre_results.title') %> <span class="text-primary">
                                    <%= genreData.name %>
                                </span>
                        </h1>
                        <a href="/genres" class="btn btn-outline-secondary rounded-pill">
                            <i class="bi bi-arrow-left"></i>
                            <%= t('genre_results.back') %>
                        </a>
                    </div>

                    <div class="row g-4">
                        <% bookGenre.forEach(item=> { %>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                                <div class="book-card shadow-sm d-flex flex-column">
                                    <div class="text-center mb-3">
                                        <img src="<%= item.book.cover_url || '/images/default-cover.jpg' %>"
                                            class="book-cover" alt="<%= item.book.title %>"
                                            style="height: 200px; object-fit: cover;">
                                    </div>
                                    <div class="book-body d-flex flex-column flex-grow-1">
                                        <h5 class="fw-bold mb-1" style="font-size: 1rem;">
                                            <%= item.book.title %>
                                        </h5>
                                        <span class="badge bg-light text-dark mb-2 align-self-start border">
                                            <%= item.genre.name %>
                                        </span>
                                        <p class="book-synopsis mb-3">
                                            <%= item.book.synopsis %>
                                        </p>
                                        <a href="/books/book/<%= item.book.id %>"
                                            class="btn btn-sm btn-primary w-100 rounded-pill mt-auto">
                                            <%= t('genre_results.view_details') %>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                    <% } %>

                        <% if(user && user.role==="ADMIN" ) { %>
                            <div
                                class="admin-actions mt-5 d-flex align-items-center gap-3 p-3 bg-white rounded shadow-sm border">
                                <span class="fw-bold text-danger"><i class="bi bi-shield-lock-fill"></i>
                                    <%= t('genre_results.admin_panel') %>
                                </span>
                                <a href="/genres/edit/<%= genreData.id %>" class="btn btn-warning btn-sm">
                                    <i class="bi bi-pencil-square"></i>
                                    <%= t('genre_results.edit_genre') %>
                                </a>

                                <% const confirmMsg=t('admin.confirm'); %>
                                    <form action="/genres/delete/<%= genreData.id %>" method="post" class="m-0">
                                        <input type="hidden" name="id" value="<%= genreData.id %>">
                                        <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('<%= confirmMsg %>')">
                                            <i class="bi bi-trash"></i>
                                            <%= t('genre_results.delete_genre') %>
                                        </button>
                                    </form>
                            </div>
                            <% } %>
        </div>

        <%- include('../layout/footer') %>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>