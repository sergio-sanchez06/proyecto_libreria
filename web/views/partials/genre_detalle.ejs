<%- include('../layout/header', { 
    title: genreData.name + ' - ' + t('genres.title'),
    bodyClass: 'bg-main-vistas'
}) %>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

    body {
        font-family: 'Inter', sans-serif;
        color: var(--text-dark);
    }

    body::before {
        content: "";
        position: fixed;
        top: 0; left: 0; width: 100vw; height: 100vh;
        background: rgba(252, 250, 247, 0.45);
        z-index: -1;
    }

    .genre-hero {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.6);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        position: relative;
        overflow: hidden;
    }

    .genre-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 10px;
        height: 100%;
        background: linear-gradient(180deg, var(--brand-teal), var(--brand-gold));
    }

    .genre-icon-container {
        width: 80px;
        height: 80px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: var(--brand-teal);
        box-shadow: 0 8px 20px rgba(30, 64, 175, 0.1);
        border: 3px solid rgba(30, 64, 175, 0.05);
    }

    /* Estilo de los libros */
    .book-card {
        border: none;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(8px);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid rgba(255,255,255,0.4);
    }

    .book-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(30, 64, 175, 0.1);
        border-color: rgba(30, 64, 175, 0.2);
    }

    .book-img-container {
        height: 220px;
        background: rgba(245, 247, 250, 0.5);
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        padding: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .book-img-container img {
        filter: drop-shadow(0 10px 15px rgba(0,0,0,0.15));
        transition: transform 0.3s ease;
        max-height: 100%;
        object-fit: contain;
    }
    
    .book-card:hover .book-img-container img {
        transform: scale(1.05);
    }

    .book-synopsis {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 0.9rem;
        color: #64748b;
        line-height: 1.6;
    }
</style>

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb" style="font-weight: 500;">
            <li class="breadcrumb-item"><a href="/genres" class="text-decoration-none text-muted"><%= t('genres.title') %></a></li>
            <li class="breadcrumb-item active" style="color: var(--brand-teal);"><%= t('genre_results.title') %></li>
        </ol>
    </nav>

    <div class="genre-hero p-4 p-md-5 mb-5 d-flex flex-column flex-md-row justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-4 mb-4 mb-md-0">
            <div class="genre-icon-container">
                <i class="bi bi-bookmark-star-fill"></i>
            </div>
            <div>
                <p class="text-uppercase fw-bold m-0" style="color: var(--brand-gold); letter-spacing: 1px; font-size: 0.85rem;">Categoría</p>
                <h1 class="display-5 fw-bold m-0" style="color: var(--brand-teal); letter-spacing: -1px;">
                    <%= genreData.name %>
                </h1>
            </div>
        </div>
        <a href="/genres" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-medium shadow-sm d-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i> <%= t('genre_results.back') %>
        </a>
    </div>

    <% if(bookGenre.length === 0) { %>
        <div class="text-center py-5 bg-white rounded-4 border border-light shadow-sm">
            <i class="bi bi-journals display-1 text-muted opacity-25 mb-4 d-block"></i>
            <h3 class="fw-bold text-dark mb-3"><%= t('genre_results.no_books') %></h3>
            <p class="text-muted fs-5">Actualmente no disponemos de títulos en esta categoría.</p>
        </div>
    <% } else { %>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold m-0" style="color: var(--brand-teal);">
                Libros Disponibles
            </h4>
            <span class="badge rounded-pill px-3 py-2 fs-6" style="background-color: var(--brand-gold); color: #1e3a8a;">
                <%= bookGenre.length %> Títulos
            </span>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
            <% bookGenre.forEach(item=> { %>
                <div class="col">
                    <div class="book-card h-100 d-flex flex-column p-2">
                        <div class="book-img-container">
                            <img src="<%= item.book.cover_url || '/images/default-cover.jpg' %>" alt="<%= item.book.title %>">
                        </div>
                        <div class="card-body d-flex flex-column flex-grow-1 px-2 pb-2 pt-3 text-center">
                            <span class="badge mx-auto mb-2" style="background-color: rgba(30, 64, 175, 0.1); color: var(--brand-teal); border: 1px solid rgba(30, 64, 175, 0.2);">
                                <%= item.genre.name %>
                            </span>
                            <h5 class="fw-bold mb-2 text-dark" style="font-size: 1.05rem; min-height: 2.5rem;">
                                <%= item.book.title %>
                            </h5>
                            <p class="book-synopsis mb-4 text-start">
                                <%= item.book.synopsis || 'Sin sinopsis disponible.' %>
                            </p>
                            <a href="/books/book/<%= item.book.id %>" class="btn btn-outline-primary btn-sm w-100 rounded-pill mt-auto fw-bold py-2 shadow-sm" style="border-radius: 12px !important; border-color: var(--brand-teal); color: var(--brand-teal);">
                                <%= t('genre_results.view_details') %> <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>

    <!-- ADMIN PANEL -->
    <% if(user && user.role==="ADMIN" ) { %>
        <div class="mt-5 p-4 rounded-4 shadow-lg position-relative overflow-hidden"
            style="background: linear-gradient(135deg, var(--brand-teal), #1e3a8a); border-top: 6px solid var(--brand-gold);">
            <div class="position-absolute top-0 end-0 opacity-10" style="transform: translate(20%, -20%);">
                <i class="bi bi-shield-check" style="font-size: 15rem;"></i>
            </div>
            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between position-relative z-index-1">
                <div class="text-white mb-4 mb-md-0 text-center text-md-start">
                    <h5 class="fw-bold m-0 fs-4"><i class="bi bi-gear-fill me-2 text-warning"></i>Administración</h5>
                    <p class="small text-white-50 m-0 mt-1">Este panel solo es visible porque eres administrador.</p>
                </div>
                <div class="d-flex gap-3">
                    <a href="/genres/edit/<%= genreData.id %>" class="btn bg-white rounded-pill px-4 py-2 shadow-sm d-flex align-items-center gap-2" style="color: var(--brand-teal); font-weight: 700;">
                        <i class="bi bi-pencil-square"></i><%= t('genre_results.edit_genre') %>
                    </a>
                    <% const confirmMsg=t('admin.confirm'); %>
                    <form action="/genres/delete/<%= genreData.id %>" method="post" class="m-0">
                        <input type="hidden" name="id" value="<%= genreData.id %>">
                        <button type="submit" class="btn btn-outline-light rounded-pill px-4 py-2 fw-bold d-flex align-items-center gap-2" onclick="return confirm('<%= confirmMsg %>')">
                            <i class="bi bi-trash3"></i><%= t('genre_results.delete_genre') %>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    <% } %>
</div>

<%- include('../layout/footer') %>