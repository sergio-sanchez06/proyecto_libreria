<%- include('../layout/header') %>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    body {
        background-image: url('/images/book_drawing_pattern.png'); 
        background-repeat: repeat;
        background-size: 500px;
        background-position: center top;
        background-attachment: fixed; 
        background-color: #fcfaf7;
        font-family: 'Inter', sans-serif;
        color: #333;
    }

    body::before {
        content: "";
        position: fixed;
        top: 0; left: 0; width: 100vw; height: 100vh;
        background: rgba(252, 250, 247, 0.85); 
        z-index: -1;
    }
    
    .section-title {
        font-weight: 800;
        color: var(--brand-teal);
        position: relative;
        padding-bottom: 12px;
        margin-bottom: 2rem;
        letter-spacing: -0.5px;
    }
    
    .section-title::after {
        content: '';
        width: 80px;
        height: 4px;
        background: var(--brand-gold);
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        border-radius: 2px;
    }

    .carousel-control-prev,
    .carousel-control-next {
        width: 5%;
        z-index: 10;
        pointer-events: none;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: var(--brand-teal);
        border-radius: 50%;
        padding: 15px;
        background-size: 60%;
        pointer-events: auto;
        transition: all 0.3s ease;
    }
    
    .carousel-control-prev-icon:hover,
    .carousel-control-next-icon:hover {
        background-color: var(--brand-gold);
        transform: scale(1.1);
    }
    
    .card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(5px);
    }
    
    .card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
    }
    
    .card-img-top {
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
        object-fit: cover;
    }
    
    .btn-primary {
        background-color: #2c3e50;
        border-color: #2c3e50;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    
    .btn-primary:hover {
        background-color: #1a252f;
        border-color: #1a252f;
        box-shadow: 0 4px 12px rgba(44, 62, 80, 0.3);
        transform: translateY(-2px);
    }
    
    .btn-success {
        background-color: #208b5e;
        border-color: #208b5e;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    
    .btn-success:hover {
        background-color: #166845;
        box-shadow: 0 4px 12px rgba(32, 139, 94, 0.3);
        transform: translateY(-2px);
    }
    
    .badge {
        font-weight: 500;
        letter-spacing: 0.3px;
    }
    
    .bg-danger {
        background-color: #e74c3c !important;
    }
    
    .bg-info {
        background-color: #d4af37 !important;
        color: #fff !important;
    }

    .publisher-logo-container {
        width: 120px;
        height: 120px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #fff;
        border-radius: 50%;
        padding: 15px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        transition: transform 0.4s ease;
    }
    
    .publisher-logo-container:hover {
        transform: rotate(5deg) scale(1.05);
    }

    .publisher-logo-container img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }
    
    .list-group-item {
        border: none;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        background: transparent;
        padding: 1rem 1.25rem;
        transition: all 0.2s ease;
        position: relative;
    }
    
    .list-group-item:last-child {
        border-bottom: none;
    }
    
    .list-group-item:hover {
        background: linear-gradient(90deg, rgba(194, 151, 59, 0.1) 0%, transparent 100%);
        padding-left: 1.75rem;
    }
    
    .list-group-item::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        height: 100%;
        width: 4px;
        background-color: var(--brand-gold);
        transform: scaleY(0);
        transition: transform 0.3s ease;
        transform-origin: bottom;
    }
    
    .list-group-item:hover::before {
        transform: scaleY(1);
    }
    
    .bg-white.shadow-sm {
        background: rgba(255, 255, 255, 0.7) !important;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.4);
    }
</style>

<div class="container py-5">
    <header class="mb-5">
        <p class="lead mt-3">
            <%= t('es:index.welcome_msg') %>
        </p>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <% genresMostSold.forEach(genre=> { %>
                <span class="badge rounded-pill bg-light text-dark border p-2">
                    <i class="bi bi-tag-fill text-primary"></i>
                    <a href="/genres/<%= genre.name %>" class="text-decoration-none">
                        <%= genre.name %>
                    </a>
                    <span class="ms-1 fw-bold text-primary">
                        <%= genre.totalSold %>
                    </span>
                </span>
                <% }) %>
        </div>
    </header>

    <section class="mb-5 bg-white p-4 rounded shadow-sm">
        <h2 class="section-title text-center mb-4">
            <i class="bi bi-graph-up-arrow text-danger"></i>
            <%= t('es:index.most_sold_books') %>
        </h2>
        <div class="row row-cols-1 row-cols-md-5 g-3">
            <% booksMostSold.forEach((book, index)=> { %>
                <div class="col">
                    <div class="card h-100 border-0 text-center">
                        <div class="position-absolute top-0 start-0 badge bg-danger m-2">#<%= index + 1 %>
                        </div>
                        <img src="<%= book.cover_url || '/images/default-cover.jpg' %>"
                            class="card-img-top rounded mx-auto" style="height: 150px; width: fit-content;"
                            alt="<%= book.title %>">
                        <div class="card-body p-2">
                            <p class="small fw-bold mb-0 text-truncate">
                                <a href="/books/book/<%= book.id %>" class="text-decoration-none">
                                    <%= book.title %>
                                </a>
                            </p>
                            <span class="badge bg-light text-muted border text-dark">
                                <%= t('es:index.sold_units', { count: book.totalSold }) %>
                            </span>
                        </div>
                    </div>
                </div>
                <% }) %>
        </div>
    </section>

    <section class="mb-5">
        <h2 class="section-title text-center">
            <%= t('es:index.featured_books') %>
        </h2>

        <% if (books && books.length> 0) { %>
            <div id="booksCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    <% const booksPerSlide=4; for (let i=0; i < books.length; i +=booksPerSlide) { const
                        group=books.slice(i, i + booksPerSlide); const isActive=i===0 ? "active" : "" ; %>
                        <div class="carousel-item <%= isActive %>">
                            <div class="row justify-content-center">
                                <% group.forEach(book=> { %>
                                    <div class="col-md-3 mb-4">
                                        <div class="card h-100 shadow-sm book-card">
                                            <img src="<%= book.cover_url || '/images/default-cover.jpg' %>"
                                                class="card-img-top" alt="<%= book.title %>">
                                            <div class="card-body d-flex flex-column">
                                                <h5 class="card-title text-truncate">
                                                    <%= book.title %>
                                                </h5>
                                                <p class="card-text text-muted small">
                                                    <strong>
                                                        <%= t('es:book.author') %>:
                                                    </strong>
                                                    <% const relations=bookAuthors.filter(ba=>
                                                        Number(ba.book_id) === Number(book.id));
                                                        if (relations.length > 0) {
                                                        relations.forEach((ba, idx) => { %>
                                                        <a href="/author/<%= ba.author_id %>"
                                                            class="text-decoration-none">
                                                            <%= ba.author ? ba.author.name :
                                                                t('es:index.unknown_country') %>
                                                        </a>
                                                        <%= idx < relations.length - 1 ? ', ' : '' %>
                                                            <% }); } else { %>
                                                                <%= t('es:index.unknown_country') %>
                                                                    <% } %>
                                                </p>
                                                <p class="card-text fw-bold text-primary mt-auto">
                                                    <%= book.price %>€
                                                </p>

                                                <a href="/books/book/<%= book.id %>"
                                                    class="btn btn-primary btn-sm mt-2">
                                                    <%= t('es:index.view_details') %>
                                                </a>

                                                <form action="/cart/add" method="POST" class="mt-2">
                                                    <input type="hidden" name="book_id" value="<%= book.id %>">
                                                    <div class="d-flex flex-column gap-1 text-start">
                                                        <label class="small">
                                                            <%= t('es:book.quantity') %>:
                                                        </label>
                                                        <div class="input-group input-group-sm">
                                                            <input type="number" name="quantity" value="1"
                                                                min="1" max="<%= book.stock %>"
                                                                class="form-control" <%=book.stock <=0
                                                                ? 'disabled' : '' %>>
                                                            <button type="submit" class="btn btn-success"
                                                                <%=book.stock <=0 ? 'disabled' : '' %>>
                                                                <%= book.stock <=0 ? t('es:book.out_of_stock') :
                                                                    t('es:book.add_to_cart') %>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                    <% }) %>
                            </div>
                        </div>
                        <% } %>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#booksCarousel"
                    data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">
                        <%= t('es:common.back') %>
                    </span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#booksCarousel"
                    data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
            <% } else { %>
                <p class="text-center text-muted">
                    <%= t('es:index.no_featured') %>
                </p>
                <% } %>
    </section>

    <div class="row">
        <div class="col-md-8">
            <section class="mb-5">
                <h2 class="section-title text-center">
                    <%= t('es:index.featured_authors') %>
                </h2>
                <div class="row justify-content-center">
                    <% authors.slice().sort(() => 0.5 - Math.random()).slice(0, 3).forEach(author=> {
                        const countData = bookAuthorsCount.find(item => Number(item.author_id) ===
                        Number(author.id));
                        const totalLibros = countData ? Number(countData.count_books) : 0; %>
                        <div class="col-md-4 mb-4">
                            <div class="card author-card text-center shadow-sm">
                                <div class="card-body">
                                    <img src="<%= author.photo_url || '/images/default-author.jpg' %>"
                                        class="rounded-circle mb-2"
                                        style="width: 80px; height: 80px; object-fit: cover;">
                                    <h5 class="mt-3 small">
                                        <%= author.name %>
                                    </h5>
                                    <p class="text-muted small">
                                        <%= author.country || t('es:index.unknown_country') %>
                                    </p>
                                    <span class="badge bg-secondary">
                                        <%= t('es:index.books_count', { count: totalLibros }) %>
                                    </span>
                                    <a href="/author/<%= author.id %>" class="btn btn-primary btn-sm mt-2">
                                        <%= t('es:index.view_details') %>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                </div>
            </section>
        </div>

        <div class="col-md-4">
            <h3 class="h5 mb-3 text-center">
                <%= t('es:index.authors_ranking') %>
            </h3>
            <div class="list-group shadow-sm mb-5">
                <% authorsMostSold.forEach((author, index)=> { %>
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <span><strong>
                                <%= index + 1 %>.
                            </strong> <a href="/author/<%= author.id %>" class="text-decoration-none">
                                <%= author.name %>
                            </a></span>
                        <span class="badge bg-info text-dark rounded-pill">
                            <%= t('es:index.sold_units', { count: author.totalSold }) %>
                        </span>
                    </div>
                    <% }) %>
            </div>
        </div>
    </div>

    <section>
        <h2 class="section-title text-center">
            <%= t('es:index.featured_publishers') %>
        </h2>
        <div class="row mb-3 justify-content-center">
            <% publishersMostSold.forEach(pub=> { %>
                <div class="col-md-2 col-6 text-center mb-3">
                    <div class="p-2 border rounded bg-white shadow-sm">
                        <p class="small fw-bold mb-0 text-truncate">
                            <a href="/publisher/<%= pub.id %>">
                                <%= pub.name %>
                            </a>
                        </p>
                        <small class="text-success">
                            <%= t('es:index.sales', { count: pub.totalSold }) %>
                        </small>
                    </div>
                </div>
                <% }) %>
        </div>
        <% if (publishers && publishers.length> 0) { %>
            <div class="row justify-content-center">
                <% publishers.forEach(publisher=> { %>
                    <div class="col-md-3 mb-4">
                        <div class="card author-card text-center shadow-sm h-100">
                            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                                <div class="publisher-logo-container mb-3">
                                    <img src="<%= publisher.image_url || '/images/default-publisher.jpg' %>"
                                        alt="<%= publisher.name %>">
                                </div>
                                <h5 class="h6 fw-bold">
                                    <%= publisher.name %>
                                </h5>
                                <a href="/publisher/<%= publisher.id %>"
                                    class="btn btn-outline-primary btn-sm mt-auto">
                                    <%= t('es:index.view_details') %>
                                </a>
                            </div>
                        </div>
                    </div>
                    <% }) %>
            </div>
            <% } %>
    </section>
</div>

<%- include('../layout/footer') %>
tml>