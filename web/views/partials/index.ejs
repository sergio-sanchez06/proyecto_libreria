<%- include('../layout/header', { bodyClass: 'bg-main-vistas' , extraCSS: 'partials/index' }) %>

    <div class="container py-5">

        <!-- HEADER HERO BANNER -->
        <header class="hero-banner mb-5 text-center px-4">
            <h1 class="hero-title"><i class="bi bi-stars me-2 text-warning"></i>Bienvenido a BOOKLY</h1>
            <p class="lead mb-4 fw-light opacity-75 mx-auto" style="max-width: 700px;">
                <%= t('index.welcome_msg') || 'Explora nuestra colección de libros más recientes y autores destacados.'
                    %>
            </p>

            <div class="d-flex flex-wrap gap-2 justify-content-center hero-genres mt-2">
                <% genresMostSold.forEach(genre=> { %>
                    <span class="badge rounded-pill">
                        <i class="bi bi-tag-fill me-1 opacity-75"></i>
                        <a href="/genres/<%= genre.name %>" class="text-decoration-none">
                            <%= genre.name %>
                        </a>
                        <span class="ms-1 fw-bold opacity-100 ps-2"
                            style="border-left: 1px solid rgba(255,255,255,0.3);">
                            <%= genre.totalSold %> ventas
                        </span>
                    </span>
                    <% }) %>
            </div>
        </header>

        <!-- LIBROS MÁS VENDIDOS -->
        <section class="mb-5 pb-3">
            <h2 class="section-title text-center">
                <i class="bi bi-activity text-danger me-2"></i>
                <%= t('index.most_sold_books') %>
            </h2>

            <div class="row row-cols-2 row-cols-sm-2 row-cols-md-5 g-3 g-md-4 mt-2">
                <% booksMostSold.forEach((book, index)=> {
                    let medalClass = 'medal-other';
                    if (index === 0) medalClass = 'medal-1';
                    else if (index === 1) medalClass = 'medal-2';
                    else if (index === 2) medalClass = 'medal-3';
                    %>
                    <div class="col">
                        <div class="card h-100 text-center position-relative pt-4">
                            <div class="medal <%= medalClass %>">
                                <%= index + 1 %>
                            </div>

                            <div class="px-3">
                                <img src="<%= book.cover_url || '/images/default-cover.jpg' %>"
                                    class="card-img-top rounded shadow-sm mx-auto"
                                    style="height: 180px; width: auto; object-fit: cover;" alt="<%= book.title %>"
                                    width="120" height="180" loading="lazy">
                            </div>

                            <div class="card-body d-flex flex-column align-items-center pb-3">
                                <p class="fw-bold mb-2 text-truncate w-100 book-card-name" title="<%= book.title %>">
                                    <a href="/books/book/<%= book.id %>" class="text-decoration-none text-dark">
                                        <%= book.title %>
                                    </a>
                                </p>
                                <div class="mt-auto">
                                    <span class="badge bg-light text-muted border text-dark rounded-pill px-3 py-2">
                                        <i class="bi bi-cart-check-fill me-1" style="color: var(--brand-teal);"></i>
                                        <%= t('index.sold_units', { count: book.totalSold }) %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
            </div>
        </section>

        <!-- NOVEDADES / CARRUSEL -->
        <section class="mb-5 pb-4">
            <h2 class="section-title text-center">
                <%= t('index.featured_books') %>
            </h2>

            <% if (books && books.length> 0) { %>
                <div id="booksCarousel" class="carousel slide px-md-5" data-bs-ride="carousel">
                    <div class="carousel-inner py-3">
                        <% const booksPerSlide=4; for (let i=0; i < books.length; i +=booksPerSlide) { const
                            group=books.slice(i, i + booksPerSlide); const isActive=i===0 ? "active" : "" ; %>
                            <div class="carousel-item <%= isActive %>">
                                <div class="row justify-content-center">
                                    <% group.forEach(book=> { %>
                                        <div class="col-6 col-md-3 mb-4">
                                            <div class="card h-100 book-card shadow-sm border-0">
                                                <div class="position-relative overflow-hidden">
                                                    <img src="<%= book.cover_url || '/images/default-cover.jpg' %>"
                                                        class="card-img-top p-2 p-md-3 bg-light"
                                                        style="height: clamp(150px, 20vh, 250px); object-fit: contain;"
                                                        alt="<%= book.title %>" width="180" height="220" loading="lazy">
                                                </div>

                                                <div class="card-body d-flex flex-column p-2 p-md-3">
                                                    <p class="card-title text-truncate fw-bold text-dark mb-1"
                                                        style="font-size: var(--fs-sm);">
                                                        <%= book.title %>
                                                    </p>
                                                    <p class="text-muted small mb-2 text-truncate">
                                                        <% const relations=bookAuthors.filter(ba=> Number(ba.book_id)
                                                            === Number(book.id));
                                                            if (relations.length > 0) {
                                                            relations.forEach((ba, idx) => { %>
                                                            <a href="/author/<%= ba.author_id %>"
                                                                class="text-decoration-none text-muted fw-medium">
                                                                <%= ba.author ? ba.author.name :
                                                                    t('index.unknown_country') %>
                                                            </a>
                                                            <%= idx < relations.length - 1 ? ', ' : '' %>
                                                                <% }); } else { %>
                                                                    <%= t('index.unknown_country') %>
                                                                        <% } %>
                                                    </p>

                                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                                        <span class="fs-5 fw-bold" style="color: var(--brand-teal);">
                                                            <%= book.price %>€
                                                        </span>
                                                    </div>

                                                    <div class="mt-auto d-flex flex-column gap-2">
                                                        <a href="/books/book/<%= book.id %>"
                                                            class="btn btn-primary btn-sm w-100">
                                                            <i class="bi bi-eye me-1"></i>
                                                            <%= t('index.view_details') %>
                                                        </a>
                                                        <form action="/cart/add" method="POST" class="w-100 m-0">
                                                            <input type="hidden" name="book_id" value="<%= book.id %>">
                                                            <input type="hidden" name="quantity" value="1">
                                                            <input type="hidden" name="title" value="<%= book.title %>">
                                                            <input type="hidden" name="cover_url" value="<%= book.cover_url %>">
                                                            <button type="submit" class="btn btn-success btn-sm w-100"
                                                                <%=book.stock <=0 ? 'disabled' : '' %>>
                                                                <i
                                                                    class="bi <%= book.stock <=0 ? 'bi-x-circle' : 'bi-bag-plus-fill' %> me-1"></i>
                                                                <span class="d-none d-sm-inline">
                                                                    <%= book.stock <=0 ? t('book.out_of_stock') :
                                                                        t('book.add_to_cart') %>
                                                                </span>
                                                                <span class="d-inline d-sm-none">
                                                                    <%= book.stock <=0 ? 'X' : '+' %>
                                                                </span>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>
                            </div>
                            <% } %>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#booksCarousel"
                        data-bs-slide="prev" style="left: -20px;">
                        <span class="carousel-control-prev-icon shadow" aria-hidden="true"></span>
                        <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#booksCarousel"
                        data-bs-slide="next" style="right: -20px;">
                        <span class="carousel-control-next-icon shadow" aria-hidden="true"></span>
                        <span class="visually-hidden">Siguiente</span>
                    </button>
                </div>
                <% } else { %>
                    <p class="text-center text-muted fw-medium py-5">
                        <i class="bi bi-journal-x fs-1 d-block mb-3 opacity-25"></i>
                        <%= t('index.no_featured') %>
                    </p>
                    <% } %>
        </section>

        <!-- AUTORES (Destacados + Ranking) -->
        <div class="row mb-5">

            <!-- Autores Aleatorios (Destacados) -->
            <div class="col-lg-8 mb-4 mb-lg-0">
                <section class="h-100">
                    <h2 class="section-title text-start section-title-left">
                        <i class="bi bi-pen-fill me-2 text-primary"></i>
                        <%= t('index.featured_authors') %>
                    </h2>
                    <div class="row g-4 mt-2">
                        <% authors.slice().sort(()=> 0.5 - Math.random()).slice(0, 3).forEach(author=> {
                            const countData = bookAuthorsCount.find(item => Number(item.author_id) ===
                            Number(author.id));
                            const totalLibros = countData ? Number(countData.count_books) : 0;
                            %>
                            <div class="col-md-4 col-sm-6">
                                <div class="card text-center h-100 px-3 py-4">
                                    <img src="<%= author.photo_url || '/images/default-author.jpg' %>"
                                        class="author-avatar" alt="<%= author.name %>">

                                    <p class="fw-bold mb-1 fs-6 author-card-name">
                                        <%= author.name %>
                                    </p>
                                    <p class="text-muted small mb-3">
                                        <%= author.country || t('index.unknown_country') %>
                                    </p>

                                    <div class="mt-auto">
                                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill mb-3">
                                            <i class="bi bi-bookshelf me-1 text-primary"></i>
                                            <%= t('index.books_count', { count: totalLibros }) %>
                                        </span>
                                        <a href="/author/<%= author.id %>"
                                            class="btn btn-outline-primary btn-sm w-100 rounded-pill">
                                            <%= t('index.view_details') %>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                </section>
            </div>

            <!-- Ranking Autores -->
            <div class="col-lg-4">
                <section class="h-100">
                    <h3 class="section-title text-start section-title-left mb-4" style="font-size: 1.25rem;">
                        <i class="bi bi-trophy-fill text-warning me-2"></i>
                        <%= t('index.authors_ranking') %>
                    </h3>

                    <div class="ranking-list mt-3">
                        <% authorsMostSold.forEach((author, index)=> { %>
                            <div class="ranking-item">
                                <div class="d-flex align-items-center">
                                    <span class="ranking-number">
                                        <%= index + 1 %>
                                    </span>
                                    <a href="/author/<%= author.id %>" class="ranking-name text-decoration-none">
                                        <%= author.name %>
                                    </a>
                                </div>
                                <span class="ranking-badge">
                                    <%= author.totalSold %> <i class="bi bi-basket-fill ms-1 opacity-50"></i>
                                </span>
                            </div>
                            <% }) %>
                    </div>
                </section>
            </div>
        </div>

        <!-- EDITORIALES -->
        <section class="mt-5 pt-3">
            <h2 class="section-title text-center">
                <i class="bi bi-building-fill me-2" style="color: var(--brand-teal);"></i>
                <%= t('index.featured_publishers') %>
            </h2>

            <div class="row mt-4 justify-content-center g-4">
                <% if (publishersMostSold && publishersMostSold.length > 0) { %>
                    <% publishersMostSold.slice(0, 6).forEach((pub, index) => { 
                        const logo = pub.image_url || '/images/default-publisher.jpg';
                    %>
                        <div class="col-md-4 col-sm-6">
                            <a href="/publisher/<%= pub.id %>" class="text-decoration-none">
                                <div class="publisher-premium-card h-100 p-3 p-md-4 rounded-4 border shadow-sm position-relative overflow-hidden d-flex align-items-center gap-3">
                                    <!-- Medalla de Ranking -->
                                    <div class="publisher-premium-rank position-absolute top-0 start-0 text-dark fw-bold rounded-end-pill px-2 py-1 small shadow-sm z-1" style="background: var(--brand-gold); font-size: 0.75rem;">
                                        #<%= index + 1 %>
                                    </div>
                                    <!-- Logo -->
                                    <div class="publisher-logo-wrapper flex-shrink-0 bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm border" style="width: 70px; height: 70px; padding: 10px;">
                                        <img src="<%= logo %>" alt="<%= pub.name %>" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                                    </div>
                                    <!-- Info -->
                                    <div class="flex-grow-1 text-truncate">
                                        <h6 class="fw-bold text-dark mb-1 text-truncate" style="font-size: 1.05rem;"><%= pub.name %></h6>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge rounded-pill px-2 py-1 small fw-medium" style="background: rgba(10, 77, 77, 0.08); color: var(--brand-teal); border: 1px solid rgba(10, 77, 77, 0.1);">
                                                <i class="bi bi-graph-up-arrow me-1"></i> <%= pub.totalSold %> ventas
                                            </span>
                                        </div>
                                    </div>
                                    <!-- Icono Hover -->
                                    <div class="ms-auto transition-icon" style="color: var(--brand-teal); opacity: 0.2;">
                                        <i class="bi bi-arrow-right-circle-fill fs-3"></i>
                                    </div>
                                </div>
                            </a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-center text-muted fw-medium py-5">
                        <i class="bi bi-building-slash fs-1 d-block mb-3 opacity-25"></i>
                        No hay editoriales destacadas en este momento.
                    </p>
                <% } %>
            </div>
        </section>
    </div>

    <%- include('../layout/footer') %>