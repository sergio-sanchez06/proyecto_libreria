<%- include('../layout/header', { 
    bodyClass: 'bg-main-vistas',
    extraCSS: 'partials/index'
}) %>

<div class="container py-5">
    
    <!-- HEADER HERO BANNER -->
    <header class="hero-banner mb-5 text-center px-4">
        <h1 class="hero-title"><i class="bi bi-stars me-2 text-warning"></i>Bienvenido a BOOKLY</h1>
        <p class="lead mb-4 fw-light opacity-75 mx-auto" style="max-width: 700px;">
            <%= t('index.welcome_msg') || 'Explora nuestra colección de libros más recientes y autores destacados.' %>
        </p>

        <div class="d-flex flex-wrap gap-2 justify-content-center hero-genres mt-2">
            <% genresMostSold.forEach(genre=> { %>
                <span class="badge rounded-pill">
                    <i class="bi bi-tag-fill me-1 opacity-75"></i>
                    <a href="/genres/<%= genre.name %>" class="text-decoration-none">
                        <%= genre.name %>
                    </a>
                    <span class="ms-1 fw-bold opacity-100 ps-2" style="border-left: 1px solid rgba(255,255,255,0.3);">
                        <%= genre.totalSold %> ventas
                    </span>
                </span>
            <% }) %>
        </div>
    </header>

    <!-- LIBROS MÁS VENDIDOS -->
    <section class="mb-5 pb-3">
        <h2 class="section-title text-center">
            <i class="bi bi-activity text-danger me-2"></i><%= t('index.most_sold_books') %>
        </h2>
        
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-5 g-4 mt-2">
            <% booksMostSold.forEach((book, index)=> { 
                 let medalClass = 'medal-other';
                 if (index === 0) medalClass = 'medal-1';
                 else if (index === 1) medalClass = 'medal-2';
                 else if (index === 2) medalClass = 'medal-3';
            %>
                <div class="col">
                    <div class="card h-100 text-center position-relative pt-4">
                        <div class="medal <%= medalClass %>"><%= index + 1 %></div>
                        
                        <div class="px-3">
                            <img src="<%= book.cover_url || '/images/default-cover.jpg' %>"
                                 class="card-img-top rounded shadow-sm mx-auto" style="height: 180px; width: auto; object-fit: cover;"
                                 alt="<%= book.title %>">
                        </div>
                        
                        <div class="card-body d-flex flex-column align-items-center pb-3">
                            <h6 class="fw-bold mb-2 text-truncate w-100" title="<%= book.title %>">
                                <a href="/books/book/<%= book.id %>" class="text-decoration-none text-dark">
                                    <%= book.title %>
                                </a>
                            </h6>
                            <div class="mt-auto">
                                <span class="badge bg-light text-muted border text-dark rounded-pill px-3 py-2">
                                    <i class="bi bi-cart-check-fill me-1" style="color: var(--brand-teal);"></i>
                                    <%= t('index.sold_units', { count: book.totalSold }) %>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </section>

    <!-- NOVEDADES / CARRUSEL -->
    <section class="mb-5 pb-4">
        <h2 class="section-title text-center">
            <%= t('index.featured_books') %>
        </h2>

        <% if (books && books.length> 0) { %>
            <div id="booksCarousel" class="carousel slide px-md-5" data-bs-ride="carousel">
                <div class="carousel-inner py-3">
                    <% const booksPerSlide=4; for (let i=0; i < books.length; i +=booksPerSlide) { 
                        const group=books.slice(i, i + booksPerSlide); 
                        const isActive=i===0 ? "active" : "" ; 
                    %>
                        <div class="carousel-item <%= isActive %>">
                            <div class="row justify-content-center">
                                <% group.forEach(book=> { %>
                                    <div class="col-6 col-md-3 mb-4">
                                        <div class="card h-100 book-card shadow-sm border-0">
                                            <div class="position-relative overflow-hidden">
                                                <img src="<%= book.cover_url || '/images/default-cover.jpg' %>"
                                                     class="card-img-top p-2 p-md-3 bg-light" style="height: clamp(150px, 20vh, 250px); object-fit: contain;" alt="<%= book.title %>">
                                            </div>
                                            
                                            <div class="card-body d-flex flex-column p-2 p-md-3">
                                                <h5 class="card-title text-truncate fw-bold text-dark mb-1" style="font-size: var(--fs-sm);">
                                                    <%= book.title %>
                                                </h5>
                                                <p class="text-muted small mb-2 text-truncate">
                                                    <% const relations=bookAuthors.filter(ba=> Number(ba.book_id) === Number(book.id));
                                                       if (relations.length > 0) {
                                                           relations.forEach((ba, idx) => { %>
                                                               <a href="/author/<%= ba.author_id %>" class="text-decoration-none text-muted fw-medium">
                                                                   <%= ba.author ? ba.author.name : t('index.unknown_country') %>
                                                               </a><%= idx < relations.length - 1 ? ', ' : '' %>
                                                    <% }); } else { %>
                                                        <%= t('index.unknown_country') %>
                                                    <% } %>
                                                </p>
                                                
                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                    <span class="fs-5 fw-bold" style="color: var(--brand-teal);">
                                                        <%= book.price %>€
                                                    </span>
                                                </div>

                                                <div class="mt-auto d-flex flex-column gap-2">
                                                    <a href="/books/book/<%= book.id %>" class="btn btn-primary btn-sm w-100">
                                                        <i class="bi bi-eye me-1"></i> <%= t('index.view_details') %>
                                                    </a>
                                                    <form action="/cart/add" method="POST" class="w-100 m-0">
                                                        <input type="hidden" name="book_id" value="<%= book.id %>">
                                                        <input type="hidden" name="quantity" value="1">
                                                        <button type="submit" class="btn btn-success btn-sm w-100" <%=book.stock <=0 ? 'disabled' : '' %>>
                                                            <i class="bi <%= book.stock <=0 ? 'bi-x-circle' : 'bi-bag-plus-fill' %> me-1"></i>
                                                            <span class="d-none d-sm-inline"><%= book.stock <=0 ? t('es:book.out_of_stock') : t('es:book.add_to_cart') %></span>
                                                            <span class="d-inline d-sm-none"><%= book.stock <=0 ? 'X' : '+' %></span>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#booksCarousel" data-bs-slide="prev" style="left: -20px;">
                    <span class="carousel-control-prev-icon shadow" aria-hidden="true"></span>
                    <span class="visually-hidden">Anterior</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#booksCarousel" data-bs-slide="next" style="right: -20px;">
                    <span class="carousel-control-next-icon shadow" aria-hidden="true"></span>
                    <span class="visually-hidden">Siguiente</span>
                </button>
            </div>
        <% } else { %>
            <p class="text-center text-muted fw-medium py-5">
                <i class="bi bi-journal-x fs-1 d-block mb-3 opacity-25"></i>
                <%= t('index.no_featured') %>
            </p>
        <% } %>
    </section>

    <!-- AUTORES (Destacados + Ranking) -->
    <div class="row mb-5">
        
        <!-- Autores Aleatorios (Destacados) -->
        <div class="col-lg-8 mb-4 mb-lg-0">
            <section class="h-100">
                <h2 class="section-title text-start section-title-left">
                    <i class="bi bi-pen-fill me-2 text-primary"></i><%= t('index.featured_authors') %>
                </h2>
                <div class="row g-4 mt-2">
                    <% authors.slice().sort(() => 0.5 - Math.random()).slice(0, 3).forEach(author=> {
                        const countData = bookAuthorsCount.find(item => Number(item.author_id) === Number(author.id));
                        const totalLibros = countData ? Number(countData.count_books) : 0; 
                    %>
                        <div class="col-md-4 col-sm-6">
                            <div class="card text-center h-100 px-3 py-4">
                                <img src="<%= author.photo_url || '/images/default-author.jpg' %>" class="author-avatar" alt="<%= author.name %>">
                                
                                <h5 class="fw-bold mb-1 fs-6"><%= author.name %></h5>
                                <p class="text-muted small mb-3">
                                    <%= author.country || t('index.unknown_country') %>
                                </p>
                                
                                <div class="mt-auto">
                                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill mb-3">
                                        <i class="bi bi-bookshelf me-1 text-primary"></i> <%= t('index.books_count', { count: totalLibros }) %>
                                    </span>
                                    <a href="/author/<%= author.id %>" class="btn btn-outline-primary btn-sm w-100 rounded-pill">
                                        <%= t('index.view_details') %>
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </section>
        </div>

        <!-- Ranking Autores -->
        <div class="col-lg-4">
            <section class="h-100">
                <h3 class="section-title text-start section-title-left mb-4" style="font-size: 1.25rem;">
                    <i class="bi bi-trophy-fill text-warning me-2"></i><%= t('index.authors_ranking') %>
                </h3>
                
                <div class="ranking-list mt-3">
                    <% authorsMostSold.forEach((author, index)=> { %>
                        <div class="ranking-item">
                            <div class="d-flex align-items-center">
                                <span class="ranking-number"><%= index + 1 %></span>
                                <a href="/author/<%= author.id %>" class="ranking-name text-decoration-none">
                                    <%= author.name %>
                                </a>
                            </div>
                            <span class="ranking-badge">
                                <%= author.totalSold %> <i class="bi bi-basket-fill ms-1 opacity-50"></i>
                            </span>
                        </div>
                    <% }) %>
                </div>
            </section>
        </div>
    </div>

    <!-- EDITORIALES -->
    <section class="mt-5 pt-3">
        <h2 class="section-title text-center">
            <i class="bi bi-building-fill me-2" style="color: var(--brand-teal);"></i><%= t('index.featured_publishers') %>
        </h2>
        
        <div class="row mt-4 justify-content-center g-4">
            <% if (publishers && publishers.length> 0) { %>
                <% publishers.slice(0, 4).forEach(publisher=> { %>
                    <div class="col-6 col-md-3">
                        <div class="card text-center h-100 p-4 border-0" style="background: rgba(255,255,255,0.7); backdrop-filter: blur(5px);">
                            <a href="/publisher/<%= publisher.id %>" class="text-decoration-none text-dark d-flex flex-column h-100">
                                <div class="publisher-logo-container mb-3">
                                    <img src="<%= publisher.image_url || '/images/default-publisher.jpg' %>" alt="<%= publisher.name %>">
                                </div>
                                <h6 class="fw-bold mt-auto mb-0"><%= publisher.name %></h6>
                            </a>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
        
        <!-- Ranking Editoriales -->
        <div class="row mt-4 justify-content-center opacity-75">
            <div class="col-12 text-center text-muted small fw-medium mb-3">
                <%= t('index.sales', { count: 'MÁS VENDIDAS' }) || 'MÁS VENDIDAS' %>
            </div>
            <% publishersMostSold.forEach(pub=> { %>
                <div class="col-auto mb-2">
                    <a href="/publisher/<%= pub.id %>" class="badge bg-light text-dark border px-3 py-2 rounded-pill text-decoration-none">
                        <%= pub.name %> 
                        <span class="ms-2 text-success fw-bold"><%= pub.totalSold %> <i class="bi bi-graph-up-arrow"></i></span>
                    </a>
                </div>
            <% }) %>
        </div>
    </section>
</div>

<%- include('../layout/footer') %>