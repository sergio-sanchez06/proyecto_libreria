<%- include('../layout/header', { bodyClass: 'bg-admin-vistas' , extraCSS: 'admin/orders' }) %>
    <div class="container-fluid py-4 px-4">
        <% const currentLang=(typeof lang !=='undefined' && lang) ? lang : 'es' ; const localeMap={ 'eu' :'eu-ES', 'ca'
            :'ca-ES', 'gl' :'gl-ES', 'es' :'es-ES' }; const userLocale=localeMap[currentLang] || 'es-ES' ; const
            statusKeyMap={ 'PENDIENTE' : 'adminOrders.status_pending' , 'PAGADO' : 'adminOrders.status_paid'
            , 'PROCESANDO' : 'adminOrders.status_processing' , 'ENVIADO' : 'adminOrders.status_shipped' , 'ENTREGADO'
            : 'adminOrders.status_delivered' , 'CANCELADO' : 'adminOrders.status_cancelled' , 'DEVOLUCION_PENDIENTE'
            : 'adminOrders.status_return_pending' , 'DEVUELTO' : 'adminOrders.status_returned' , 'DEVOLUCION_RECHAZADA'
            : 'adminOrders.status_return_rejected' }; const total=globalStats.total; const pending=globalStats.pending;
            const processing=globalStats.processing; const revenue=globalStats.revenue; %>

            <!-- ── Hero ─────────────────────────────────────── -->
            <div class="admin-hero mb-4">
                <div class="admin-hero-content d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <h2 class="fw-800 mb-1" style="font-size:var(--fs-xl); font-weight:800;">
                            <i class="bi bi-bag-check-fill me-2"></i>
                            <% if (isPending) { %>
                                <%= t('adminOrders.title_pending') || 'Pedidos Pendientes' %>
                                    <% } else { %>
                                        <%= t('adminOrders.title') %>
                                            <% } %>
                        </h2>
                        <p class="mb-0 opacity-75" style="font-size:.9rem;">
                            <%= t('adminOrders.total_count', { count: totalOrders }) %>
                        </p>
                    </div>
                    <a href="/admin/dashboard" class="btn-back-admin">
                        <i class="bi bi-arrow-left me-2"></i>Dashboard
                    </a>
                </div>
            </div>

            <!-- ── Stat cards ────────────────────────────────── -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="stat-card">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon" style="background:#f0fdfa; color:var(--brand-teal);">
                                <i class="bi bi-cart-check-fill"></i>
                            </div>
                            <div>
                                <div class="stat-value" style="color:var(--brand-teal)">
                                    <%= total %>
                                </div>
                                <div class="stat-label"> <%= t('adminOrders.total') || 'Total' %> </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-card">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon" style="background:#fef9c3; color:#854d0e;">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                            <div>
                                <div class="stat-value" style="color:#854d0e;">
                                    <%= pending %>
                                </div>
                                <div class="stat-label"> <%= t('adminOrders.pending') || 'Pendientes' %></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-card">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon" style="background:#dbeafe; color:#1e40af;">
                                <i class="bi bi-truck"></i>
                            </div>
                            <div>
                                <div class="stat-value" style="color:#1e40af;">
                                    <%= processing %>
                                </div>
                                <div class="stat-label"> <%= t('adminOrders.shipped') || 'En camino' %></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-card">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon" style="background:#fef3c7; color:#92400e;">
                                <i class="bi bi-currency-euro"></i>
                            </div>
                            <div>
                                <div class="stat-value" style="color:#92400e; font-size:var(--fs-xl);">
                                    <%= revenue %>€
                                </div>
                                <div class="stat-label"> <%= t('adminOrders.revenue') || 'Facturado' %></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Tabs ──────────────────────────────────────── -->
            <div class="orders-tabs">
                <a href="/admin/orders" class="tab-btn <%= !isPending ? 'active' : '' %>">
                    <i class="bi bi-list-ul me-1"></i> Todos los pedidos
                </a>
                <a href="/admin/orders/pending" class="tab-btn <%= isPending ? 'active' : '' %>">
                    <i class="bi bi-hourglass-split me-1"></i> Pendientes
                    <% if (pending> 0) { %>
                        <span class="ms-1 badge rounded-pill"
                            style="background:#fbbf24; color:#7c2d12; font-size:.65rem;">
                            <%= pending %>
                        </span>
                        <% } %>
                </a>
            </div>

            <!-- ── Table ──────────────────────────────────────── -->
            <div class="orders-table-wrap">
                <% if (orders.length===0) { %>
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <h5>
                            <% if (isPending) { %>No hay pedidos pendientes<% } else { %>No hay pedidos<% } %>
                        </h5>
                        <p class="small">Aquí aparecerán los pedidos cuando existan.</p>
                    </div>
                    <% } else { %>
                        <div class="table-responsive">
                            <table class="table orders-table align-middle">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Fecha</th>
                                        <th>Cliente</th>
                                        <th>Items</th>
                                        <th class="text-end">Total</th>
                                        <th>Estado</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% orders.forEach(function(order) { const dateStr=order.created_at ? new
                                        Date(order.created_at).toLocaleString(userLocale, { day:'2-digit',
                                        month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) : '---' ;
                                        const itemCount=(order.items || []).length; const
                                        isCancelled=(['CANCELADO','DEVUELTO','DEVOLUCION_RECHAZADA'].includes(order.status));
                                        %>
                                        <tr>
                                            <!-- ID -->
                                            <td><span class="order-id-chip">#<%= order.id %></span></td>

                                            <!-- Fecha -->
                                            <td>
                                                <span class="d-block fw-500" style="font-size:.83rem; color:#374151;">
                                                    <%= dateStr.split(',')[0] %>
                                                </span>
                                                <span class="d-block text-muted" style="font-size:.75rem;">
                                                    <% if (dateStr.split(',').length> 1) { %>
                                                        <%= dateStr.split(',').slice(1).join(',').trim() %>
                                                            <% } %>
                                                </span>
                                            </td>

                                            <!-- Cliente -->
                                            <td>
                                                <span class="user-pill">
                                                    <i class="bi bi-person-circle"
                                                        style="color:var(--brand-teal); flex-shrink:0;"></i>
                                                    <%= order.user_email %>
                                                </span>
                                            </td>

                                            <!-- Items -->
                                            <td>
                                                <span class="badge rounded-pill"
                                                    style="background:#f1f5f9; color:#475569; font-size:.78rem; padding:5px 10px;">
                                                    <i class="bi bi-book me-1"></i>
                                                    <%= itemCount %> libro<%= itemCount !==1 ? 's' : '' %>
                                                </span>
                                            </td>

                                            <!-- Total -->
                                            <td class="text-end">
                                                <span class="fw-700" style="font-size:1rem; color:#0f172a;">
                                                    <%= parseFloat(order.total).toFixed(2) %>€
                                                </span>
                                            </td>

                                            <!-- Estado badge -->
                                            <td>
                                                <span class="status-badge status-<%= order.status %>">
                                                    <span class="dot"></span>
                                                    <%= t(statusKeyMap[order.status] || 'adminOrders.status_pending' )
                                                        %>
                                                </span>
                                            </td>

                                            <!-- Acciones -->
                                            <td>
                                                <% const
                                                    isFinished=['CANCELADO','DEVUELTO','DEVOLUCION_RECHAZADA'].includes(order.status);
                                                    const isReturnPending=order.status==='DEVOLUCION_PENDIENTE' ; const
                                                    isDelivered=order.status==='ENTREGADO' ; const
                                                    showSelector=!isFinished && !isReturnPending && !isDelivered; const
                                                    btnCls='btn btn-sm rounded-pill px-3 fw-600' ; %>
                                                    <div
                                                        class="d-flex align-items-center justify-content-center gap-2 flex-wrap">

                                                        <!-- Selector: PENDIENTE → PAGADO → PROCESANDO → ENVIADO -->
                                                        <% if (showSelector) { %>
                                                            <form action="/admin/orders/updateStatus/<%= order.id %>"
                                                                method="POST" data-requires-token class="d-flex">
                                                                <input type="hidden" name="orderId"
                                                                    value="<%= order.id %>">
                                                                <select name="status" class="status-select"
                                                                    onchange="this.form.requestSubmit()"
                                                                    title="Cambiar estado">
                                                                    <option value="PENDIENTE"
                                                                        <%=order.status==='PENDIENTE' ? 'selected' :''
                                                                        %>><%= t('adminOrders.status_pending') %>
                                                                    </option>
                                                                    <option value="PAGADO" <%=order.status==='PAGADO'
                                                                        ? 'selected' :'' %>><%=
                                                                            t('adminOrders.status_paid') %>
                                                                    </option>
                                                                    <option value="PROCESANDO"
                                                                        <%=order.status==='PROCESANDO' ? 'selected' :''
                                                                        %>><%= t('adminOrders.status_processing') %>
                                                                    </option>
                                                                    <option value="ENVIADO" <%=order.status==='ENVIADO'
                                                                        ? 'selected' :'' %>><%=
                                                                            t('adminOrders.status_shipped') %>
                                                                    </option>
                                                                </select>
                                                            </form>
                                                            <% } %>

                                                                <!-- Marcar entregado: solo desde ENVIADO -->
                                                                <% if (order.status==='ENVIADO' ) { %>
                                                                    <form
                                                                        action="/admin/orders/updateStatus/<%= order.id %>"
                                                                        method="POST" data-requires-token>
                                                                        <input type="hidden" name="orderId"
                                                                            value="<%= order.id %>">
                                                                        <input type="hidden" name="status"
                                                                            value="ENTREGADO">
                                                                        <button type="submit"
                                                                            class="<%= btnCls %> btn-success">
                                                                            <i
                                                                                class="bi bi-check-circle me-1"></i><%= t('adminOrders.btn_delivered') || 'Entregado' %>
                                                                        </button>
                                                                    </form>
                                                                    <% } %>

                                                                        <!-- Ver detalle: siempre visible -->
                                                                        <button class="btn-view-order"
                                                                            data-bs-toggle="modal"
                                                                            data-bs-target="#modalOrder<%= order.id %>">
                                                                            <i class="bi bi-eye-fill me-1"></i>
                                                                            <%= t('adminOrders.btn_view') %>
                                                                        </button>

                                                                        <!-- Confirmar / Rechazar: solo DEVOLUCION_PENDIENTE -->
                                                                        <% if (isReturnPending) { %>
                                                                            <button type="button"
                                                                                class="<%= btnCls %> btn-warning"
                                                                                data-bs-toggle="modal"
                                                                                data-bs-target="#modalConfirmReturn"
                                                                                data-order-id="<%= order.id %>"
                                                                                data-order-email="<%= order.user_email %>">
                                                                                <i
                                                                                    class="bi bi-arrow-return-left me-1"></i><%= t('adminOrders.btn_confirm_return') || 'Confirmar devolución' %>
                                                                            </button>
                                                                            <button type="button"
                                                                                class="<%= btnCls %> btn-secondary"
                                                                                data-bs-toggle="modal"
                                                                                data-bs-target="#modalRejectReturn"
                                                                                data-order-id="<%= order.id %>"
                                                                                data-order-email="<%= order.user_email %>">
                                                                                <i class="bi bi-x-lg me-1"></i><%= t('adminOrders.btn_reject_return') || 'Rechazar devolución' %>
                                                                            </button>
                                                                            <% } %>

                                                                                <!-- Forzar devolución: ENTREGADO únicamente -->
                                                                                <% if (isDelivered) { %>
                                                                                    <button type="button"
                                                                                        class="<%= btnCls %> btn-danger"
                                                                                        data-bs-toggle="modal"
                                                                                        data-bs-target="#modalForceReturn"
                                                                                        data-order-id="<%= order.id %>"
                                                                                        data-order-email="<%= order.user_email %>">
                                                                                        <i
                                                                                            class="bi bi-exclamation-triangle me-1"></i><%= t('adminOrders.btn_force_return') || 'Forzar devolución' %>
                                                                                    </button>
                                                                                    <% } %>

                                                                                        <!-- Cancelar: solo pedidos activos no finalizados ni entregados ni en devolución -->
                                                                                        <% if (!isFinished &&
                                                                                            !isDelivered &&
                                                                                            !isReturnPending) { %>
                                                                                            <button type="button"
                                                                                                class="<%= btnCls %> btn-outline-danger"
                                                                                                title="Cancelar pedido"
                                                                                                data-bs-toggle="modal"
                                                                                                data-bs-target="#modalCancelOrder"
                                                                                                data-order-id="<%= order.id %>"
                                                                                                data-order-email="<%= order.user_email %>">
                                                                                                <i
                                                                                                    class="bi bi-x-circle me-1"></i><%= t('adminOrders.btn_cancel') || 'Cancelar' %>
                                                                                            </button>
                                                                                            <% } %>

                                                    </div>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>
                        <% } %>
            </div>

            <!-- ── Paginación ─────────────────────────────────── -->
            <% if (totalPages> 1) {
                const baseUrl = isPending ? '/admin/orders/pending' : '/admin/orders';
                %>
                <nav class="mt-4 d-flex align-items-center justify-content-between flex-wrap gap-3"
                    aria-label="Paginación de pedidos">
                    <span class="text-muted" style="font-size:.85rem;">
                        Mostrando página <strong>
                            <%= currentPage %>
                        </strong> de <strong>
                            <%= totalPages %>
                        </strong>
                        &nbsp;·&nbsp; <strong>
                            <%= totalOrders %>
                        </strong> pedidos en total
                    </span>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="<%= baseUrl %>?page=<%= currentPage - 1 %>">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        <% for (let p=1; p <=totalPages; p++) { %>
                            <% if (totalPages <=7 || p===1 || p===totalPages || Math.abs(p - currentPage) <=1) { %>
                                <li class="page-item <%= currentPage == p ? 'active' : '' %>">
                                    <a class="page-link" href="<%= baseUrl %>?page=<%= p %>">
                                        <%= p %>
                                    </a>
                                </li>
                                <% } else if (Math.abs(p - currentPage)===2) { %>
                                    <li class="page-item disabled"><span class="page-link">…</span></li>
                                    <% } %>
                                        <% } %>
                                            <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                                                <a class="page-link" href="<%= baseUrl %>?page=<%= currentPage + 1 %>">
                                                    <i class="bi bi-chevron-right"></i>
                                                </a>
                                            </li>
                    </ul>
                </nav>
                <% } %>

    </div><!-- /container-fluid -->


    <!-- ══════════════════════════════════════════════════
     MODAL DE CONFIRMACIÓN DE CANCELACIÓN (uno global, reutilizable)
     ── NUEVO ──
══════════════════════════════════════════════════ -->
    <div class="modal fade" id="modalCancelOrder" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header border-0" style="background:#dc3545;">
                    <h5 class="modal-title fw-bold text-white">
                        <i class="bi bi-x-circle-fill me-2"></i>
                        <%= t('adminOrders.cancel_modal_title') %>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-center">

                    <p class="small fw-light text-muted">
                        <%- t('adminOrders.cancel_modal_body').replace('{{id}}', '<span id="cancelOrderDisplayOrderId" class="fw-bold text-dark"></span>'
                            ) %>
                    </p>

                    <p class="mb-1">
                        ¿Cancelar el pedido <strong id="cancelOrderId"></strong> de
                        <strong id="cancelOrderEmail"></strong>?
                    </p>
                    <!-- <p class="text-muted small mb-0">
                        El stock de los libros se restituirá automáticamente.
                        Esta acción no se puede deshacer.
                    </p> -->
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">
                        <%= t('adminOrders.btn_cancel') %>
                    </button>
                    <form id="cancelOrderForm" method="POST" data-requires-token style="display:inline;">
                        <input type="hidden" name="orderId" id="cancelOrderFormId">
                        <button type="submit" class="btn btn-danger rounded-pill px-4 ms-2">
                            <i class="bi bi-x-circle-fill me-1"></i>
                            <%= t('adminOrders.cancel_confirm_btn') %>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalConfirmReturn" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-warning border-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-arrow-return-left me-2"></i>
                        <%= t('adminOrders.return_modal_title') %>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-center">

                    <p class="small fw-light text-muted">
                        <%- t('adminOrders.return_confirm_modal_body').replace('{{id}}', '<span id="confirmReturnDisplayOrderId" class="fw-bold text-dark"></span>'
                            ) %>
                    </p>

                    <!-- <p class="mb-1">¿Aprobar la devolución del pedido <strong class="target-order-id"></strong>?</p>
                    <p class="text-muted small mb-0">Se notificará al cliente y se procederá con el reembolso.</p> -->
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">
                        <%= t('adminOrders.btn_cancel') %>
                    </button>
                    <form id="confirmReturnForm" method="POST" data-requires-token>
                        <input type="hidden" name="orderId" class="target-order-input">
                        <button type="submit" class="btn btn-warning rounded-pill px-4 ms-2 fw-bold">
                            <%= t('adminOrders.return_confirm_confirm_btn') %>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalForceReturn" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-danger border-0">
                    <h5 class="modal-title fw-bold text-white"><i class="bi bi-exclamation-triangle me-2"></i>
                        <%= t('adminOrders.force_return_modal_title') %>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-center">

                    <p class="small fw-light text-muted">
                        <%- t('adminOrders.force_return_modal_body').replace('{{id}}', '<span id="forceReturnDisplayOrderId" class="fw-bold text-dark"></span>'
                            ) %>
                    </p>

                    <!-- <p class="mb-1">¿Estás seguro de forzar la devolución del pedido <strong
                            class="target-order-id"></strong>?</p>
                    <p class="text-danger small fw-bold mb-0">¡Atención! Se emitirá un reembolso inmediato al cliente.
                    </p> -->
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">
                        <%= t('adminOrders.btn_cancel') %>
                    </button>
                    <form id="forceReturnForm" method="POST" data-requires-token>
                        <input type="hidden" name="orderId" class="target-order-input">
                        <button type="submit" class="btn btn-danger rounded-pill px-4 ms-2">
                            <%= t('adminOrders.force_return_confirm_btn') %>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalRejectReturn" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-secondary border-0">
                    <h5 class="modal-title fw-bold text-white">
                        <i class="bi bi-x-circle me-2"></i>
                        <%= t('adminOrders.return_reject_modal_title') %>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <p class="small fw-light text-muted">
                        <%- t('adminOrders.return_reject_modal_body').replace('{{id}}', '<span id="rejectReturnDisplayOrderId" class="fw-bold text-dark"></span>'
                            ) %>
                    </p>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">
                        <%= t('adminOrders.btn_cancel') %>
                    </button>
                    <form id="rejectReturnForm" method="POST" data-requires-token>
                        <input type="hidden" name="orderId" class="target-order-input">
                        <button type="submit" class="btn btn-secondary rounded-pill px-4 ms-2 fw-bold">
                            <%= t('adminOrders.return_reject_confirm_btn') %>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>


    <!-- ══════════════════════════════════════════════════
    MODALS DE DETALLE (uno por pedido)
══════════════════════════════════════════════════ -->
    <% orders.forEach(function(order) { const modalDate=order.created_at ? new
        Date(order.created_at).toLocaleString(userLocale) : '---' ; const items=order.items || []; const
        orderTotal=parseFloat(order.total || 0).toFixed(2); %>
        <div class="modal fade" id="modalOrder<%= order.id %>" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header-custom d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold mb-0">
                                <i class="bi bi-receipt me-2"></i>
                                <%= t('adminOrders.modal_title') %> <span class="opacity-75">#<%= order.id %></span>
                            </h5>
                            <small class="opacity-60" style="font-size:.78rem;">
                                <%= modalDate %>
                            </small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="status-badge status-<%= order.status %>">
                                <span class="dot"></span>
                                <%= t(statusKeyMap[order.status] || 'adminOrders.status_pending' ) %>
                            </span>
                            <button type="button" class="btn-close btn-close-white ms-2"
                                data-bs-dismiss="modal"></button>
                        </div>
                    </div>
                    <div class="modal-body p-4">
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="modal-info-box h-100">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-person-circle"
                                            style="color:var(--brand-teal); font-size:1.1rem;"></i>
                                        <span class="fw-700 small" style="color:var(--brand-teal);">Cliente</span>
                                    </div>
                                    <p class="mb-0 fw-500" style="font-size:.88rem; word-break:break-all;">
                                        <%= order.user_email %>
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="modal-info-box h-100">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-geo-alt-fill"
                                            style="color:var(--brand-teal); font-size:1.1rem;"></i>
                                        <span class="fw-700 small" style="color:var(--brand-teal);">
                                            <%= t('adminOrders.shipping_address') %>
                                        </span>
                                    </div>
                                    <p class="mb-0" style="font-size:.88rem; color:#374151;">
                                        <%= order.shipping_address || '—' %>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <h6 class="fw-700 mb-3"
                            style="color:#0f172a; font-size:.85rem; text-transform:uppercase; letter-spacing:.05em;">
                            <i class="bi bi-list-ul me-1" style="color:var(--brand-teal);"></i>
                            <%= t('adminOrders.modal_items') %>
                        </h6>
                        <% if (items.length===0) { %>
                            <p class="text-muted small text-center py-3">Sin artículos registrados.</p>
                            <% } else { %>
                                <div class="table-responsive rounded-3 border">
                                    <table class="table modal-items-table mb-0">
                                        <thead>
                                            <tr>
                                                <th>
                                                    <%= t('adminOrders.modal_book_title') %>
                                                </th>
                                                <th class="text-center">
                                                    <%= t('adminOrders.modal_qty') %>
                                                </th>
                                                <th class="text-end">
                                                    <%= t('adminOrders.modal_price') %>
                                                </th>
                                                <th class="text-end">
                                                    <%= t('adminOrders.modal_subtotal') %>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% items.forEach(function(item) { const title=item.book_title || (item.book
                                                ? item.book.title : '—' ); const subtotal=(item.quantity *
                                                item.price_at_time).toFixed(2); %>
                                                <tr>
                                                    <td>
                                                        <span class="fw-600" style="font-size:.85rem;">
                                                            <%= title %>
                                                        </span>
                                                        <small class="d-block text-muted" style="font-size:.72rem;">
                                                            ID: <%= item.book_id %>
                                                        </small>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge rounded-pill"
                                                            style="background:#f1f5f9; color:#475569; font-size:.8rem; padding:5px 10px;">
                                                            × <%= item.quantity %>
                                                        </span>
                                                    </td>
                                                    <td class="text-end" style="font-size:.85rem; color:#374151;">
                                                        <%= parseFloat(item.price_at_time).toFixed(2) %>€
                                                    </td>
                                                    <td class="text-end fw-700" style="color:#0f172a;">
                                                        <%= subtotal %>€
                                                    </td>
                                                </tr>
                                                <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="modal-total-bar mt-3 d-flex justify-content-between align-items-center">
                                    <span class="fw-600" style="color:#065f46; font-size:.9rem;">
                                        <i class="bi bi-check-circle-fill me-1"></i> Total del pedido
                                    </span>
                                    <span class="fw-800" style="font-size:1.25rem; color:#065f46;">
                                        <%= orderTotal %>€
                                    </span>
                                </div>
                                <% } %>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">
                            <i class="bi bi-x me-1"></i>
                            <%= t('adminOrders.modal_close') %>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <% }) %>

            <!-- ── Script del modal de cancelación ── NUEVO ── -->
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    const modalCancelOrder = document.getElementById('modalCancelOrder');
                    if (modalCancelOrder) {
                        modalCancelOrder.addEventListener('show.bs.modal', function (event) {
                            // Botón que activó el modal
                            const button = event.relatedTarget;

                            // Extraer información de los atributos data-
                            const orderId = button.getAttribute('data-order-id');
                            const orderEmail = button.getAttribute('data-order-email');

                            // Actualizar el contenido del modal
                            document.getElementById('cancelOrderDisplayOrderId').textContent = '#' + orderId;
                            document.getElementById('cancelOrderEmail').textContent = orderEmail;
                            document.getElementById('cancelOrderFormId').value = orderId;

                            // Configurar la URL del formulario dinámicamente
                            const form = document.getElementById('cancelOrderForm');
                            form.action = '/admin/orders/cancel/' + orderId;
                        });
                    }

                    // ── Modal: Confirmar devolución ───────────────────
                    const modalConfirmReturn = document.getElementById('modalConfirmReturn');
                    if (modalConfirmReturn) {
                        modalConfirmReturn.addEventListener('show.bs.modal', function (event) {
                            const btn = event.relatedTarget;
                            const orderId = btn.getAttribute('data-order-id');
                            document.getElementById('confirmReturnForm').action = '/admin/orders/confirm-return/' + orderId;
                            document.querySelector('#confirmReturnForm .target-order-input').value = orderId;
                            document.getElementById('confirmReturnDisplayOrderId').textContent = orderId;
                        });
                    }

                    // ── Modal: Forzar devolución ──────────────────────
                    const modalForceReturn = document.getElementById('modalForceReturn');
                    if (modalForceReturn) {
                        modalForceReturn.addEventListener('show.bs.modal', function (event) {
                            const btn = event.relatedTarget;
                            const orderId = btn.getAttribute('data-order-id');
                            document.getElementById('forceReturnForm').action = '/admin/orders/force-return/' + orderId;
                            document.querySelector('#forceReturnForm .target-order-input').value = orderId;
                            document.getElementById('forceReturnDisplayOrderId').textContent = orderId;
                        });
                    }

                    // ── Modal: Rechazar devolución ────────────────────
                    const modalRejectReturn = document.getElementById('modalRejectReturn');
                    if (modalRejectReturn) {
                        modalRejectReturn.addEventListener('show.bs.modal', function (event) {
                            const btn = event.relatedTarget;
                            const orderId = btn.getAttribute('data-order-id');
                            document.getElementById('rejectReturnForm').action = '/admin/orders/reject-return/' + orderId;
                            document.querySelector('#rejectReturnForm .target-order-input').value = orderId;
                            document.getElementById('rejectReturnDisplayOrderId').textContent = orderId;
                        });
                    }

                });
            </script>

            <%- include('../layout/footer') %>