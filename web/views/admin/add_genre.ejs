<!DOCTYPE html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('addGenre.page_title') %></title>
    <link rel="stylesheet" href="/css/add_genre.css">
</head>

<body>

    <%- include ("../layout/header") %>
    <main class="admin-form-page bg-pattern-general">
        <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card brand-card">
                    <div class="card-header brand-card-header text-center">
                        <h2 class="mb-0 h3 fw-bold"><i class="bi bi-tags-fill me-2"></i><%= t('addGenre.title') %></h2>
                    </div>
                    <div class="card-body p-4">
                        <% if (locals.error) { %>
                            <div class="alert alert-danger border-0 shadow-sm">
                                <i class="bi bi-exclamation-circle me-2"></i><%= error %>
                            </div>
                        <% } %>

                        <form action="/genres/create" method="POST">
                            <div class="mb-4">
                                <label for="name" class="form-label fw-bold"><%= t('addGenre.label_name') %> *</label>
                                <input type="text" name="name" id="name" class="form-control" 
                                       placeholder="<%= t('addGenre.placeholder_name') %>" required>
                            </div>

                            <div class="d-flex justify-content-center gap-3 mt-4">
                                <button type="submit" class="btn btn-brand-teal px-5 py-2 fw-bold rounded-pill">
                                    <i class="bi bi-plus-circle-fill me-2"></i>
                                    <%= t('addGenre.btn_submit') %>
                                </button>
                                <a href="/admin/dashboard" class="btn btn-secondary px-4 rounded-pill">
                                    <%= t('addAuthor.btn_cancel') %>
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
            </div>
        </div>
    </main>

    <%- include ("../layout/footer") %>
</body>
</html>