<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= t('editAuthor.page_title') %>
    </title>
    <link rel="stylesheet" href="/css/add_book.css">
</head>

<body>
    <%- include("../layout/header") %>
    <main class="admin-form-page bg-pattern-authors">
        <div class="container py-4">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="card brand-card">
                        <div class="card-header brand-card-header text-center">
                            <h2 class="mb-0 h3 fw-bold">
                                <i class="bi bi-person-fill-gear me-2"></i>
                                <%= t('editAuthor.title') %>
                            </h2>
                        </div>
                        <div class="card-body p-4">
                            <% if (locals.error) { %>
                                <div class="alert alert-danger border-0 shadow-sm">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <%= error %>
                                </div>
                                <% } %>

                                    <div class="text-center mb-4">
                                        <label class="form-label d-block fw-bold text-muted small">
                                            <%= t('addAuthor.label_photo') %> Actual
                                        </label>
                                        <img src="<%= author.photo_url || '/images/default_author.png' %>"
                                            alt="<%= author.name %>" class="img-thumbnail rounded-circle shadow-sm"
                                            style="width: 150px; height: 150px; object-fit: cover;">
                                    </div>

                                    <form action="/authors/author/update/<%= author.id %>" method="POST"
                                        enctype="multipart/form-data">
                                        
                                        <div class="mb-3">
                                            <label for="name" class="form-label fw-bold">
                                                <%= t('addAuthor.label_name') %> *
                                            </label>
                                            <input type="text" name="name" id="name" class="form-control"
                                                value="<%= author.name %>" required>
                                        </div>

                                        <div class="mb-3">
                                            <label for="country" class="form-label fw-bold">
                                                <%= t('addAuthor.label_country') %>
                                            </label>
                                            <input type="text" name="country" id="country" value="<%= author.country %>"
                                                class="form-control">
                                        </div>

                                        <div class="mb-3">
                                            <label for="biography" class="form-label fw-bold">
                                                <%= t('addAuthor.label_biography') %>
                                            </label>
                                            <textarea name="biography" id="biography" rows="6"
                                                class="form-control"><%= author.biography || '' %></textarea>
                                        </div>

                                        <div class="mb-3">
                                            <label for="photo" class="form-label fw-bold">
                                                <%= t('addAuthor.label_photo') %> (Nueva)
                                            </label>
                                            <input type="file" name="photo" id="photo" class="form-control"
                                                accept="image/*">
                                            <small class="form-text text-muted">
                                                <%= t('addAuthor.photo_help') %>
                                            </small>
                                        </div>

                                        <div class="d-flex justify-content-center gap-3 mt-4">
                                            <button type="submit" class="btn btn-brand-teal px-5 py-2 fw-bold rounded-pill">
                                                <i class="bi bi-check-circle-fill me-2"></i>
                                                <%= t('editAuthor.btn_save') %>
                                            </button>
                                            <a href="/authors/showAllAuthors" class="btn btn-secondary px-4 rounded-pill">
                                                <%= t('addAuthor.btn_cancel') %>
                                            </a>
                                        </div>
                                    </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include("../layout/footer") %>
</body>

</html>