<!DOCTYPE html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('editAuthor.page_title') %></title>
    <link rel="stylesheet" href="/css/add_genre.css">
</head>

<body>

    <%- include("../layout/header") %>

    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-header text-white" style="background-color: #006d33;">
                        <h2 class="mb-0 h4"><i class="bi bi-pencil-square me-2"></i><%= t('editAuthor.title') %></h2>
                    </div>
                    <div class="card-body p-4">

                        <form action="/authors/author/update/<%= author.id %>" method="POST" enctype="multipart/form-data">
                            <input type="hidden" name="_method" value="PUT">

                            <div class="mb-3">
                                <label for="name" class="form-label fw-bold"><%= t('addAuthor.label_name') %></label>
                                <input type="text" name="name" id="name" value="<%= author.name %>"
                                    class="form-control" required>
                            </div>

                            <div class="mb-3">
                                <label for="country" class="form-label fw-bold"><%= t('addAuthor.label_country') %></label>
                                <input type="text" name="country" id="country" value="<%= author.country %>"
                                    class="form-control">
                            </div>

                            <div class="mb-3">
                                <label for="biography" class="form-label fw-bold"><%= t('addAuthor.label_biography') %></label>
                                <textarea name="biography" id="biography" rows="5"
                                    class="form-control"><%= author.biography %></textarea>
                            </div>

                            <div class="mb-3 text-center">
                                <label class="form-label d-block fw-bold text-muted small"><%= t('editAuthor.current_photo') %></label>
                                <img src="<%= author.photo_url %>" alt="<%= author.name %>" 
                                     class="img-thumbnail shadow-sm mb-2" style="max-height: 150px;">
                            </div>

                            <div class="mb-3">
                                <label for="photo" class="form-label fw-bold"><%= t('addAuthor.label_photo') %></label>
                                <input type="file" name="photo" id="photo" class="form-control" accept="image/*">
                                <small class="form-text text-muted"><%= t('addAuthor.photo_help') %></small>
                            </div>

                            <div class="d-flex justify-content-center gap-2 mt-4">
                                <button type="submit" class="btn px-4 text-white" style="background-color: #006d33;">
                                    <i class="bi bi-save me-1"></i> <%= t('editAuthor.btn_save') %>
                                </button>
                                <a href="/author/<%= author.id %>" class="btn btn-secondary px-4">
                                    <%= t('addAuthor.btn_cancel') %>
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include("../layout/footer") %>
</body>
</html>