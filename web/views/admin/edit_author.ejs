<%- include('../layout/header', {
    title: t('editAuthor.page_title') || 'Editar Autor',
    bodyClass: 'bg-main-vistas'
}) %>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

    body {
        font-family: 'Inter', sans-serif;
        color: var(--text-dark);
    }

    body::before {
        content: "";
        position: fixed;
        top: 0; left: 0; width: 100vw; height: 100vh;
        background: rgba(252, 250, 247, 0.45);
        z-index: -1;
    }

    .admin-form-container {
        max-width: 700px;
        margin: 0 auto;
    }

    .brand-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(12px);
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.6);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .brand-card-header {
        background: linear-gradient(135deg, var(--brand-teal), #1e3a8a);
        color: white;
        padding: 2rem;
        border-bottom: 6px solid var(--brand-gold);
    }

    .form-label {
        font-weight: 700;
        color: #1e293b;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
    }

    .form-control {
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        background-color: #f8fafc;
    }

    .form-control:focus {
        border-color: var(--brand-teal);
        box-shadow: 0 0 0 4px rgba(30, 64, 175, 0.1);
        background-color: white;
    }

    .btn-brand-teal {
        background-color: var(--brand-teal);
        color: white;
        border: none;
        transition: all 0.3s ease;
    }

    .btn-brand-teal:hover {
        background-color: var(--brand-teal-hover);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(30, 64, 175, 0.25);
        color: white;
    }

    .current-photo-container {
        width: 150px;
        height: 150px;
        margin: 0 auto;
        border-radius: 50%;
        padding: 6px;
        background: white;
        border: 2px dashed #cbd5e1;
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    }

    .current-photo-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
    }
</style>

<main class="py-5">
    <div class="container admin-form-container">
        <div class="brand-card">
            <div class="brand-card-header text-center">
                <h2 class="mb-0 fw-bold d-flex flex-column align-items-center gap-2">
                    <i class="bi bi-person-lines-fill fs-1 opacity-75"></i>
                    <span><%= t('editAuthor.title') || 'Editar Autor' %></span>
                </h2>
                <p class="text-white-50 mt-2 mb-0">Actualiza la biografía y los datos del autor</p>
            </div>
            
            <div class="card-body p-4 p-md-5">
                <% if (locals.error) { %>
                    <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                        <div><%= error %></div>
                    </div>
                <% } %>

                <div class="text-center mb-5">
                    <div class="current-photo-container mb-3">
                        <img src="<%= author.photo_url || '/images/default-author.jpg' %>" alt="<%= author.name %>">
                    </div>
                    <label class="form-label d-block text-muted">
                        <%= t('addAuthor.label_photo') || 'Fotografía de Perfil Actual' %>
                    </label>
                </div>

                <form action="/authors/author/update/<%= author.id %>" method="POST" enctype="multipart/form-data" data-requires-token>
                    <div class="row g-4">
                        <div class="col-md-7">
                            <div class="mb-3">
                                <label for="name" class="form-label"><%= t('addAuthor.label_name') || 'Nombre Completo' %> *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-person text-muted"></i></span>
                                    <input type="text" name="name" id="name" class="form-control border-start-0 ps-0" value="<%= author.name %>" placeholder="Ej: Gabriel García Márquez" required>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-5">
                            <div class="mb-3">
                                <label for="country" class="form-label"><%= t('addAuthor.label_country') || 'País' %></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-globe-americas text-muted"></i></span>
                                    <input type="text" name="country" id="country" value="<%= author.country %>" class="form-control border-start-0 ps-0" placeholder="Ej: Colombia">
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="mb-3">
                                <label for="biography" class="form-label"><%= t('addAuthor.label_biography') || 'Biografía' %></label>
                                <textarea name="biography" id="biography" rows="6" class="form-control" placeholder="Escribe un breve resumen sobre la vida del autor..."><%= author.biography || '' %></textarea>
                            </div>
                        </div>

                        <div class="col-12">
                            <hr class="my-3 opacity-10">
                            <div class="mb-4 p-4 rounded-4" style="background-color: #f8fafc; border: 1px dashed #cbd5e1;">
                                <label for="photo" class="form-label"><i class="bi bi-camera me-1"></i> Subir Nueva Fotografía (Opcional)</label>
                                <input type="file" name="photo" id="photo" class="form-control bg-white" accept="image/*">
                                <small class="text-muted mt-2 d-block fw-medium"><%= t('addAuthor.photo_help') || 'Selecciona una imagen si deseas cambiar la foto de perfil.' %></small>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center gap-3 mt-4 pt-4 border-top">
                        <a href="/author/<%= author.id %>" class="btn btn-light px-4 py-2 rounded-pill fw-bold text-secondary border shadow-sm">
                            <%= t('addAuthor.btn_cancel') || 'Cancelar' %>
                        </a>
                        <button type="submit" class="btn btn-brand-teal px-5 py-2 fw-bold rounded-pill text-white shadow-sm d-flex align-items-center gap-2">
                            <i class="bi bi-save2"></i>
                            <%= t('editAuthor.btn_save') || 'Guardar Cambios' %>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

<%- include("../layout/footer") %>