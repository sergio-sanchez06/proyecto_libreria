<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= t('editBook.page_title') %>
    </title>
    <link rel="stylesheet" href="/css/add_book.css">
</head>

<body>
    <%- include("../layout/header") %>

        <main class="container py-5">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="card shadow-sm border-0">
                        <div class="card-header text-white" style="background-color: #006d33;">
                            <h2 class="mb-0 h4">
                                <%= t('editBook.title') %>: <%= book.title %>
                            </h2>
                        </div>
                        <div class="card-body p-4">
                            <% if (locals.error) { %>
                                <div class="alert alert-danger border-0 shadow-sm">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <%= error %>
                                </div>
                                <% } %>

                                    <div class="text-center mb-4">
                                        <label class="form-label d-block fw-bold text-muted small">
                                            <%= t('editBook.label_current_cover') %>
                                        </label>
                                        <img src="<%= book.cover_url || '/images/default_cover.png' %>"
                                            alt="<%= book.title %>" class="img-thumbnail shadow-sm"
                                            style="max-height: 200px;">
                                    </div>

                                    <form action="/admin/books/edit/<%= book.id %>" method="POST"
                                        enctype="multipart/form-data">
                                        <div class="mb-3">
                                            <label for="title" class="form-label fw-bold">
                                                <%= t('addBook.label_title') %> *
                                            </label>
                                            <input type="text" name="title" id="title" class="form-control"
                                                value="<%= book.title %>" required>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="isbn" class="form-label fw-bold">
                                                    <%= t('addBook.label_isbn') %>
                                                </label>
                                                <input type="text" name="isbn" id="isbn" value="<%= book.isbn %>"
                                                    class="form-control">
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="releashed_year" class="form-label fw-bold">
                                                    <%= t('addBook.label_year') %>
                                                </label>
                                                <input type="number" name="releashed_year" id="releashed_year"
                                                    value="<%= book.releashed_year %>" class="form-control" min="1000"
                                                    max="2100">
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="price" class="form-label fw-bold">
                                                    <%= t('addBook.label_price') %> *
                                                </label>
                                                <input type="number" step="0.01" name="price" id="price"
                                                    value="<%= book.price %>" class="form-control" required>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="stock" class="form-label fw-bold">
                                                    <%= t('addBook.label_stock') %> *
                                                </label>
                                                <input type="number" name="stock" id="stock" value="<%= book.stock %>"
                                                    class="form-control" min="0" required>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="publisher_id" class="form-label fw-bold">
                                                <%= t('addBook.label_publisher') %> *
                                            </label>
                                            <select name="publisher_id" id="publisher_id" class="form-select" required>
                                                <% publishers.forEach(pub=> { %>
                                                    <option value="<%= pub.id %>" <%=book.publisher_id==pub.id
                                                        ? 'selected' : '' %>>
                                                        <%= pub.name %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label for="cover" class="form-label fw-bold">
                                                <%= t('editBook.label_new_cover') %>
                                            </label>
                                            <input type="file" name="cover" id="cover" class="form-control"
                                                accept="image/*">
                                            <small class="form-text text-muted">
                                                <%= t('addBook.cover_help') %>
                                            </small>
                                        </div>

                                        <div class="d-flex justify-content-center gap-2 mt-4">
                                            <button type="submit" class="btn btn-success px-4">
                                                <i class="bi bi-check-circle me-1"></i>
                                                <%= t('editAuthor.btn_save') %>
                                            </button>
                                            <a href="/books/book/<%= book.id %>" class="btn btn-secondary px-4">
                                                <%= t('addAuthor.btn_cancel') %>
                                            </a>
                                        </div>
                                    </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <%- include("../layout/footer") %>

            <% if (locals.error) { %>
                <script>
                    document.addEventListener("DOMContentLoaded", () => {
                        if (typeof showModal === "function") {
                            showModal("error", "<%= error %>");
                        }
                    });
                </script>
                <% } %>

                    <% if (locals.success) { %>
                        <script>
                            document.addEventListener("DOMContentLoaded", () => {
                                if (typeof showModal === "function") {
                                    showModal("success", "<%= success %>");
                                }
                            });
                        </script>
                        <% } %>
</body>

</html>