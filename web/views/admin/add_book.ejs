<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= t('addBook.page_title') %>
    </title>
    <link rel="stylesheet" href="/css/add_book.css">
</head>

<body>

    <%- include('../layout/header') %>
    <main class="admin-form-page bg-pattern-books">
        <div class="container py-4">
            <div class="row justify-content-center">
                <div class="col-md-10 col-lg-8">
                    <div class="card brand-card">
                        <div class="card-header brand-card-header text-center">
                            <h2 class="mb-0 h3 fw-bold">
                                <i class="bi bi-book-half me-2"></i>
                                <%= t('addBook.title') %>
                            </h2>
                        </div>
                        <div class="card-body p-4">
                            <% if (locals.error) { %>
                                <div class="alert alert-danger border-0 shadow-sm">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <%= error %>
                                </div>
                                <% } %>

                                    <form action="/admin/books/create" method="POST" enctype="multipart/form-data">
                                        <div class="row">
                                            <div class="col-md-8 mb-3">
                                                <label for="title" class="form-label fw-bold">
                                                    <%= t('addBook.label_title') %> *
                                                </label>
                                                <input type="text" name="title" id="title" class="form-control"
                                                    value="<%= locals.bookData ? bookData.title : '' %>" required>
                                            </div>

                                            <div class="col-md-4 mb-3">
                                                <label for="isbn" class="form-label fw-bold">
                                                    <%= t('addBook.label_isbn') %>
                                                </label>
                                                <input type="text" name="isbn" id="isbn" class="form-control"
                                                    value="<%= locals.bookData ? bookData.isbn : '' %>">
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-3 mb-3">
                                                <label for="price" class="form-label fw-bold">
                                                    <%= t('addBook.label_price') %> *
                                                </label>
                                                <input type="number" step="0.01" name="price" id="price"
                                                    class="form-control"
                                                    value="<%= locals.bookData ? bookData.price : '' %>" required>
                                            </div>

                                            <div class="col-md-3 mb-3">
                                                <label for="stock" class="form-label fw-bold">
                                                    <%= t('addBook.label_stock') %> *
                                                </label>
                                                <input type="number" name="stock" id="stock" class="form-control"
                                                    value="<%= locals.bookData ? bookData.stock : '' %>" min="0"
                                                    required>
                                            </div>

                                            <div class="col-md-3 mb-3">
                                                <label for="releashed_year" class="form-label fw-bold">
                                                    <%= t('addBook.label_year') %>
                                                </label>
                                                <input type="number" name="releashed_year" id="releashed_year"
                                                    class="form-control"
                                                    value="<%= locals.bookData ? bookData.releashed_year : '' %>"
                                                    min="1000" max="2100">
                                            </div>

                                            <div class="col-md-3 mb-3">
                                                <label for="pages" class="form-label fw-bold">
                                                    <%= t('addBook.label_pages') %>
                                                </label>
                                                <input type="number" name="pages" id="pages" class="form-control"
                                                    value="<%= locals.bookData ? bookData.pages : '' %>" min="1">
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-4 mb-3">
                                                <label for="format" class="form-label fw-bold">
                                                    <%= t('addBook.label_format') %>
                                                </label>
                                                <select name="format" id="format" class="form-select">
                                                    <option value="">
                                                        <%= t('addBook.select_format') %>
                                                    </option>
                                                    <% ['Paperback', 'Hardcover' , 'eBook' , 'AudioBook' ].forEach(f=> {
                                                        %>
                                                        <option value="<%= f %>" <%=(locals.bookData &&
                                                            bookData.format===f) ? 'selected' : '' %>>
                                                            <%= f %>
                                                        </option>
                                                        <% }) %>
                                                </select>
                                            </div>

                                            <div class="col-md-4 mb-3">
                                                <label for="language" class="form-label fw-bold">
                                                    <%= t('addBook.label_language') %>
                                                </label>
                                                <input type="text" name="language" id="language" class="form-control"
                                                    value="<%= locals.bookData ? bookData.language : 'Español' %>">
                                            </div>

                                            <div class="col-md-4 mb-3">
                                                <label for="publisher_id" class="form-label fw-bold">
                                                    <%= t('addBook.label_publisher') %> *
                                                </label>
                                                <select name="publisher_id" id="publisher_id" class="form-select"
                                                    required>
                                                    <option value="">
                                                        <%= t('addBook.select_publisher') %>
                                                    </option>
                                                    <% publishers.forEach(pub=> { %>
                                                        <option value="<%= pub.id %>" <%=(locals.bookData &&
                                                            bookData.publisher_id==pub.id) ? 'selected' : '' %>>
                                                            <%= pub.name %>
                                                        </option>
                                                        <% }) %>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="synopsis" class="form-label fw-bold">
                                                <%= t('addBook.label_synopsis') %>
                                            </label>
                                            <textarea name="synopsis" id="synopsis" rows="4"
                                                class="form-control"><%= locals.bookData ? bookData.synopsis : '' %></textarea>
                                        </div>

                                        <div class="mb-3">
                                            <label for="author_ids" class="form-label fw-bold">
                                                <%= t('addBook.label_authors') %>
                                            </label>
                                            <select name="author_ids[]" id="author_ids" class="form-select" multiple
                                                size="5">
                                                <% authors.forEach(author=> { %>
                                                    <option value="<%= author.id %>" <%=(locals.bookData &&
                                                        bookData.author_ids &&
                                                        bookData.author_ids.includes(author.id.toString())) ? 'selected'
                                                        : '' %>>
                                                        <%= author.name %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                            <small class="text-muted">
                                                <%= t('addBook.multiple_help') %>
                                            </small>
                                        </div>

                                        <div class="mb-3">
                                            <label for="genre_ids" class="form-label fw-bold">
                                                <%= t('addBook.label_genres') %>
                                            </label>
                                            <select name="genre_ids[]" id="genre_ids" class="form-select" multiple
                                                size="5">
                                                <% genres.forEach(genre=> { %>
                                                    <option value="<%= genre.id %>" <%=(locals.bookData &&
                                                        bookData.genre_ids &&
                                                        bookData.genre_ids.includes(genre.id.toString())) ? 'selected'
                                                        : '' %>>
                                                        <%= genre.name %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                            <small class="text-muted">
                                                <%= t('addBook.multiple_help') %>
                                            </small>
                                        </div>

                                        <div class="mb-3">
                                            <label for="cover" class="form-label fw-bold">
                                                <%= t('addBook.label_cover') %>
                                            </label>
                                            <input type="file" name="cover" id="cover" class="form-control"
                                                accept="image/*">
                                        </div>

                                        <div class="d-flex justify-content-center gap-3 mt-4">
                                            <button type="submit" class="btn btn-brand-teal px-5 py-2 fw-bold rounded-pill">
                                                <i class="bi bi-plus-circle-fill me-2"></i>
                                                <%= t('addBook.btn_submit') %>
                                            </button>
                                            <a href="/admin/dashboard" class="btn btn-secondary px-4">
                                                <%= t('addUser.btn_cancel') %>
                                            </a>
                                        </div>
                                    </form>
                        </div>
                    </div>
                </div>
            </div>
            </div>
        </div>
    </main>

        <%- include('../layout/footer') %>

            <% if (locals.error) { %>
                <script>
                    document.addEventListener("DOMContentLoaded", () => {
                        if (typeof showModal === "function") {
                            showModal("error", "<%= error %>");
                        }
                    });
                </script>
                <% } %>

                    <% if (locals.success) { %>
                        <script>
                            document.addEventListener("DOMContentLoaded", () => {
                                if (typeof showModal === "function") {
                                    showModal("success", "<%= success %>");
                                }
                            });
                        </script>
                        <% } %>

</body>

</html>