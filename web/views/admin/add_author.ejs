<%- include('../layout/header', {
    title: t('addAuthor.page_title') || 'Añadir Autor',
    bodyClass: 'bg-admin-vistas',
    extraCSS: 'admin/add_author'
}) %>

<main class="py-5">
    <div class="container admin-form-container">
        <div class="mb-4">
            <a href="/authors/author/list" class="btn-back-form">
                <i class="bi bi-arrow-left me-2"></i>
                Volver a Autores
            </a>
        </div>
        <div class="brand-card">
            <div class="brand-card-header text-center">
                <h2 class="mb-0 fw-bold d-flex flex-column align-items-center gap-2">
                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center mx-auto" style="width: 80px; height: 80px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                        <i class="bi bi-person-plus-fill text-primary" style="font-size: 2.5rem;"></i>
                    </div>
                    <span class="mt-2"><%= t('addAuthor.title') || 'Registrar Nuevo Autor' %></span>
                </h2>
                <p class="text-white-50 mt-2 mb-0">Agrega un nuevo escritor u creador al catálogo público</p>
            </div>
            
            <div class="card-body p-4 p-md-5">
                <% if (locals.error) { %>
                    <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                        <div><%= error %></div>
                    </div>
                <% } %>

                <form action="/authors/author/create" method="POST" enctype="multipart/form-data" data-requires-token>
                    <div class="row g-4">
                        <div class="col-md-7">
                            <div class="mb-3">
                                <label for="name" class="form-label"><%= t('addAuthor.label_name') || 'Nombre Completo' %> *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-person text-muted"></i></span>
                                    <input type="text" name="name" id="name" class="form-control border-start-0 ps-0" placeholder="<%= t('addAuthor.placeholder_name') || 'Ej: Gabriel García Márquez' %>" required>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-5">
                            <div class="mb-3">
                                <label for="country" class="form-label"><%= t('addAuthor.label_country') || 'País de Origen' %></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-globe-americas text-muted"></i></span>
                                    <input type="text" name="country" id="country" class="form-control border-start-0 ps-0" placeholder="<%= t('addAuthor.placeholder_country') || 'Ej: Colombia' %>">
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="mb-3">
                                <label for="biography" class="form-label"><%= t('addAuthor.label_biography') || 'Biografía / Reseña' %></label>
                                <textarea name="biography" id="biography" rows="5" class="form-control" placeholder="<%= t('addAuthor.placeholder_biography') || 'Escribe sobre la vida, logros y trayectoria...' %>"></textarea>
                            </div>
                        </div>

                        <div class="col-12">
                            <hr class="my-3 opacity-10">
                            <div class="mb-4 p-4 rounded-4" style="background-color: #f8fafc; border: 1px dashed #cbd5e1;">
                                <label for="photo" class="form-label"><i class="bi bi-camera me-1"></i> <%= t('addAuthor.label_photo') || 'Fotografía de Perfil (Opcional)' %></label>
                                <input type="file" name="photo" id="photo" class="form-control bg-white" accept="image/*">
                                <small class="text-muted mt-2 d-block fw-medium"><%= t('addAuthor.photo_help') || 'Sube una imagen representativa del autor.' %></small>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center gap-3 mt-4 pt-4 border-top">
                        <a href="/admin/dashboard" class="btn btn-light px-4 py-2 rounded-pill fw-bold text-secondary border shadow-sm">
                            <%= t('addAuthor.btn_cancel') || 'Cancelar' %>
                        </a>
                        <button type="submit" class="btn btn-brand-teal px-5 py-2 fw-bold rounded-pill text-white shadow-sm d-flex align-items-center gap-2">
                            <i class="bi bi-plus-circle"></i>
                            <%= t('addAuthor.btn_submit') || 'Añadir Autor' %>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

<%- include("../layout/footer") %>