<%- include('../layout/header', { bodyClass: 'bg-main-vistas', extraCSS: 'admin/books_list' }) %>

    <div class="container py-5">
        <div class="text-center mb-5">
            <h2 class="section-title text-center">
                <%= t('catalog.title') %>
            </h2>
            <p class="text-muted">
                <%= t('catalog.subtitle') %>
            </p>
        </div>

        <div class="d-flex justify-content-end mb-4">
            <a href="/admin/books/create" class="btn btn-sm btn-outline-dark">
                <%= t('adminDashboard.btn_add') %>
            </a>
        </div>

        <div class="row">
            <aside class="col-lg-3 mb-4">
                <div class="filter-sidebar p-4 shadow-sm bg-light rounded-3">
                    <h5 class="mb-4 d-flex align-items-center border-bottom pb-2">
                        <i class="bi bi-sliders me-2"></i>
                        <%= t('catalog.filters') || 'Filtrar por' %>
                    </h5>

                    <form action="/admin/books/list" method="GET">
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase text-muted">Nombre del libro</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                                <input type="text" name="q" class="form-control border-start-0" placeholder="Buscar..."
                                    value="<%= query.q || '' %>">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase text-muted">Categoría</label>
                            <div class="scrollable-filter-container">
                                <div class="form-check small">
                                    <input class="form-check-input" type="radio" name="genre" id="genre_all" value=""
                                        <%=!query.genre ? 'checked' : '' %>>
                                    <label class="form-check-label" for="genre_all">
                                        <%= t('catalog.all_genres') || 'Todos los géneros' %>
                                    </label>
                                </div>
                                <% if (typeof genres !=='undefined' && genres) { %>
                                    <% genres.forEach(g=> { %>
                                        <div class="form-check small">
                                            <input class="form-check-input" type="radio" name="genre"
                                                id="genre_<%= g.id %>" value="<%= g.id %>" <%=query.genre==g.id
                                                ? 'checked' : '' %>>
                                            <label class="form-check-label" for="genre_<%= g.id %>">
                                                <%= g.name %>
                                            </label>
                                        </div>
                                        <% }) %>
                                            <% } %>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase text-muted">Autor</label>
                            <div class="scrollable-filter-container">
                                <div class="form-check small">
                                    <input class="form-check-input" type="radio" name="author" id="author_all" value=""
                                        <%=!query.author ? 'checked' : '' %>>
                                    <label class="form-check-label" for="author_all">
                                        Todos los autores
                                    </label>
                                </div>
                                <% if (typeof authors !=='undefined' && authors) { %>
                                    <% authors.forEach(a=> { %>
                                        <div class="form-check small">
                                            <input class="form-check-input" type="radio" name="author"
                                                id="author_<%= a.id %>" value="<%= a.id %>" <%=query.author==a.id
                                                ? 'checked' : '' %>>
                                            <label class="form-check-label" for="author_<%= a.id %>">
                                                <%= a.name %>
                                            </label>
                                        </div>
                                        <% }) %>
                                            <% } %>
                            </div>
                        </div>

                        <!-- <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase text-muted">
                                Precio máx: <span id="priceVal" class="text-success">
                                    <%= query.maxPrice || 100 %>
                                </span>€
                            </label>
                            <input type="range" name="maxPrice" class="form-range" min="0" max="150" step="5"
                                id="priceRange" value="<%= query.maxPrice || 100 %>"
                                oninput="document.getElementById('priceVal').innerText = this.value">
                        </div> -->

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase text-muted">Estado</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                    id="flexSwitchCheckChecked" name="deleted" value="true" <%=query.deleted ? 'checked'
                                    : '' %>>
                                <label class="form-check-label" for="flexSwitchCheckChecked">Mostrar solo libros
                                    eliminados</label>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-sm fw-bold">Aplicar</button>
                            <a href="/admin/books/list" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                        </div>
                    </form>
                </div>
            </aside>

            <main class="col-lg-9">
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
                    <% if (books && books.length> 0) { %>
                        <% books.forEach(book=> { %>
                            <div class="col">
                                <div class="card h-100 shadow-sm border-0 <%= book.deleted_at ? 'opacity-75 bg-light' : '' %>"
                                    style="<%= book.deleted_at ? 'border: 1px dashed #dee2e6 !important;' : '' %>">

                                    <% if (book.deleted_at) { %>
                                        <span class="position-absolute top-0 end-0 badge rounded-pill bg-secondary m-2">
                                            <i class="bi bi-archive"></i> Archivado
                                        </span>
                                        <% } %>

                                            <div class="book-img-container" style="position: relative;">
                                                <img src="<%= book.cover_url || '/images/default-cover.jpg' %>"
                                                    class="mh-100 mw-100" style="object-fit: contain;"
                                                    alt="<%= book.title %>">
                                            </div>

                                            <div class="card-body d-flex flex-column p-3">
                                                <h6 class="card-title fw-bold mb-1 text-dark"
                                                    style="font-size: 0.9rem; min-height: 2.7rem; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical;"
                                                    title="<%= book.title %>">
                                                    <%= book.title %>
                                                </h6>

                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                    <span class="badge bg-light text-dark border">
                                                        <%= book.price %>€
                                                    </span>
                                                    <small class="text-muted">ID: <%= book.id %></small>
                                                </div>

                                                <div class="mt-auto">
                                                    <div class="d-grid gap-2">
                                                        <% if (!book.deleted_at) { %>
                                                            <a href="/books/book/<%= book.id %>"
                                                                class="btn btn-outline-dark btn-sm">
                                                                <i class="bi bi-eye"></i> Ver Ficha
                                                            </a>

                                                            <div class="row g-2">
                                                                <div class="col-6">
                                                                    <a href="/books/edit/<%= book.id %>"
                                                                        class="btn btn-primary btn-sm w-100">
                                                                        <i class="bi bi-pencil-square"></i> Editar
                                                                    </a>
                                                                </div>
                                                                <div class="col-6">
                                                                    <form action="/books/delete/<%= book.id %>"
                                                                        method="POST"
                                                                        onsubmit="return confirm('¿Mover este libro a la papelera?')">
                                                                        <button type="submit"
                                                                            class="btn btn-outline-danger btn-sm w-100">
                                                                            <i class="bi bi-trash"></i> Borrar
                                                                        </button>
                                                                    </form>
                                                                </div>
                                                            </div>
                                                            <% } else { %>
                                                                <form action="/admin/books/restore/<%= book.id %>"
                                                                    method="POST" data-requires-token>
                                                                    <button type="submit"
                                                                        class="btn btn-success btn-sm w-100 py-2 fw-bold">
                                                                        <i class="bi bi-arrow-counterclockwise"></i>
                                                                        Restaurar Libro
                                                                    </button>
                                                                </form>

                                                                <!-- <form action="/books/hard-delete/<%= book.id %>"
                                                                    method="POST"
                                                                    onsubmit="return confirm('ATENCIÓN: Esto eliminará el libro permanentemente de la base de datos. Esta acción no se puede deshacer.')">
                                                                    <button type="submit"
                                                                        class="btn btn-link btn-sm w-100 text-danger text-decoration-none mt-1"
                                                                        style="font-size: 0.75rem;">
                                                                        Eliminar permanentemente
                                                                    </button>
                                                                </form> -->
                                                                <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div class="col-12 text-center py-5">
                                        <i class="bi bi-search display-1 text-muted"></i>
                                        <p class="mt-3 fs-5 text-muted">No se encontraron libros en esta sección.</p>
                                    </div>
                                    <% } %>
                </div>
            </main>
        </div>
    </div>

    <%- include('../layout/footer') %>