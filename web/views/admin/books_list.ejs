<%- include('../layout/header', { bodyClass: 'bg-admin-vistas' , extraCSS: 'admin/books_list' }) %>

    <div class="container py-5">
        <div class="admin-hero mb-5">
            <div class="admin-hero-content d-flex justify-content-between align-items-center flex-wrap gap-4">
                <div class="d-flex align-items-center gap-4">
                    <a href="/admin/dashboard" class="btn-back-admin">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <div>
                        <h2 class="mb-0 fw-bold" style="font-size: var(--fs-xl);">
                            <%= t('catalog.title') %>
                        </h2>
                        <p class="text-white opacity-75 mb-0" style="font-size: var(--fs-sm);">
                            <%= t('catalog.subtitle') %>
                        </p>
                    </div>
                </div>
                <a href="/admin/books/create"
                    class="btn btn-glass-white text-white rounded-pill px-4 py-2 fw-bold shadow-sm transition-all"
                    style="text-decoration: none; background: rgba(255,255,255,0.2); backdrop-filter: blur(5px); border: 1px solid rgba(255,255,255,0.3);">
                    <i class="bi bi-plus-lg me-2"></i> <%= t('admin.add_book') %>
                </a>
            </div>
        </div>

        <div class="row">
            <aside class="col-lg-3 mb-4">
                <div class="filter-sidebar p-4 shadow-sm bg-light rounded-3">
                    <h5 class="mb-4 d-flex align-items-center border-bottom pb-2">
                        <i class="bi bi-sliders me-2"></i>
                        <%= t('catalog.filters') || 'Filtrar por' %>
                    </h5>

                    <form action="/admin/books/list" method="GET">
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase text-muted"><%= t('catalog.search_by_name') || 'Nombre del libro' %></label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                                <input type="text" name="q" class="form-control border-start-0" placeholder="<%= t('common.search_placeholder') || 'Buscar...' %>"
                                    value="<%= query.q || '' %>">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase text-muted"><%= t('catalog.category') || 'Categoría' %></label>
                            <div class="scrollable-filter-container">
                                <div class="form-check small">
                                    <input class="form-check-input" type="radio" name="genre" id="genre_all" value=""
                                        <%=!query.genre ? 'checked' : '' %>>
                                    <label class="form-check-label" for="genre_all">
                                        <%= t('catalog.all_genres') || 'Todos los géneros' %>
                                    </label>
                                </div>
                                <% if (typeof genres !=='undefined' && genres) { %>
                                    <% genres.forEach(g=> { %>
                                        <div class="form-check small">
                                            <input class="form-check-input" type="radio" name="genre"
                                                id="genre_<%= g.id %>" value="<%= g.id %>" <%=query.genre==g.id
                                                ? 'checked' : '' %>>
                                            <label class="form-check-label" for="genre_<%= g.id %>">
                                                <%= g.name %>
                                            </label>
                                        </div>
                                        <% }) %>
                                            <% } %>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase text-muted"><%= t('book.author') || 'Autor' %></label>
                            <div class="scrollable-filter-container">
                                <div class="form-check small">
                                    <input class="form-check-input" type="radio" name="author" id="author_all" value=""
                                        <%=!query.author ? 'checked' : '' %>>
                                    <label class="form-check-label" for="author_all">
                                        <%= t('catalog.all_authors') || 'Todos los autores' %>
                                    </label>
                                </div>
                                <% if (typeof authors !=='undefined' && authors) { %>
                                    <% authors.forEach(a=> { %>
                                        <div class="form-check small">
                                            <input class="form-check-input" type="radio" name="author"
                                                id="author_<%= a.id %>" value="<%= a.id %>" <%=query.author==a.id
                                                ? 'checked' : '' %>>
                                            <label class="form-check-label" for="author_<%= a.id %>">
                                                <%= a.name %>
                                            </label>
                                        </div>
                                        <% }) %>
                                            <% } %>
                            </div>
                        </div>

                        <!-- <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase text-muted">
                                Precio máx: <span id="priceVal" class="text-success">
                                    <%= query.maxPrice || 100 %>
                                </span>€
                            </label>
                            <input type="range" name="maxPrice" class="form-range" min="0" max="150" step="5"
                                id="priceRange" value="<%= query.maxPrice || 100 %>"
                                oninput="document.getElementById('priceVal').innerText = this.value">
                        </div> -->

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase text-muted"><%= t('catalog.status') || 'Estado' %></label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                    id="flexSwitchCheckChecked" name="deleted" value="true" <%=query.deleted ? 'checked'
                                    : '' %>>
                                <label class="form-check-label" for="flexSwitchCheckChecked"><%= t('catalog.show_only_deleted_books') || 'Mostrar solo libros eliminados' %></label>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-sm fw-bold"><%= t('common.apply') || 'Aplicar' %></button>
                            <a href="/admin/books/list" class="btn btn-outline-secondary btn-sm"><%= t('catalog.clear') || 'Limpiar' %></a>
                        </div>
                    </form>
                </div>
            </aside>

            <main class="col-lg-9">
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
                    <% if (books && books.length> 0) { %>
                        <% books.forEach(book=> { %>
                            <div class="col">
                                <div class="card h-100 shadow-sm border-0 <%= book.deleted_at ? 'opacity-75 bg-light' : '' %>"
                                    style="<%= book.deleted_at ? 'border: 1px dashed #dee2e6 !important;' : '' %>">

                                    <% if (book.deleted_at) { %>
                                        <span class="position-absolute top-0 end-0 badge rounded-pill bg-secondary m-2">
                                            <i class="bi bi-archive"></i> <%= t('book.archived') %>
                                        </span>
                                        <% } %>

                                            <div class="book-img-container p-3"
                                                style="position: relative; height: 220px; display: flex; align-items: center; justify-content: center; background: #f8fafc;">
                                                <img src="<%= book.cover_url || '/images/default-cover.jpg' %>"
                                                    class="mh-100 mw-100 shadow-sm"
                                                    style="object-fit: contain; border-radius: 4px;"
                                                    alt="<%= book.title %>"
                                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                <div class="book-placeholder"
                                                    style="display: none; width: 100%; height: 100%; align-items: center; justify-content: center; background: #f1f5f9; color: #94a3b8;">
                                                    <i class="bi bi-book-half" style="font-size: 3rem;"></i>
                                                </div>
                                            </div>

                                            <div class="card-body d-flex flex-column p-3">
                                                <h6 class="card-title fw-bold mb-1 text-dark"
                                                    style="font-size: 0.9rem; min-height: 2.7rem; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical;"
                                                    title="<%= book.title %>">
                                                    <%= book.title %>
                                                </h6>

                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                    <span class="badge bg-light text-dark border">
                                                        <%= book.price %>€
                                                    </span>
                                                    <small class="text-muted">ID: <%= book.id %></small>
                                                </div>

                                                <div class="mt-auto">
                                                    <div class="d-grid gap-2">
                                                        <% if (!book.deleted_at) { %>
                                                            <a href="/books/book/<%= book.id %>"
                                                                class="btn btn-outline-dark btn-sm">
                                                                <i class="bi bi-eye"></i> <%= t('book.details_title') %>
                                                            </a>

                                                            <div class="row g-2">
                                                                <div class="col-6">
                                                                    <a href="/admin/books/update/<%= book.id %>"
                                                                        class="btn btn-primary btn-sm w-100 py-2 shadow-sm">
                                                                        <i class="bi bi-pencil-square me-1"></i> <%= t('admin.edit_book') %>
                                                                    </a>
                                                                </div>
                                                                <div class="col-6">
                                                                    <button type="button"
                                                                        class="btn btn-danger btn-sm w-100 py-2 shadow-sm"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#modalDeleteBook"
                                                                        data-action="/admin/books/delete/<%= book.id %>"
                                                                        data-name="<%= book.title %>">
                                                                        <i class="bi bi-trash me-1"></i> <%= t('admin.delete_book') %>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                            <% } else { %>
                                                                <form action="/admin/books/restore/<%= book.id %>"
                                                                    method="POST" data-requires-token>
                                                                    <button type="submit"
                                                                        class="btn btn-success btn-sm w-100 py-2 fw-bold">
                                                                        <i class="bi bi-arrow-counterclockwise"></i>
                                                                        Restaurar Libro
                                                                    </button>
                                                                </form>

                                                                <!-- <form action="/books/hard-delete/<%= book.id %>"
                                                                    method="POST"
                                                                    onsubmit="return confirm('ATENCIÓN: Esto eliminará el libro permanentemente de la base de datos. Esta acción no se puede deshacer.')">
                                                                    <button type="submit"
                                                                        class="btn btn-link btn-sm w-100 text-danger text-decoration-none mt-1"
                                                                        style="font-size: 0.75rem;">
                                                                        Eliminar permanentemente
                                                                    </button>
                                                                </form> -->
                                                                <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div class="col-12 text-center py-5">
                                        <i class="bi bi-search display-1 text-muted"></i>
                                        <p class="mt-3 fs-5 text-muted">No se encontraron libros en esta sección.</p>
                                    </div>
                                    <% } %>
                                        <!-- Paginación -->
                                        <% if (typeof totalPages !=='undefined' && totalPages> 1) {
                                            const getPageUrl = (p) => {
                                            const params = new URLSearchParams(query);
                                            params.set('page', p);
                                            return '?' + params.toString();
                                            };
                                            %>
                                            <div class="mt-5 mb-5 d-flex justify-content-center w-100">
                                                <nav aria-label="Navegación de libros">
                                                    <ul class="pagination pagination-sm mb-0">
                                                        <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                                                            <a class="page-link shadow-sm"
                                                                href="<%= getPageUrl(parseInt(currentPage) - 1) %>">
                                                                <i class="bi bi-chevron-left"></i>
                                                            </a>
                                                        </li>

                                                        <% let start=Math.max(1, currentPage - 2); let
                                                            end=Math.min(totalPages, start + 4); if (end - start < 4)
                                                            start=Math.max(1, end - 4); for(let i=start; i <=end; i++) {
                                                            %>
                                                            <li
                                                                class="page-item <%= currentPage == i ? 'active' : '' %>">
                                                                <a class="page-link shadow-sm"
                                                                    href="<%= getPageUrl(i) %>">
                                                                    <%= i %>
                                                                </a>
                                                            </li>
                                                            <% } %>

                                                                <li
                                                                    class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                                                                    <a class="page-link shadow-sm"
                                                                        href="<%= getPageUrl(parseInt(currentPage) + 1) %>">
                                                                        <i class="bi bi-chevron-right"></i>
                                                                    </a>
                                                                </li>
                                                    </ul>
                                                </nav>
                                            </div>
                                            <% } %>
            </main>
        </div>
    </div>

    <div class="modal fade" id="modalDeleteBook" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header border-0" style="background-color:#dc3545;">
                    <h5 class="modal-title fw-bold text-white">
                        <i class="bi bi-archive me-2"></i>Archivar libro
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <p class="mb-1">¿Archivar <strong id="deleteBookName"></strong>?</p>
                    <p class="text-muted small mb-0">El libro dejará de ser visible en el catálogo.</p>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form id="deleteBookForm" method="POST" data-requires-token style="display:inline;">
                        <button type="submit" class="btn btn-danger ms-2">Archivar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('modalDeleteBook').addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            document.getElementById('deleteBookName').textContent = btn.dataset.name;
            document.getElementById('deleteBookForm').action = btn.dataset.action;
        });
    </script>

    <%- include('../layout/footer') %>