<%- include('../layout/header', { bodyClass: 'bg-main-vistas' , extraCSS: 'admin/publishers_list' }) %>

    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h2 class="section-title mb-0" style="font-size: var(--fs-xl);">
                    <%= t('publishers.title') %>
                </h2>
                <p class="text-muted" style="font-size: var(--fs-sm);">
                    <%= t('publishers.subtitle') %>
                </p>
            </div>
            <a href="/publisher/create" class="btn btn-primary rounded-pill px-4 shadow-sm"
                style="background-color: var(--brand-teal); border: none;">
                <i class="fas fa-plus me-2"></i>Nueva Editorial
            </a>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            <% publishers.forEach(pub=> { %>

                <div class="col">
                    <div class="card h-100 p-4 <%= pub.deleted_at ? 'is-deleted' : '' %>">

                        <div class="admin-actions">
                            <a href="/publisher/edit/<%= pub.id %>" class="btn-admin btn-edit" title="Editar">
                                <i class="fas fa-edit"></i>
                            </a>

                            <% if(!pub.deleted_at) { %>
                                <button type="button" class="btn-admin btn-archive" title="Archivar"
                                    data-bs-toggle="modal" data-bs-target="#modalDeletePublisher"
                                    data-action="/publisher/delete/<%= pub.id %>" data-name="<%= pub.name %>">
                                    <i class="fas fa-archive"></i>
                                </button>
                                <% } else { %>
                                    <form action="/publisher/restore/<%= pub.id %>" method="POST" data-requires-token>
                                        <button type="submit" class="btn-admin btn-restore" title="Restaurar">
                                            <i class="fas fa-trash-restore"></i>
                                        </button>
                                    </form>
                                    <% } %>
                        </div>

                        <div class="card-body d-flex flex-column text-center">
                            <div class="publisher-logo-container">
                                <img src="<%= pub.image_url || '/images/default-publisher.jpg' %>" alt="Logo"
                                    class="img-fluid" style="max-height: 50px; object-fit: contain;">
                            </div>

                            <h5 class="card-title fw-bold mb-4">
                                <%= pub.name %>
                            </h5>

                            <div class="mt-auto">
                                <% if(!pub.deleted_at) { %>
                                    <a href="/publisher/<%= pub.id %>"
                                        class="btn btn-outline-primary btn-sm w-100 rounded-pill">
                                        <i class="fas fa-list-ul me-1"></i>
                                        <%= t('publishers.view_catalog') %>
                                    </a>
                                    <% } else { %>
                                        <span class="badge bg-secondary w-100 py-2 rounded-pill">
                                            <i class="fas fa-eye-slash me-1"></i> Archivada
                                        </span>
                                        <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
        </div>

        <div class="mt-5">
            <nav aria-label="Navegación de editoriales">
                <ul class="pagination pagination-sm justify-content-center">
                    <% const miRuta="/publisher/manage/list" ; %>

                        <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="<%= miRuta %>?page=<%= parseInt(currentPage) - 1 %>">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>

                        <% for(let i=1; i <=totalPages; i++) { %>
                            <li class="page-item <%= currentPage == i ? 'active' : '' %>">
                                <a class="page-link" href="<%= miRuta %>?page=<%= i %>">
                                    <%= i %>
                                </a>
                            </li>
                            <% } %>

                                <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="<%= miRuta %>?page=<%= parseInt(currentPage) + 1 %>">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                </ul>
            </nav>
        </div>
    </div>

    <%- include('../layout/footer') %>

        <!-- Modal: Archivar editorial -->
        <div class="modal fade" id="modalDeletePublisher" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content shadow-lg">
                    <div class="modal-header border-0" style="background-color:#dc3545;">
                        <h5 class="modal-title fw-bold text-white"><i class="fas fa-archive me-2"></i>Archivar editorial
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4 text-center">
                        <p class="mb-1">¿Archivar <strong id="deletePublisherName"></strong>?</p>
                        <p class="text-muted small">Sus libros también se ocultarán del catálogo.</p>
                    </div>
                    <div class="modal-footer border-0 justify-content-center pb-4">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <form id="deletePublisherForm" method="POST" data-requires-token style="display:inline;">
                            <button type="submit" class="btn btn-danger ms-2">Archivar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <script>
            document.getElementById('modalDeletePublisher').addEventListener('show.bs.modal', function (e) {
                const btn = e.relatedTarget;
                document.getElementById('deletePublisherName').textContent = btn.dataset.name;
                document.getElementById('deletePublisherForm').action = btn.dataset.action;
            });
        </script>