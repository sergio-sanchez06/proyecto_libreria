<%- include('../layout/header', { bodyClass: 'bg-admin-vistas' , extraCSS: 'admin/publishers_list' }) %>

    <div class="container py-5">
        <div class="admin-hero mb-5">
            <div class="admin-hero-content d-flex justify-content-between align-items-center flex-wrap gap-4">
                <div class="d-flex align-items-center gap-4">
                    <a href="/admin/dashboard" class="btn-back-admin">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <div>
                        <h2 class="mb-0 fw-bold" style="font-size: var(--fs-xl);">
                            <%= t('adminDashboard.card_publishers') %>
                        </h2>
                        <p class="text-white opacity-75 mb-0" style="font-size: var(--fs-sm);">
                            <%= t('admin.pub_title') %>
                        </p>
                    </div>
                </div>
                <a href="/publisher/create"
                    class="btn btn-glass-white text-white rounded-pill px-4 py-2 fw-bold shadow-sm transition-all"
                    style="text-decoration: none; background: rgba(255,255,255,0.2); backdrop-filter: blur(5px); border: 1px solid rgba(255,255,255,0.3);">
                    <i class="bi bi-plus-lg me-2"></i>
                    <%= t('admin.add_publisher') %>
                </a>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            <% publishers.forEach(pub=> { %>

                <div class="col">
                    <div class="card h-100 p-4 <%= pub.deleted_at ? 'is-deleted' : '' %>">

                        <div class="admin-actions">

                            <% if(!pub.deleted_at) { %>

                                <a href="/publisher/edit/<%= pub.id %>" class="btn-admin btn-edit" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <button type="button" class="btn-admin btn-archive" title="Archivar"
                                    data-bs-toggle="modal" data-bs-target="#modalDeletePublisher"
                                    data-action="/publisher/delete/<%= pub.id %>" data-name="<%= pub.name %>">
                                    <i class="bi bi-archive"></i>
                                </button>
                                <% } else { %>
                                    <form action="/publisher/restore/<%= pub.id %>" method="POST" data-requires-token>
                                        <button type="submit" class="btn-admin btn-restore" title="Restaurar">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    </form>
                                    <% } %>
                        </div>

                        <div class="card-body d-flex flex-column text-center pt-2">
                            <div class="publisher-logo-container mb-4">
                                <% if (pub.image_url) { %>
                                    <img src="<%= pub.image_url %>" alt="<%= pub.name %>"
                                        class="img-fluid publisher-logo"
                                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                    <div class="publisher-placeholder" style="display: none;">
                                        <i class="bi bi-building text-muted"></i>
                                    </div>
                                    <% } else { %>
                                        <div class="publisher-placeholder">
                                            <i class="bi bi-building text-muted"></i>
                                        </div>
                                        <% } %>
                            </div>

                            <h5 class="card-title fw-bold mb-4"
                                style="font-size: 1.1rem; min-height: 2.4em; display: flex; align-items: center; justify-content: center;">
                                <%= pub.name %>
                            </h5>

                            <div class="mt-auto">
                                <% if(!pub.deleted_at) { %>
                                    <a href="/publisher/<%= pub.id %>"
                                        class="btn btn-outline-primary btn-sm w-100 rounded-pill py-2">
                                        <i class="bi bi-list-ul me-1"></i>
                                        <%= t('publishers.view_catalog') %>
                                    </a>
                                    <% } else { %>
                                        <span class="badge bg-secondary w-100 py-2 rounded-pill">
                                            <i class="bi bi-eye-slash me-1"></i>
                                            <%= t('admin.deleted') %>
                                        </span>
                                        <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
        </div>

        <div class="mt-5">
            <nav aria-label="Navegación de editoriales">
                <ul class="pagination pagination-sm justify-content-center">
                    <% const miRuta="/publisher/manage/list" ; %>

                        <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="<%= miRuta %>?page=<%= parseInt(currentPage) - 1 %>">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        <% for(let i=1; i <=totalPages; i++) { %>
                            <li class="page-item <%= currentPage == i ? 'active' : '' %>">
                                <a class="page-link" href="<%= miRuta %>?page=<%= i %>">
                                    <%= i %>
                                </a>
                            </li>
                            <% } %>

                                <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="<%= miRuta %>?page=<%= parseInt(currentPage) + 1 %>">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                </ul>
            </nav>
        </div>
    </div>

    <%- include('../layout/footer') %>

        <!-- Modal: Archivar editorial -->
        <div class="modal fade" id="modalDeletePublisher" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content shadow-lg border-0 rounded-4">
                    <div class="modal-header border-0 text-white p-4"
                        style="background: linear-gradient(135deg, #dc3545, #b02a37); border-radius: 16px 16px 0 0;">
                        <h5 class="modal-title fw-bold">
                            <i class="bi bi-archive me-2"></i>
                            <%= t('admin.delete_publisher') %>
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body p-4 text-center">
                        <p class="mb-1">
                            <%= t('admin.pub_del_title') %> <strong id="deletePublisherName"></strong>
                        </p>
                        <p class="text-muted small mb-0">
                            <%= t('admin.pub_del_body') %>
                        </p>
                    </div>

                    <div class="modal-footer border-0 justify-content-center pb-4">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">
                            <%= t('admin.cancel') || 'Cancelar' %>
                        </button>
                        <form id="deletePublisherForm" method="POST" data-requires-token style="display:inline;">
                            <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                                <%= t('admin.delete_publisher') %>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <script>
            document.getElementById('modalDeletePublisher').addEventListener('show.bs.modal', function (e) {
                const btn = e.relatedTarget;
                document.getElementById('deletePublisherName').textContent = btn.dataset.name;
                document.getElementById('deletePublisherForm').action = btn.dataset.action;
            });
        </script>