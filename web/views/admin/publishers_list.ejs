<%- include('../layout/header', { bodyClass: 'bg-main-vistas' }) %>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

        body {
            font-family: 'Inter', sans-serif;
        }

        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(252, 250, 247, 0.45);
            z-index: -1;
        }

        .section-title {
            font-weight: 800;
            color: var(--brand-teal);
            position: relative;
            padding-bottom: 8px;
            margin-bottom: 2rem;
        }

        .card {
            border: none;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(8px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
            transition: all 0.3s ease;
            overflow: hidden;
            position: relative;
        }

        .card.is-deleted {
            opacity: 0.7;
            filter: grayscale(0.7);
            border: 2px dashed #adb5bd;
        }

        /* --- BOTONES DE ADMINISTRACIÓN MEJORADOS --- */
        .admin-actions {
            position: absolute;
            top: 15px;
            right: 15px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            z-index: 10;
        }

        .btn-admin {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            cursor: pointer;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            background: white;
            text-decoration: none;
            font-size: 14px;
        }

        /* Colores y Hover para feedback funcional */
        .btn-edit {
            color: #0d6efd;
        }

        .btn-edit:hover {
            background: #0d6efd;
            color: white;
            transform: scale(1.1);
        }

        .btn-archive {
            color: #dc3545;
        }

        .btn-archive:hover {
            background: #dc3545;
            color: white;
            transform: scale(1.1);
        }

        .btn-restore {
            color: #198754;
        }

        .btn-restore:hover {
            background: #198754;
            color: white;
            transform: scale(1.1);
        }

        .publisher-logo-container {
            width: 80px;
            height: 80px;
            margin: 0 auto 1.5rem;
            background: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        }

        /* Estilos del Paginador */
        .pagination .page-link {
            border: none;
            border-radius: 8px;
            margin: 0 3px;
            color: #2c3e50;
            padding: 8px 16px;
            transition: all 0.2s;
        }

        .pagination .page-item.active .page-link {
            background: var(--brand-teal, #2c3e50);
            color: white;
        }
    </style>

    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h2 class="section-title mb-0">
                    <%= t('publishers.title') %>
                </h2>
                <p class="text-muted">
                    <%= t('publishers.subtitle') %>
                </p>
            </div>
            <a href="/publisher/create" class="btn btn-primary rounded-pill px-4 shadow-sm"
                style="background-color: var(--brand-teal); border: none;">
                <i class="fas fa-plus me-2"></i>Nueva Editorial
            </a>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            <% publishers.forEach(pub=> { %>

                <div class="col">
                    <div class="card h-100 p-4 <%= pub.deleted_at ? 'is-deleted' : '' %>">

                        <div class="admin-actions">
                            <a href="/publisher/edit/<%= pub.id %>" class="btn-admin btn-edit" title="Editar">
                                <i class="fas fa-edit"></i>
                            </a>

                            <% if(!pub.deleted_at) { %>
                                <form action="/publisher/delete/<%= pub.id %>" method="POST"
                                    onsubmit="return confirm('¿Archivar esta editorial? Sus libros también se ocultarán.')">
                                    <button type="submit" class="btn-admin btn-archive" title="Archivar">
                                        <i class="fas fa-archive"></i>
                                    </button>
                                </form>
                                <% } else { %>
                                    <form action="/publisher/restore/<%= pub.id %>" method="POST" data-requires-token>
                                        <button type="submit" class="btn-admin btn-restore" title="Restaurar">
                                            <i class="fas fa-trash-restore"></i>
                                        </button>
                                    </form>
                                    <% } %>
                        </div>

                        <div class="card-body d-flex flex-column text-center">
                            <div class="publisher-logo-container">
                                <img src="<%= pub.image_url || '/images/default-publisher.jpg' %>" alt="Logo"
                                    class="img-fluid" style="max-height: 50px; object-fit: contain;">
                            </div>

                            <h5 class="card-title fw-bold mb-4">
                                <%= pub.name %>
                            </h5>

                            <div class="mt-auto">
                                <% if(!pub.deleted_at) { %>
                                    <a href="/publisher/<%= pub.id %>"
                                        class="btn btn-outline-primary btn-sm w-100 rounded-pill">
                                        <i class="fas fa-list-ul me-1"></i>
                                        <%= t('publishers.view_catalog') %>
                                    </a>
                                    <% } else { %>
                                        <span class="badge bg-secondary w-100 py-2 rounded-pill">
                                            <i class="fas fa-eye-slash me-1"></i> Archivada
                                        </span>
                                        <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
        </div>

        <div class="mt-5">
            <nav aria-label="Navegación de editoriales">
                <ul class="pagination pagination-sm justify-content-center">
                    <% const miRuta="/publisher/manage/list" ; %>

                        <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="<%= miRuta %>?page=<%= parseInt(currentPage) - 1 %>">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>

                        <% for(let i=1; i <=totalPages; i++) { %>
                            <li class="page-item <%= currentPage == i ? 'active' : '' %>">
                                <a class="page-link" href="<%= miRuta %>?page=<%= i %>">
                                    <%= i %>
                                </a>
                            </li>
                            <% } %>

                                <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="<%= miRuta %>?page=<%= parseInt(currentPage) + 1 %>">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                </ul>
            </nav>
        </div>
    </div>

    <%- include('../layout/footer') %>