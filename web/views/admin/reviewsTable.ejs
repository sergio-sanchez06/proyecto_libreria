<%- include("../layout/header", { 
    bodyClass: 'bg-admin-vistas',
    extraCSS: 'admin/reviewsTable'
}) %>

    <main class="py-5">
        <div class="container">
            <!-- ── Hero Section ────────────────────────────── -->
            <div class="admin-hero mb-4">
                <div class="admin-hero-content row align-items-center">
                    <div class="col-md-8">
                        <h1 class="display-5 fw-bold mb-2"><%= t('admin_reviews.page_title', 'Gestión de Reseñas') %></h1>
                        <p class="lead opacity-75 mb-0"><%= t('admin_reviews.subtitle', 'Modera y supervisa las opiniones de los lectores.') %></p>
                    </div>
                    <div class="col-md-4 text-md-end mt-3 mt-md-0">
                        <a href="/admin/dashboard" class="btn-back-admin">
                            <i class="bi bi-arrow-left me-2"></i><%= t('admin_reviews.back_to_dashboard', 'Volver al Dashboard') %>
                        </a>
                    </div>
                </div>
            </div>

            <!-- ── Stat Cards ──────────────────────────────── -->
            <div class="row g-4 mb-5">
                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-icon bg-primary-subtle text-primary">
                            <i class="bi bi-chat-left-text"></i>
                        </div>
                        <div class="stat-value"><%= stats.total %></div>
                        <div class="stat-label"><%= t('admin_reviews.total_reviews', 'Reseñas Totales') %></div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-icon bg-warning-subtle text-warning">
                            <i class="bi bi-star-fill"></i>
                        </div>
                        <div class="stat-value"><%= stats.average %></div>
                        <div class="stat-label"><%= t('admin_reviews.average_rating', 'Puntuación Media') %></div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-icon bg-success-subtle text-success">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <div class="stat-value"><%= t('admin_reviews.active_status', 'Activo') %></div>
                        <div class="stat-label"><%= t('admin_reviews.system_status', 'Estado del Sistema') %></div>
                    </div>
                </div>
            </div>

            <!-- ── Table ───────────────────────────────────── -->
            <div class="reviews-table-wrap">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4"><%= t('admin_reviews.th_id', 'ID') %></th>
                                <th><%= t('admin_reviews.th_book', 'Libro') %></th>
                                <th><%= t('admin_reviews.th_user', 'Usuario') %></th>
                                <th><%= t('admin_reviews.th_rating', 'Puntuación') %></th>
                                <th><%= t('admin_reviews.th_comment', 'Comentario') %></th>
                                <th><%= t('admin_reviews.th_date', 'Fecha') %></th>
                                <th class="text-end pe-4"><%= t('admin_reviews.th_actions', 'Acciones') %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (reviews && reviews.length > 0) { %>
                                <% reviews.forEach(review => { %>
                                    <tr>
                                        <td class="ps-4 text-muted small fw-bold">#<%= review.id %></td>
                                        <td>
                                            <div class="fw-bold text-dark"><%= review.book_title %></div>
                                            <div class="text-muted small">ID: <%= review.book_id %></div>
                                        </td>
                                        <td>
                                            <div class="user-info-box">
                                                <div class="avatar-sm"><%= review.user_email.charAt(0).toUpperCase() %></div>
                                                <span class="small text-truncate" style="max-width: 150px;" title="<%= review.user_email %>">
                                                    <%= review.user_email %>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="star-rating">
                                                <% for(let i=0; i<5; i++) { %>
                                                    <i class="bi bi-star-fill <%= i < review.rating ? '' : 'star-muted' %>"></i>
                                                <% } %>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="comment-text" title="<%= review.comment %>">
                                                <%= review.comment %>
                                            </div>
                                        </td>
                                        <td class="small text-muted text-nowrap">
                                            <%= new Date(review.created_at).toLocaleDateString() %>
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end gap-2">
                                                <a href="/books/book/<%= review.book_id %>" class="btn-action" title="<%= t('admin_reviews.btn_view_book', 'Ver Libro') %>">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <button type="button" class="btn-action" 
                                                        onclick="openEditModal('<%= review.id %>', '<%= review.rating %>', this.getAttribute('data-comment'), '<%= review.book_id %>')"
                                                        data-comment="<%= review.comment %>" title="<%= t('admin_reviews.btn_edit', 'Editar') %>">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button type="button" class="btn-action btn-delete" 
                                                        onclick="openDeleteModal('<%= review.id %>')" title="<%= t('admin_reviews.btn_delete', 'Eliminar') %>">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div class="opacity-25 mb-3">
                                            <i class="bi bi-chat-square-dots" style="font-size: 4rem;"></i>
                                        </div>
                                        <p class="text-muted h5"><%= t('admin_reviews.no_reviews', 'No se encontraron reseñas.') %></p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ── Paginación ─────────────────────────────────── -->
            <% if (totalPages > 1) { %>
                <nav class="mt-5 d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <span class="text-muted small fw-bold text-uppercase">
                        <%= t('admin_reviews.page', 'Página') %> <strong><%= currentPage %></strong> <%= t('admin_reviews.of', 'de') %> <strong><%= totalPages %></strong>
                        &nbsp;·&nbsp; <strong><%= stats.total %></strong> <%= t('admin_reviews.reviews_count', 'reseñas') %>
                    </span>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="/admin/reviews?page=<%= parseInt(currentPage) - 1 %>">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        <% for (let p = 1; p <= totalPages; p++) { %>
                            <% if (totalPages <= 7 || p === 1 || p === totalPages || Math.abs(p - currentPage) <= 1) { %>
                                <li class="page-item <%= currentPage == p ? 'active' : '' %>">
                                    <a class="page-link" href="/admin/reviews?page=<%= p %>">
                                        <%= p %>
                                    </a>
                                </li>
                            <% } else if (Math.abs(p - currentPage) === 2) { %>
                                <li class="page-item disabled"><span class="page-link bg-transparent border-0">…</span></li>
                            <% } %>
                        <% } %>
                        <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="/admin/reviews?page=<%= parseInt(currentPage) + 1 %>">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            <% } %>
        </div>
    </main>

    <!-- Modal Editar -->
    <div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header modal-header-primary text-white border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i><%= t('admin_reviews.modal_edit_title', 'Moderación de Reseña') %></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="editReviewForm" method="POST">
                    <div class="modal-body p-4">
                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small text-uppercase"><%= t('admin_reviews.label_rating', 'Puntuación') %></label>
                            <select name="rating" id="editRating" class="form-select border-0 bg-light py-3">
                                <option value="1">1 <%= t('admin_reviews.star_singular', 'Estrella') %></option>
                                <option value="2">2 <%= t('admin_reviews.star_plural', 'Estrellas') %></option>
                                <option value="3">3 <%= t('admin_reviews.star_plural', 'Estrellas') %></option>
                                <option value="4">4 <%= t('admin_reviews.star_plural', 'Estrellas') %></option>
                                <option value="5">5 <%= t('admin_reviews.star_plural', 'Estrellas') %></option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-bold text-muted small text-uppercase"><%= t('admin_reviews.label_comment', 'Comentario') %></label>
                            <textarea name="comment" id="editComment" class="form-control border-0 bg-light" rows="4" required></textarea>
                        </div>
                        <input type="hidden" name="review_id" id="editReviewId">
                        <input type="hidden" name="book_id" id="book_id">
                        <input type="hidden" name="returnTo" id="editReturnTo">
                    </div>
                    <div class="modal-footer border-0 p-4 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal"><%= t('admin_reviews.btn_cancel', 'Cancelar') %></button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm" style="background: var(--brand-teal); border: none;"><%= t('admin_reviews.btn_save', 'Guardar Cambios') %></button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Eliminar -->
    <div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger text-white border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= t('admin_reviews.modal_delete_title', 'Eliminar Reseña') %></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-5 text-center">
                    <div class="mb-4">
                        <i class="bi bi-trash3 text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h4 class="fw-bold"><%= t('admin_reviews.modal_delete_confirm', '¿Estás seguro?') %></h4>
                    <p class="text-muted"><%= t('admin_reviews.modal_delete_warning', 'Esta acción eliminará permanentemente la reseña y no se podrá recuperar.') %></p>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-5 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal"><%= t('admin_reviews.btn_cancel', 'Cancelar') %></button>
                    <form id="deleteForm" method="POST">
                        <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm"><%= t('admin_reviews.btn_confirm_delete', 'Confirmar Eliminación') %></button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <%- include("../layout/footer") %>

    <script>
        const bDeleteModal = new bootstrap.Modal(document.getElementById('modalEliminar'));
        const bEditModal = new bootstrap.Modal(document.getElementById('modalEditar'));

        const deleteForm = document.getElementById('deleteForm');
        const editForm = document.getElementById('editReviewForm');
        const editRating = document.getElementById('editRating');
        const editComment = document.getElementById('editComment');
        const book_id_review = document.getElementById('book_id');
        const editReturnTo = document.getElementById('editReturnTo');

        function openDeleteModal(id) {
            deleteForm.action = `/admin/review/delete/${id}`;
            bDeleteModal.show();
        }

        function openEditModal(id, rating, comment, book_id) {
            editForm.action = `/admin/review/update/${id}`;
            editRating.value = rating;
            editComment.value = comment;
            book_id_review.value = book_id;
            editReturnTo.value = "<%= currentUrl %>";
            bEditModal.show();
        }
    </script>