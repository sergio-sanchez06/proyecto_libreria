<%- include('../layout/header', {
    title: t('editGenre.page_title') || 'Editar Género' + ' - ' + genre.name,
    bodyClass: 'bg-admin-vistas',
    extraCSS: 'admin/edit_genre'
}) %>

<main class="py-5">
    <div class="container admin-form-container">
        <div class="mb-4">
            <a href="/admin/genres/list" class="btn-back-form">
                <i class="bi bi-arrow-left me-2"></i> Volver a Géneros
            </a>
        </div>
        <div class="brand-card">
            <div class="brand-card-header text-center">
                <h2 class="mb-0 fw-bold d-flex flex-column align-items-center gap-2">
                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center mx-auto" style="width: 80px; height: 80px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                        <i class="bi bi-tag-fill text-warning fs-1"></i>
                    </div>
                    <span class="mt-2"><%= t('editGenre.title') || 'Editar Categoría' %></span>
                </h2>
                <p class="text-white-50 mt-2 mb-0">Renombra o ajusta los detalles de este género literario</p>
            </div>
            
            <div class="card-body p-4 p-md-5">
                <% if (locals.error) { %>
                    <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                        <div><%= error %></div>
                    </div>
                <% } %>

                <form action="/genres/update/<%= genre.id %>" method="POST" data-requires-token>
                    <input type="hidden" name="id" value="<%= genre.id %>">
                    
                    <div class="mb-4">
                        <label for="name" class="form-label"><i class="bi bi-fonts me-1"></i> <%= t('addGenre.label_name') || 'Nombre de la Categoría' %> *</label>
                        <input type="text" name="name" id="name" value="<%= genre.name %>" class="form-control form-control-lg" placeholder="<%= t('addGenre.placeholder_name') || 'Ej: Ciencia Ficción' %>" required>
                        <small class="text-muted mt-2 d-block fw-medium"><%= t('editGenre.help_text') || 'Este nombre aparecerá en la navegación y tags de los libros.' %></small>
                    </div>

                    <div class="d-flex justify-content-center gap-3 mt-5 pt-4 border-top">
                        <a href="/admin/dashboard" class="btn btn-light px-4 py-2 rounded-pill fw-bold text-secondary border shadow-sm">
                            <%= t('addAuthor.btn_cancel') || 'Cancelar' %>
                        </a>
                        <button type="submit" class="btn btn-brand-teal px-5 py-2 fw-bold rounded-pill text-white shadow-sm d-flex align-items-center gap-2">
                            <i class="bi bi-save2"></i>
                            <%= t('editAuthor.btn_save') || 'Guardar Cambios' %>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

<%- include("../layout/footer") %>