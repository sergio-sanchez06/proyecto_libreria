<!DOCTYPE html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('addPublisher.page_title') %></title>
    <link rel="stylesheet" href="/css/add_genre.css">
</head>

<body>

    <%- include ("../layout/header") %>

    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-header text-white" style="background-color: #006d33;">
                        <h2 class="mb-0 h4"><%= t('addPublisher.title') %></h2>
                    </div>
                    <div class="card-body p-4">
                        <% if (locals.error) { %>
                            <div class="alert alert-danger border-0 shadow-sm">
                                <i class="bi bi-exclamation-circle me-2"></i><%= error %>
                            </div>
                        <% } %>

                        <form action="/publisher/create" method="POST" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label for="name" class="form-label fw-bold"><%= t('addPublisher.label_name') %> *</label>
                                <input type="text" name="name" id="name" class="form-control" required>
                            </div>

                            <div class="mb-3">
                                <label for="country" class="form-label fw-bold"><%= t('addPublisher.label_country') %></label>
                                <input type="text" name="country" id="country" class="form-control">
                            </div>

                            <div class="mb-3">
                                <label for="website" class="form-label fw-bold"><%= t('addPublisher.label_website') %></label>
                                <input type="url" name="website" id="website" class="form-control"
                                    placeholder="https://ejemplo.com">
                            </div>

                            <div class="mb-3">
                                <label for="description" class="form-label fw-bold"><%= t('addPublisher.label_description') %></label>
                                <textarea name="description" id="description" rows="6" class="form-control"></textarea>
                            </div>

                            <div class="mb-3">
                                <label for="publisher_logo" class="form-label fw-bold"><%= t('addPublisher.label_logo') %></label>
                                <input type="file" name="publisher_logo" id="publisher_logo"
                                    class="form-control" accept="image/*">
                                <small class="form-text text-muted"><%= t('addPublisher.logo_help') %></small>
                            </div>

                            <div class="d-flex justify-content-center gap-2 mt-4">
                                <button type="submit" class="btn text-white px-4" style="background-color: #006d33;">
                                    <%= t('addPublisher.btn_submit') %>
                                </button>
                                <a href="/admin/dashboard" class="btn btn-secondary px-4">
                                    <%= t('addAuthor.btn_cancel') %>
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include ("../layout/footer") %>

</body>

</html>