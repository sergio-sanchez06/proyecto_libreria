<%- include('../layout/header', { 
    title: t('addPublisher.page_title') || 'Añadir Editorial',
    bodyClass: 'bg-admin-vistas',
    extraCSS: 'admin/add_publisher'
}) %>

    <main class="py-5">
        <div class="container admin-form-container">

            <div class="mb-4">
                <a href="/admin/dashboard"
                    class="btn btn-outline-dark rounded-pill px-4 py-2 fw-bold shadow-sm bg-white">
                    <i class="bi bi-arrow-left me-2"></i>
                    <%= t('admin.btn_return') || 'Volver al Dashboard' %>
                </a>
            </div>

            <div class="brand-card">
                <div class="brand-card-header text-center">
                    <h2 class="mb-0 fw-bold d-flex flex-column align-items-center gap-2">
                        <div class="bg-white rounded-circle d-flex align-items-center justify-content-center mx-auto"
                            style="width: 80px; height: 80px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                            <i class="bi bi-building-add text-primary" style="font-size: 2.5rem;"></i>
                        </div>
                        <span class="mt-2">
                            <%= t('addPublisher.title') || 'Registrar Editorial' %>
                        </span>
                    </h2>
                    <p class="text-white-50 mt-2 mb-0">Agrega una nueva empresa publicadora al sistema</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <% if (locals.error) { %>
                        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                            <div>
                                <%= error %>
                            </div>
                        </div>
                        <% } %>

                            <form action="/publisher/create" method="POST" enctype="multipart/form-data"
                                data-requires-token>
                                <div class="row g-4">
                                    <div class="col-md-7">
                                        <div class="mb-3">
                                            <label for="name" class="form-label">
                                                <%= t('addPublisher.label_name') || 'Nombre Editorial' %> *
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0"><i
                                                        class="bi bi-building-fill text-muted"></i></span>
                                                <input type="text" name="name" id="name"
                                                    class="form-control border-start-0 ps-0"
                                                    placeholder="Ej: Penguin Random House" required>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-5">
                                        <div class="mb-3">
                                            <label for="country" class="form-label">
                                                <%= t('addPublisher.label_country') || 'País' %>
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0"><i
                                                        class="bi bi-geo-alt-fill text-muted"></i></span>
                                                <input type="text" name="country" id="country"
                                                    class="form-control border-start-0 ps-0" placeholder="Ej: España">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="mb-3">
                                            <label for="website" class="form-label">
                                                <%= t('addPublisher.label_website') || 'Sitio Web Oficial' %>
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0"><i
                                                        class="bi bi-globe text-muted"></i></span>
                                                <input type="url" name="website" id="website"
                                                    class="form-control border-start-0 ps-0"
                                                    placeholder="https://ejemplo.com">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="mb-3">
                                            <label for="descripcion" class="form-label">
                                                <%= t('addPublisher.label_description') || 'Descripción' %>
                                            </label>
                                            <textarea name="descripcion" id="descripcion" rows="5" class="form-control"
                                                placeholder="Acerca de la editorial..."></textarea>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <hr class="my-3 opacity-10">
                                        <div class="mb-4 p-4 rounded-4"
                                            style="background-color: #f8fafc; border: 1px dashed #cbd5e1;">
                                            <label for="publisher_logo" class="form-label"><i
                                                    class="bi bi-image me-1"></i>
                                                <%= t('addPublisher.label_logo') || 'Logo de la Editorial (Opcional)' %>
                                            </label>
                                            <input type="file" name="publisher_logo" id="publisher_logo"
                                                class="form-control bg-white" accept="image/*">
                                            <small class="text-muted mt-2 d-block fw-medium">
                                                <%= t('addPublisher.logo_help')
                                                    || 'Se recomienda enviar un logo de formato cuadrado o transparente.'
                                                    %>
                                            </small>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-center gap-3 mt-4 pt-4 border-top">
                                    <a href="/admin/dashboard"
                                        class="btn btn-light px-4 py-2 rounded-pill fw-bold text-secondary border shadow-sm">
                                        <%= t('addAuthor.btn_cancel') || 'Cancelar' %>
                                    </a>
                                    <button type="submit"
                                        class="btn btn-brand-teal px-5 py-2 fw-bold rounded-pill text-white shadow-sm d-flex align-items-center gap-2">
                                        <i class="bi bi-plus-circle-fill"></i>
                                        <%= t('addPublisher.btn_submit') || 'Añadir Editorial' %>
                                    </button>
                                </div>
                            </form>
                </div>
            </div>
        </div>
    </main>

    <%- include("../layout/footer") %>