<%- include('../layout/header', { bodyClass: 'bg-admin-vistas' , extraCSS: 'admin/users_list' }) %>

    <main class="container py-5">
        <div class="admin-hero mb-5">
            <div class="admin-hero-content d-flex justify-content-between align-items-center flex-wrap gap-4">
                <div class="d-flex align-items-center gap-4">
                    <a href="/admin/dashboard" class="btn-back-admin">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <div>
                        <h2 class="mb-0 fw-bold" style="font-size: var(--fs-xl);">
                            <%= t('adminUsersList.title') %>
                        </h2>
                        <p class="text-white opacity-75 mb-0" style="font-size: var(--fs-sm);">
                            <%= t('adminUsersList.subtitle') %>
                        </p>
                    </div>
                </div>
                <a href="/admin/users/create" class="btn btn-glass-white text-white rounded-pill px-4 py-2 fw-bold shadow-sm transition-all"
                    style="text-decoration: none; background: rgba(255,255,255,0.2); backdrop-filter: blur(5px); border: 1px solid rgba(255,255,255,0.3);">
                    <i class="bi bi-person-plus-fill me-2"></i>
                    <%= t('adminUsersList.btn_new') %>
                </a>
            </div>
        </div>

        <% if (locals.message) { %>
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4 rounded-3 p-3"
                role="alert">
                <div class="d-flex align-items-center">
                    <div class="bg-success text-white rounded-circle p-2 me-3 d-flex align-items-center justify-content-center"
                        style="width: 32px; height: 32px;">
                        <i class="bi bi-check-lg fs-6"></i>
                    </div>
                    <div class="fw-medium">
                        <%= message %>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>

                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-white py-3 px-4 border-bottom">
                        <div class="row align-items-center">
                            <div class="col">
                                <h5 class="mb-0 fw-bold text-dark">
                                    <%= t('adminUsersList.list_title') %>
                                </h5>
                            </div>
                            <div class="col text-end">
                                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">
                                    <i class="bi bi-person-check me-1"></i>
                                    <%= users.length %>
                                        <%= t('adminUsersList.registered_count') %>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle">
                                <thead class="bg-light-subtle">
                                    <tr>
                                        <th class="ps-4 py-3 text-uppercase fw-semibold text-muted"
                                            style="font-size: 0.75rem;">
                                            <%= t('adminUsersList.th_user') %>
                                        </th>
                                        <th class="py-3 text-uppercase fw-semibold text-muted"
                                            style="font-size: 0.75rem;">
                                            <%= t('adminUsersList.th_email') %>
                                        </th>
                                        <th class="py-3 text-uppercase fw-semibold text-muted"
                                            style="font-size: 0.75rem;">
                                            <%= t('adminUsersList.th_role') %>
                                        </th>
                                        <th class="py-3 text-uppercase fw-semibold text-muted text-center"
                                            style="font-size: 0.75rem;">
                                            <%= t('adminUsersList.th_actions') %>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% users.forEach(user=> { %>
                                        <tr class="<%= user.deleted_at ? 'opacity-50 bg-light' : '' %>">
                                            <td class="ps-4 py-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-sm me-3 bg-primary-subtle text-primary rounded-3 d-flex align-items-center justify-content-center"
                                                        style="width: 42px; height: 42px; font-weight: 600;">
                                                        <%= user.name.charAt(0).toUpperCase() %>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold text-dark">
                                                            <%= user.name %>
                                                                <% if (user.deleted_at) { %>
                                                                    <span class="badge bg-secondary ms-1"
                                                                        style="font-size: 0.6rem;">DESHABILITADO</span>
                                                                    <% } %>
                                                        </div>
                                                        <small class="text-muted d-block" style="font-size: 0.7rem;">ID:
                                                            #<%= user.id %></small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><span class="text-dark">
                                                    <%= user.email %>
                                                </span></td>
                                            <td>
                                                <% if (user.role==='ADMIN' ) { %>
                                                    <span
                                                        class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 fw-semibold">
                                                        <i class="bi bi-shield-check me-1"></i>
                                                        <%= t('adminUsersList.role_admin') %>
                                                    </span>
                                                    <% } else { %>
                                                        <span
                                                            class="badge rounded-pill bg-info-subtle text-info border border-info-subtle px-3 py-1 fw-semibold">
                                                            <i class="bi bi-person me-1"></i>
                                                            <%= t('adminUsersList.role_client') %>
                                                        </span>
                                                        <% } %>
                                            </td>
                                            <td class="pe-4 text-center">
                                                <div class="d-flex justify-content-center gap-2">
                                                    <% if (user.role !=='ADMIN' && !user.email.includes('deleted')) { %>

                                                        <a href="/admin/users/update/<%= user.id %>"
                                                            class="btn btn-white btn-sm px-3 hover-bg-light border shadow-sm"
                                                            title="<%= t('adminUsersList.btn_edit') %>">
                                                            <i class="bi bi-pencil-square text-primary"></i>
                                                        </a>

                                                        <% if (user.deleted_at) { %>
                                                            <form action="/admin/users/reactivate/<%= user.id %>"
                                                                method="POST" data-requires-token
                                                                onsubmit="return confirmReactivate(event, '<%= user.name %>')"
                                                                class="d-inline">
                                                                <input type="hidden" name="id" value="<%= user.id %>">
                                                                <button type="submit"
                                                                    class="btn btn-white btn-sm px-3 border shadow-sm"
                                                                    title="Restaurar acceso">
                                                                    <i class="bi bi-person-check-fill text-success"></i>
                                                                </button>
                                                            </form>

                                                            <form action="/admin/users/delete/<%= user.id %>"
                                                                method="POST" data-requires-token
                                                                onsubmit="return confirmHardDelete(event, '<%= user.name %>')"
                                                                class="d-inline">
                                                                <input type="hidden" name="id" value="<%= user.id %>">
                                                                <input type="hidden" name="mode" value="hard">
                                                                <button type="submit"
                                                                    class="btn btn-danger btn-sm px-3 shadow-sm"
                                                                    title="Eliminar permanentemente">
                                                                    <i class="bi bi-x-circle-fill"></i>
                                                                </button>
                                                            </form>
                                                            <% } else { %>
                                                                <form action="/admin/users/delete/<%= user.id %>"
                                                                    method="POST" data-requires-token
                                                                    onsubmit="return confirmSoftDelete(event, '<%= user.name %>')"
                                                                    class="d-inline">
                                                                    <input type="hidden" name="id"
                                                                        value="<%= user.id %>">
                                                                    <input type="hidden" name="mode" value="soft">
                                                                    <button type="submit"
                                                                        class="btn btn-white btn-sm px-3 border shadow-sm"
                                                                        title="Deshabilitar usuario">
                                                                        <i class="bi bi-shield-slash text-warning"></i>
                                                                    </button>
                                                                </form>
                                                                <% } %>

                                                                    <% } else if (user.role==='ADMIN' ) { %>
                                                                        <button
                                                                            class="btn btn-light btn-sm px-3 border-0 disabled"
                                                                            title="Administrador Protegido">
                                                                            <i
                                                                                class="bi bi-shield-lock-fill text-muted"></i>
                                                                        </button>
                                                                        <% } else { %>
                                                                            <span class="text-muted small italic">Sin
                                                                                acciones disponibles</span>
                                                                            <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
    </main>

    <script>
        function confirmSoftDelete(event, userName) {
            return confirm(`¿Estás seguro de deshabilitar a ${userName}? El usuario no podrá iniciar sesión pero sus datos se mantendrán.`);
        }

        function confirmHardDelete(event, userName) {
            return confirm(`⚠️ ATENCIÓN: Vas a borrar permanentemente a ${userName}. Se anonimizarán sus datos y esta acción NO se puede deshacer. ¿Continuar?`);
        }
    </script>

    <%- include('../layout/footer') %>