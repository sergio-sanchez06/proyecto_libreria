<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= t('addUser.page_title') %>
    </title>
    <link rel="stylesheet" href="/css/add_book.css">
</head>

<body>
    <%- include ("../layout/header") %>
    <main class="admin-form-page bg-pattern-general">
        <div class="container py-4">
            <div class="row justify-content-center">
                <div class="col-md-10 col-lg-7">
                    <div class="card brand-card">
                        <div class="card-header brand-card-header text-center">
                            <h2 class="mb-0 h3 fw-bold">
                                <i class="bi bi-person-plus-fill me-2"></i>
                                <%= t('addUser.title') %>
                            </h2>
                            <p class="mb-0 opacity-75 small">
                                <%= t('addUser.subtitle') %>
                            </p>
                        </div>
                        <div class="card-body p-4">
                            <% if (locals.error) { %>
                                <div class="alert alert-danger border-0 shadow-sm">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <%= error %>
                                </div>
                                <% } %>

                                    <form action="/admin/users/create" method="POST">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label for="name" class="form-label fw-bold">
                                                    <%= t('addUser.label_name') %> *
                                                </label>
                                                <input type="text" id="name" name="name" class="form-control" required
                                                    placeholder="<%= t('addUser.placeholder_name') %>">
                                            </div>

                                            <div class="col-md-6">
                                                <label for="email" class="form-label fw-bold">
                                                    <%= t('addUser.label_email') %> *
                                                </label>
                                                <input type="email" id="email" name="email" class="form-control" required
                                                    placeholder="<%= t('addUser.placeholder_email') %>">
                                            </div>

                                            <div class="col-md-6">
                                                <label for="password" class="form-label fw-bold">
                                                    <%= t('addUser.label_password') %> *
                                                </label>
                                                <input type="password" id="password" name="password" class="form-control"
                                                    required minlength="6">
                                                <small class="text-muted">
                                                    <%= t('addUser.password_help') %>
                                                </small>
                                            </div>

                                            <div class="col-md-6">
                                                <label for="role" class="form-label fw-bold">
                                                    <%= t('addUser.label_role') %> *
                                                </label>
                                                <select id="role" name="role" class="form-select">
                                                    <option value="CLIENT">
                                                        <%= t('addUser.role_client') %>
                                                    </option>
                                                    <option value="ADMIN">
                                                        <%= t('addUser.role_admin') %>
                                                    </option>
                                                </select>
                                            </div>

                                            <div class="col-12">
                                                <label for="default_address" class="form-label fw-bold">
                                                    <%= t('addUser.label_address_default') %> *
                                                </label>
                                                <input type="text" id="default_address" name="default_address"
                                                    class="form-control" required
                                                    placeholder="<%= t('addUser.placeholder_address') %>">
                                            </div>

                                            <div class="col-12">
                                                <label for="optional_address" class="form-label fw-bold">
                                                    <%= t('addUser.label_address_optional') %>
                                                </label>
                                                <input type="text" id="optional_address" name="optional_address"
                                                    class="form-control"
                                                    placeholder="<%= t('addUser.placeholder_address') %>">
                                            </div>

                                            <div class="col-12 d-flex justify-content-center gap-3 mt-4">
                                                <button type="submit"
                                                    class="btn btn-brand-teal px-5 py-2 fw-bold rounded-pill">
                                                    <i class="bi bi-person-check-fill me-2"></i>
                                                    <%= t('addUser.btn_submit') %>
                                                </button>
                                                <a href="/admin/users" class="btn btn-secondary px-4 rounded-pill">
                                                    <%= t('addUser.btn_cancel') %>
                                                </a>
                                            </div>
                                        </div>
                                    </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include ("../layout/footer") %>

</body>

</html>