<%- include('../layout/header', { bodyClass: 'bg-admin-vistas' , extraCSS: 'partials/genres' }) %>

    <div class="container py-5">
        <header class="text-center mb-5 pb-3">
            <h1 class="section-title text-center mx-auto" style="width: fit-content;">
                <%= t('genres.admin_title', { defaultValue: 'Gestión de Géneros' }) %>
            </h1>

            <div class="mt-4">
                <a href="/admin/genres/create" class="btn btn-primary rounded-pill px-4 shadow-sm d-flex align-items-center mx-auto" style="width: fit-content; background-color: var(--brand-teal); border: none;">
                    <i class="bi bi-plus-lg me-2"></i>Añadir Nuevo Género
                </a>
            </div>
        </header>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            <% genres.forEach(genre=> { %>
                <% const isDeleted=genre.deleted_at !==null; %>
                    <div class="col">
                        <div
                            class="card h-100 shadow-sm genre-card p-2 <%= isDeleted ? 'border-danger opacity-75 bg-light' : '' %>">
                            <div class="card-body d-flex flex-column align-items-center text-center p-4">

                                <div class="mb-2">
                                    <% if (isDeleted) { %>
                                        <span class="badge rounded-pill bg-danger">Eliminado</span>
                                        <% } else { %>
                                            <span class="badge rounded-pill bg-success">Activo</span>
                                            <% } %>
                                </div>

                                <div class="icon-box <%= isDeleted ? 'text-danger' : 'text-primary' %> mb-3">
                                    <i class="bi <%= isDeleted ? 'bi-x-circle' : 'bi-bookmarks-fill' %> fs-3"></i>
                                </div>

                                <h5 class="card-title fw-bold mb-3">
                                    <%= genre.name %>
                                </h5>

                                <div class="mt-auto w-100">
                                    <% if (isDeleted) { %>
                                        <button type="button" class="btn btn-success btn-sm w-100 rounded-pill py-2 shadow-sm"
                                            data-bs-toggle="modal" data-bs-target="#restoreModal"
                                            data-bs-id="<%= genre.id %>" data-bs-name="<%= genre.name %>">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> Restaurar
                                        </button>
                                        <% } else { %>
                                            <a href="/genres/<%= genre.name %>"
                                                class="btn btn-primary btn-sm w-100 rounded-pill mb-2 py-2 shadow-sm"
                                                style="background-color: var(--brand-teal); border: none;">
                                                <i class="bi bi-compass me-1"></i> Explorar
                                            </a>

                                            <button type="button"
                                                class="btn btn-danger btn-sm w-100 rounded-pill py-2 shadow-sm"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                data-bs-id="<%= genre.id %>" data-bs-name="<%= genre.name %>">
                                                <i class="bi bi-trash me-1"></i> Eliminar
                                            </button>
                                            <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
        </div>
    </div>

    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="deleteGenreForm" action="" method="POST" data-requires-token>
                    <div class="modal-body text-center">
                        <p>¿Estás seguro de que deseas eliminar el género <strong id="deleteGenreName"></strong>?</p>
                        <p class="small text-muted">Esta acción realizará un borrado lógico.</p>
                        <input type="hidden" name="id" id="deleteGenreId">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger">Confirmar Borrado</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="restoreModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-success">
                <div class="modal-header text-white bg-success">
                    <h5 class="modal-title">Restaurar Género</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <form id="restoreGenreForm" action="" method="POST" data-requires-token>
                    <div class="modal-body text-center">
                        <p>Vas a reactivar el género <strong id="restoreGenreName"></strong>.</p>
                        <input type="hidden" name="id" id="restoreGenreId">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success text-white">Restaurar ahora</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Lógica para Modal de Eliminación
            const deleteModal = document.getElementById('deleteModal');
            const deleteForm = document.getElementById('deleteGenreForm');

            deleteModal.addEventListener('show.bs.modal', event => {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-bs-id');
                const name = button.getAttribute('data-bs-name');

                deleteModal.querySelector('#deleteGenreId').value = id;
                deleteModal.querySelector('#deleteGenreName').textContent = name;

                // Actualizamos la URL con el ID dinámicamente
                deleteForm.action = `/admin/genres/delete/${id}`;
            });

            // Lógica para Modal de Restauración
            const restoreModal = document.getElementById('restoreModal');
            const restoreForm = document.getElementById('restoreGenreForm');

            restoreModal.addEventListener('show.bs.modal', event => {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-bs-id');
                const name = button.getAttribute('data-bs-name');

                restoreModal.querySelector('#restoreGenreId').value = id;
                restoreModal.querySelector('#restoreGenreName').textContent = name;

                // Actualizamos la URL con el ID dinámicamente
                restoreForm.action = `/admin/genres/restore/${id}`;
            });
        });
    </script>

    <%- include('../layout/footer') %>