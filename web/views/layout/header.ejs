<!DOCTYPE html>
<html lang="<%= i18n.language %>" class="<%= (typeof noScroll !== 'undefined' && noScroll) ? 'no-scroll-html' : '' %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= (typeof title !== 'undefined') ? title : 'Librería Online' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/layout.css">
</head>

<body class="<%= (typeof noScroll !== 'undefined' && noScroll) ? 'no-scroll' : '' %> <%= (typeof bodyClass !== 'undefined') ? bodyClass : '' %>">
    <header class="hero-header shadow-sm">
        <div class="container-fluid px-lg-5">
            <div class="header-wrapper">

                <div class="logo-container">
                    <a href="/" class="brand-container d-flex align-items-center" style="text-decoration: none;">
                        <div style="width: 52px; height: 52px; background-color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.2); border: 2px solid var(--brand-gold); flex-shrink: 0;">
                            <img src="/images/logo.png" 
                                 alt="BOOKLY logo" 
                                 style="height: 100%; width: 100%; object-fit: contain; transform: scale(1.2);">
                        </div>
                        <span class="brand-text ms-3" style="font-size: 1.5rem;">BOOKLY</span>
                    </a>
                </div>

                <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Abrir menú" onclick="toggleMenu()">
                    <i class="bi bi-list" id="menuIcon"></i>
                </button>

                <div class="collapsible-menu" id="collapsibleMenu">
                    <nav class="main-nav">
                        <a href="/">
                            <%= t('nav.home') %>
                        </a>
                        <a href="/books/showAllBooks">
                            <%= t('nav.catalog') %>
                        </a>
                        <a href="/authors/showAllAuthors">
                            <%= t('nav.authors') %>
                        </a>
                        <a href="/publisher/showAllPublishers">
                            <%= t('nav.publishers') %>
                        </a>
                        <a href="/genres">
                            <%= t('nav.genres') %>
                        </a>
                        <a href="/cart/view" class="position-relative">
                            <%= t('cart.title') %>
                                <i class="bi bi-cart3"></i>
                        </a>
                    </nav>

                    <div class="header-right-zone">
                        <div class="language-selector">
                            <form action="/language" method="get">
                                <select name="lng" class="form-select form-select-sm" onchange="this.form.submit()">
                                    <option value="es" <%=i18n.language.startsWith('es') ? 'selected' : '' %>>ES
                                    </option>
                                    <option value="ca" <%=i18n.language.startsWith('ca') ? 'selected' : '' %>>CA
                                    </option>
                                    <option value="gl" <%=i18n.language.startsWith('gl') ? 'selected' : '' %>>GL
                                    </option>
                                    <option value="eu" <%=i18n.language.startsWith('eu') ? 'selected' : '' %>>EU
                                    </option>
                                </select>
                            </form>
                        </div>

                        <div class="auth-group">
                            <% if (user) { %>
                                <div class="dropdown">
                                    <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown">
                                        <%= user.name || 'User' %>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="/user/profile">Mi Perfil</a></li>
                                        <% if(user.role==='ADMIN' ) { %>
                                            <li><a class="dropdown-item fw-bold" href="/admin/dashboard" style="color: var(--brand-teal);">
                                                    <%= t('nav.admin') %>
                                                </a></li>
                                            <% } %>
                                                <li>
                                                    <hr class="dropdown-divider">
                                                </li>
                                                <li><a class="dropdown-item text-danger" href="/logout">
                                                        <%= t('auth.logout') %>
                                                    </a></li>
                                    </ul>
                                </div>
                                <% } else { %>
                                    <a href="/login" class="btn btn-outline-light btn-sm border-0">Log In</a>
                                    <a href="/register" class="btn btn-sm fw-bold px-3" style="background-color: var(--brand-gold); color: white; border-radius: 20px;">Registro</a>
                                    <% } %>
                        </div>
                    </div>
                </div>

            </div>

            <script>
                function toggleMenu() {
                    const menu = document.getElementById('collapsibleMenu');
                    const icon = document.getElementById('menuIcon');
                    menu.classList.toggle('open');

                    if (menu.classList.contains('open')) {
                        icon.classList.remove('bi-list');
                        icon.classList.add('bi-x-lg');
                    } else {
                        icon.classList.remove('bi-x-lg');
                        icon.classList.add('bi-list');
                    }
                }
            </script>
        </div>
    </header>

    <main class="content-wrapper">