<!DOCTYPE html>
<html lang="<%= i18n.language %>" class="<%= (typeof noScroll !== 'undefined' && noScroll) ? 'no-scroll-html' : '' %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= (typeof title !=='undefined' ) ? title : 'Librería Online' %>
    </title>
    <!-- Bootstrap y Bootstrap Icons servidos localmente para evitar latencia de CDN -->
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/bootstrap-icons.min.css">
    <!-- Preconnect y preload de Google Fonts para romper la cadena de red crítica -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
        <link rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap">
    </noscript>

    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">

    <link rel="stylesheet" href="/css/main.min.css">
    <link rel="stylesheet" href="/css/layout.min.css">

    <link rel="stylesheet" href="/flags/css/flag-icons.min.css">

    <% if (typeof extraCSS !=='undefined' ) { %>
        <link rel="stylesheet" href="/css/views/<%= extraCSS %>.css">
        <% } %>
</head>

<body
    class="<%= (typeof noScroll !== 'undefined' && noScroll) ? 'no-scroll' : '' %> <%= (typeof bodyClass !== 'undefined') ? bodyClass : '' %>">
    <header class="hero-header shadow-sm">
        <div class="container-fluid px-lg-5">
            <div class="header-wrapper">

                <div class="logo-container">
                    <a href="/" class="brand-container d-flex align-items-center">
                        <div class="header-logo-outer">
                            <img src="/images/logo.png" alt="BOOKLY logo" class="header-logo-inner-img" width="49"
                                height="27" loading="eager">
                        </div>
                        <span class="brand-text ms-3">BOOKLY</span>
                    </a>
                </div>

                <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Abrir menú" onclick="toggleMenu()">
                    <i class="bi bi-list" id="menuIcon"></i>
                </button>

                <div class="collapsible-menu" id="collapsibleMenu">
                    <nav class="main-nav">
                        <a href="/">
                            <%= t('nav.home') %>
                        </a>
                        <a href="/books/showAllBooks">
                            <%= t('nav.catalog') %>
                        </a>
                        <a href="/authors/showAllAuthors">
                            <%= t('nav.authors') %>
                        </a>
                        <a href="/publisher/showAllPublishers">
                            <%= t('nav.publishers') %>
                        </a>
                        <a href="/genres">
                            <%= t('nav.genres') %>
                        </a>
                        <a href="/cart/view" class="position-relative">
                            <%= t('cart.title') %>
                                <i class="bi bi-cart3"></i>
                        </a>
                    </nav>

                    <div class="header-right-zone">
                        <div class="language-selector dropdown">
                            <!-- Botón que muestra el idioma actual con su bandera -->
                            <!-- <button class="btn btn-outline-light btn-sm dropdown-toggle d-flex align-items-center gap-2"
                                type="button" data-bs-toggle="dropdown">
                                <% if(i18n.language.startsWith('es')) { %>
                                    <img src="https://flagcdn.com/w20/es.png" width="20" alt="ES">
                                    <% } else if(i18n.language.startsWith('ca')) { %>
                                        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/c/ce/Flag_of_Catalonia.svg/20px-Flag_of_Catalonia.svg.png"
                                            width="20" alt="CA">
                                        <% } else if(i18n.language.startsWith('gl')) { %>
                                            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/6/64/Flag_of_Galicia.svg/20px-Flag_of_Galicia.svg.png"
                                                width="20" alt="GL">
                                            <% } else if(i18n.language.startsWith('eu')) { %>
                                                <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/2/2d/Flag_of_the_Basque_Country.svg/20px-Flag_of_the_Basque_Country.svg.png"
                                                    width="20" alt="EU">
                                                <% } %>
                                                    <span class="d-none d-sm-inline">
                                                        <%= i18n.language.toUpperCase().substring(0,2) %>
                                                    </span>
                            </button> -->

                            <button class="btn btn-outline-light btn-sm dropdown-toggle d-flex align-items-center gap-2"
                                type="button" data-bs-toggle="dropdown">
                                <% const safeLng=(i18n.language || 'es' ).substring(0, 2); const backupFlags={
                                    es: "https://flagcdn.com/w20/es.png" ,
                                    ca: "https://upload.wikimedia.org/wikipedia/commons/thumb/c/ce/Flag_of_Catalonia.svg/20px-Flag_of_Catalonia.svg.png"
                                    ,
                                    gl: "https://upload.wikimedia.org/wikipedia/commons/thumb/6/64/Flag_of_Galicia.svg/20px-Flag_of_Galicia.svg.png"
                                    ,
                                    eu: "https://upload.wikimedia.org/wikipedia/commons/thumb/2/2d/Flag_of_the_Basque_Country.svg/20px-Flag_of_the_Basque_Country.svg.png"
                                    }; const flagMap={ 'es' : 'fi-es' , 'ca' : 'fi-es-ct' , 'gl' : 'fi-es-ga' , 'eu'
                                    : 'fi-es-pv' }; const currentClass=flagMap[safeLng] || 'fi-es' ; %>

                                    <!-- Usamos una etiqueta IMG directamente para la bandera seleccionada -->
                                    <!-- Es la forma más fiable de que el failover funcione siempre -->
                                    <span class="d-flex align-items-center">
                                        <img src="/flags/flags/4x3/<%= safeLng %>.svg" class="fi <%= currentClass %>"
                                            style="width: 20px; height: auto; border-radius: 2px;"
                                            onerror="this.src='<%= backupFlags[safeLng] %>'; this.onerror=null;">
                                    </span>

                                    <span class="d-none d-sm-inline">
                                        <%= t('languages.' + safeLng) %>
                                    </span>
                            </button>

                            <!-- Opciones del menú: Cada enlace sustituye al envío del formulario -->
                            <!-- <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 <%= i18n.language.startsWith('es') ? 'active' : '' %>"
                                        href="/language?lng=es&returnTo=<%= encodeURIComponent(currentUrl) %>">
                                        <img src="https://flagcdn.com/w20/es.png" width="20" alt="ES">
                                        <%= t('languages.es') || 'Castellano' %>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 <%= i18n.language.startsWith('ca') ? 'active' : '' %>"
                                        href="/language?lng=ca&returnTo=<%= encodeURIComponent(currentUrl) %>">
                                        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/c/ce/Flag_of_Catalonia.svg/20px-Flag_of_Catalonia.svg.png"
                                            width="20" alt="CA">
                                        <%= t('languages.ca') || 'Català' %>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 <%= i18n.language.startsWith('gl') ? 'active' : '' %>"
                                        href="/language?lng=gl&returnTo=<%= encodeURIComponent(currentUrl) %>">
                                        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/6/64/Flag_of_Galicia.svg/20px-Flag_of_Galicia.svg.png"
                                            width="20" alt="GL">
                                        <%= t('languages.gl') || 'Galego' %>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2 <%= i18n.language.startsWith('eu') ? 'active' : '' %>"
                                        href="/language?lng=eu&returnTo=<%= encodeURIComponent(currentUrl) %>">
                                        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/2/2d/Flag_of_the_Basque_Country.svg/20px-Flag_of_the_Basque_Country.svg.png"
                                            width="20" alt="EU">
                                        <%= t('languages.eu') || 'Euskara' %>
                                    </a>
                                </li>
                            </ul> -->

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                <% const langs=[ { id: 'es' , class: 'fi-es' , img: 'https://flagcdn.com/w20/es.png' },
                                    { id: 'ca' , class: 'fi-es-ct' ,
                                    img: 'https://upload.wikimedia.org/wikipedia/commons/thumb/c/ce/Flag_of_Catalonia.svg/20px-Flag_of_Catalonia.svg.png'
                                    }, { id: 'gl' , class: 'fi-es-ga' ,
                                    img: 'https://upload.wikimedia.org/wikipedia/commons/thumb/6/64/Flag_of_Galicia.svg/20px-Flag_of_Galicia.svg.png'
                                    }, { id: 'eu' , class: 'fi-es-pv' ,
                                    img: 'https://upload.wikimedia.org/wikipedia/commons/thumb/2/2d/Flag_of_the_Basque_Country.svg/20px-Flag_of_the_Basque_Country.svg.png'
                                    } ]; %>

                                    <% langs.forEach(lang=> { %>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2 <%= i18n.language.startsWith(lang.id) ? 'active' : '' %>"
                                                href="/language?lng=<%= lang.id %>&returnTo=<%= encodeURIComponent(currentUrl) %>">

                                                <!-- Usamos un span para flag-icons con un fallback de imagen si el CSS no carga -->
                                                <span class="fi <%= lang.class %> d-flex align-items-center">
                                                    <img src="/flags/flags/4x3/<%= lang.id %>.svg" width="20"
                                                        style="display: block;"
                                                        onerror="this.src='<%= lang.img %>'; this.onerror=null;">
                                                </span>

                                                <%= t('languages.' + lang.id) %>
                                            </a>
                                        </li>
                                        <% }) %>
                            </ul>

                        </div>

                        <!-- <div class="header-right-zone">
                        <div class="language-selector">
                            <form action="/language" method="get">

                                <input type="hidden" name="returnTo" value="<%= currentUrl %>">

                                <label for="language-select" class="visually-hidden">Idioma</label>
                                <select id="language-select" name="lng" class="form-select form-select-sm"
                                    onchange="this.form.submit()" aria-label="Seleccionar idioma">
                                    <option value="es" <%=i18n.language.startsWith('es') ? 'selected' : '' %>>ES
                                    </option>
                                    <option value="ca" <%=i18n.language.startsWith('ca') ? 'selected' : '' %>>CA
                                    </option>
                                    <option value="gl" <%=i18n.language.startsWith('gl') ? 'selected' : '' %>>GL
                                    </option>
                                    <option value="eu" <%=i18n.language.startsWith('eu') ? 'selected' : '' %>>EU
                                    </option>
                                </select>
                            </form>
                        </div> -->

                        <div class="auth-group">
                            <% if (user) { %>
                                <div class="dropdown">
                                    <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown">
                                        <%= user.name || t('review.user') %>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="/user/profile">
                                                <%= t('profile.title') %>
                                            </a></li>
                                        <% if(user.role==='ADMIN' ) { %>
                                            <li><a class="dropdown-item fw-bold admin-dropdown-link"
                                                    href="/admin/dashboard">
                                                    <%= t('nav.admin') %>
                                                </a></li>
                                            <% } %>
                                                <li>
                                                    <hr class="dropdown-divider">
                                                </li>
                                                <li><a class="dropdown-item text-danger" href="/logout">
                                                        <%= t('auth.logout') %>
                                                    </a></li>
                                    </ul>
                                </div>
                                <% } else { %>
                                    <a href="/login" class="btn btn-outline-light btn-sm border-0">Log In</a>
                                    <a href="/register" class="btn btn-sm fw-bold px-3 btn-register-header">Registro</a>
                                    <% } %>
                        </div>
                    </div>
                </div>

            </div>

            <script>
                function toggleMenu() {
                    const menu = document.getElementById('collapsibleMenu');
                    const icon = document.getElementById('menuIcon');
                    menu.classList.toggle('open');

                    if (menu.classList.contains('open')) {
                        icon.classList.remove('bi-list');
                        icon.classList.add('bi-x-lg');
                    } else {
                        icon.classList.remove('bi-x-lg');
                        icon.classList.add('bi-list');
                    }
                }
            </script>

            <script type="module">
                import { auth } from "/js/firebaseConfig.mjs";
                import { onIdTokenChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";

                // Escucha cambios en el token (incluyendo refrescos automáticos cada hora)
                onIdTokenChanged(auth, async (user) => {
                    if (user) {
                        try {
                            const newToken = await user.getIdToken();

                            // Sincronizamos el nuevo token con la sesión de Redis en el servidor
                            await fetch("/auth/refresh-token", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({ idToken: newToken })
                            });
                            console.log("Sincronización de token completada.");
                        } catch (error) {
                            console.error("Error al sincronizar el token con el servidor:", error);
                        }
                    }
                });
            </script>
        </div>
    </header>

    <main class="content-wrapper">