<!DOCTYPE html>
<html lang="<%= i18n.language %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Librería Online</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>
    <header class="text-white py-3 shadow-sm hero-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0">
                    <a href="/" class="text-white text-decoration-none">Librería Online</a>
                </h1>

                <nav class="d-flex align-items-center gap-3">
                    <a href="/" class="text-white text-decoration-none">
                        <%= t('nav.home') %>
                    </a>
                    <a href="/books/showAllBooks" class="text-white text-decoration-none">
                        <%= t('nav.catalog') %>
                    </a>
                    <a href="/authors/showAllAuthors" class="text-white text-decoration-none">
                        <%= t('nav.authors') %>
                    </a>
                    <a href="/publisher/showAllPublishers" class="text-white text-decoration-none">
                        <%= t('nav.publishers') %>
                    </a>
                    <a href="/genres" class="text-white text-decoration-none">
                        <%= t('nav.genres') %>
                    </a>
                    <a href="/cart/view" class="text-white text-decoration-none">
                        <%= t('cart.title') %>
                    </a>

                    <div class="language-selector ms-2">
                        <form action="/language" method="get" class="d-flex align-items-center gap-2">
                            <select id="languageSelect" name="lng" class="form-select form-select-sm"
                                onchange="this.form.submit()">
                                <option value="es" <%=i18n.language.startsWith('es') ? 'selected' : '' %>>Español
                                </option>
                                <option value="ca" <%=i18n.language.startsWith('ca') ? 'selected' : '' %>>Català
                                </option>
                                <option value="gl" <%=i18n.language.startsWith('gl') ? 'selected' : '' %>>Galego
                                </option>
                                <option value="eu" <%=i18n.language.startsWith('eu') ? 'selected' : '' %>>Euskara
                                </option>
                            </select>
                        </form>
                    </div>

                    <div class="ms-3 d-flex align-items-center gap-2">
                        <% if (user) { %>
                            <span class="text-white me-2">
                                <%= t('auth.welcome', { name: user.name || 'Usuario' }) %>
                            </span>

                            <% if(user.role==='ADMIN' ) { %>
                                <a href="/admin/dashboard" class="btn btn-warning btn-sm">
                                    <%= t('nav.admin') %>
                                </a>
                                <% } %>

                                    <a href="/user/profile" class="btn btn-outline-light btn-sm">Perfil</a>
                                    <a href="/logout" class="btn btn-danger btn-sm">
                                        <%= t('auth.logout') %>
                                    </a>

                                    <% } else { %>
                                        <a href="/login" class="btn btn-outline-light btn-sm">
                                            <%= t('auth.login') %>
                                        </a>
                                        <a href="/register" class="btn btn-light btn-sm">
                                            <%= t('auth.register') %>
                                        </a>
                                        <% } %>
                    </div>
                </nav>
            </div>
        </div>
    </header>

    <main class="container mt-4 min-vh-100">