            <script>
                function toggleMenu() {
                    const menu = document.getElementById('collapsibleMenu');
                    const icon = document.getElementById('menuIcon');
                    menu.classList.toggle('open');

                    if (menu.classList.contains('open')) {
                        icon.classList.remove('bi-list');
                        icon.classList.add('bi-x-lg');
                    } else {
                        icon.classList.remove('bi-x-lg');
                        icon.classList.add('bi-list');
                    }
                }
            </script>

            <script type="module">
                import { auth } from "/js/firebaseConfig.mjs";
                import { onIdTokenChanged, signOut } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";

                // Escucha cambios en el token (incluyendo refrescos automáticos cada hora)
                // Solo actualiza el token en la sesión del servidor, sin recrear la sesión completa
                onIdTokenChanged(auth, async (firebaseUser) => {
                    if (!firebaseUser) return;
                    try {

                        // getIdToken(true): fuerza renovación si el token está próximo a expirar.
                        // onIdTokenChanged ya se dispara cuando Firebase lo renueva internamente,
                        // pero true garantiza que siempre enviamos un token válido y fresco.

                        const newToken = await firebaseUser.getIdToken(false);

                        // Evita reenviar el mismo token en navegaciones dentro de la misma pestaña
                        // sessionStorage se limpia al cerrar la pestaña — comportamiento correcto
                        const lastSentToken = sessionStorage.getItem("last_synced_token");
                        if (newToken === lastSentToken) {
                            console.log("Token idéntico, saltando sincronización.");
                            return;
                        }

                        const response = await fetch("/auth/refresh-token", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ idToken: newToken }),
                        });

                        const data = await response.json().catch(() => ({}));

                        if (response.ok) {
                            sessionStorage.setItem("last_synced_token", newToken);
                            console.log("Token sincronizado con éxito.");
                            return;
                        }

                        if (data.forceLogout) {
                            console.warn("[header] Forzando logout por indicación del servidor.");
                            await signOut(auth).catch(() => { });
                            window.location.href = "/login?error=" + encodeURIComponent("Tu sesión ha expirado. Por favor inicia sesión de nuevo.");
                            return;
                        }

                        console.warn("El servidor rechazó el refresh:", response.status);
                    } catch (error) {
                        console.error("Error al sincronizar token:", error);
                    }
                });

                // Cierra sesión en Firebase al hacer logout para limpiar el estado del cliente
                document.querySelectorAll('a[href="/logout"]').forEach(link => {
                    link.addEventListener("click", async (e) => {
                        e.preventDefault();
                        try {
                            await signOut(auth);
                            console.log("Sesión de Firebase cerrada correctamente.");
                        } catch (err) {
                            console.warn("Error al cerrar sesión en Firebase (se continúa con el logout del servidor):", err);
                        } finally {
                            // Siempre redirigimos al logout del servidor, independientemente de si Firebase falló
                            window.location.href = "/logout";
                        }
                    });
                })
            </script>
