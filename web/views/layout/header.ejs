<!DOCTYPE html>
<html lang="<%= i18n.language %>" class="<%= (typeof noScroll !== 'undefined' && noScroll) ? 'no-scroll-html' : '' %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Librería Online</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/layout.css">
</head>

<body class="<%= (typeof noScroll !== 'undefined' && noScroll) ? 'no-scroll' : '' %>">
    <header class="hero-header shadow-sm">
        <div class="container-fluid px-lg-5">
            <div class="header-wrapper">

                <div class="logo-container">
                    <a href="/" class="text-decoration-none">
                        <img src="/uploads/publishers/logo.svg" alt="Logo de la Librería" class="header-logo">
                    </a>
                </div>

                <nav class="main-nav">
                    <a href="/">
                        <%= t('nav.home') %>
                    </a>
                    <a href="/books/showAllBooks">
                        <%= t('nav.catalog') %>
                    </a>
                    <a href="/authors/showAllAuthors">
                        <%= t('nav.authors') %>
                    </a>
                    <a href="/publisher/showAllPublishers">
                        <%= t('nav.publishers') %>
                    </a>
                    <a href="/genres">
                        <%= t('nav.genres') %>
                    </a>
                    <a href="/cart/view" class="position-relative">
                        <%= t('cart.title') %>
                            <i class="bi bi-cart3"></i>
                    </a>
                </nav>

                <div class="header-right-zone">
                    <div class="language-selector">
                        <form action="/language" method="get">
                            <select name="lng" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="es" <%=i18n.language.startsWith('es') ? 'selected' : '' %>>ES</option>
                                <option value="ca" <%=i18n.language.startsWith('ca') ? 'selected' : '' %>>CA</option>
                                <option value="gl" <%=i18n.language.startsWith('gl') ? 'selected' : '' %>>GL</option>
                                <option value="eu" <%=i18n.language.startsWith('eu') ? 'selected' : '' %>>EU</option>
                            </select>
                        </form>
                    </div>

                    <div class="auth-group">
                        <% if (user) { %>
                            <div class="dropdown">
                                <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button"
                                    data-bs-toggle="dropdown">
                                    <%= user.name || 'User' %>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="/user/profile">Mi Perfil</a></li>
                                    <% if(user.role==='ADMIN' ) { %>
                                        <li><a class="dropdown-item fw-bold text-success" href="/admin/dashboard">
                                                <%= t('nav.admin') %>
                                            </a></li>
                                        <% } %>
                                            <li>
                                                <hr class="dropdown-divider">
                                            </li>
                                            <li><a class="dropdown-item text-danger" href="/logout">
                                                    <%= t('auth.logout') %>
                                                </a></li>
                                </ul>
                            </div>
                            <% } else { %>
                                <a href="/login" class="btn btn-outline-light btn-sm border-0">Log In</a>
                                <a href="/register" class="btn btn-warning btn-sm fw-bold">Registro</a>
                                <% } %>
                    </div>
                </div>

            </div>
        </div>
    </header>

    <main class="content-wrapper">