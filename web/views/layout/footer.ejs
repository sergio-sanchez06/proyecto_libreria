</main>

<footer class="main-footer bg-dark text-white pt-4 pb-3">
    <div class="container">
        <div class="row align-items-center mb-4 g-4">
            <div class="col-md-4 text-center text-md-start">
                <h6 class="mb-1 fw-bold text-uppercase tracking-wider">Librería Online</h6>
                <p class="text-secondary mb-0" style="font-size: 0.8rem;">
                    Tu rincón para nuevas historias. <br>
                    <small class="opacity-50 text-white">Proyecto Educativo</small>
                </p>
            </div>

            <div class="col-md-4">
                <nav class="d-flex justify-content-center gap-4">
                    <a href="/books/showAllBooks"
                        class="footer-link text-decoration-none text-white small fw-bold text-uppercase">Libros</a>
                    <a href="/authors/showAllAuthors"
                        class="footer-link text-decoration-none text-white small fw-bold text-uppercase">Autores</a>
                    <a href="/genres"
                        class="footer-link text-decoration-none text-white small fw-bold text-uppercase">Géneros</a>
                </nav>
            </div>

            <div class="col-md-4 text-center text-md-end">
                <div class="d-flex justify-content-center justify-content-md-end gap-3 mb-2">
                    <a href="#" class="text-white"><i class="bi bi-facebook fs-5"></i></a>
                    <a href="#" class="text-white"><i class="bi bi-instagram fs-5"></i></a>
                    <a href="#" class="text-white"><i class="bi bi-twitter-x fs-5"></i></a>
                </div>
                <p class="mb-0 opacity-75" style="font-size: 0.75rem;">&copy; 2026 Todos los derechos reservados</p>
            </div>
        </div>

        <div class="border-top border-secondary pt-3 mt-2">
            <div class="row">
                <div class="col-12">
                    <nav class="d-flex justify-content-center flex-wrap gap-3">
                        <a href="/aviso-legal"
                            class="legal-link text-secondary text-decoration-none small text-uppercase"
                            style="font-size: 0.65rem;">Aviso Legal</a>
                        <a href="/cookies" class="legal-link text-secondary text-decoration-none small text-uppercase"
                            style="font-size: 0.65rem;">Cookies</a>
                        <a href="/privacidad"
                            class="legal-link text-secondary text-decoration-none small text-uppercase"
                            style="font-size: 0.65rem;">Privacidad</a>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal reutilizable — incluir UNA sola vez en el layout -->
    <div class="modal fade" id="feedbackModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">

                <div class="modal-header border-0 pb-0" id="feedbackModalHeader">
                    <div class="d-flex align-items-center gap-2">
                        <span id="modalIcon" class="fs-4"></span>
                        <h5 class="modal-title fw-bold mb-0" id="modalTitle"></h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body pt-2">
                    <p class="text-muted mb-0" id="modalMessage"></p>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary rounded-pill px-4"
                        data-bs-dismiss="modal">Cerrar</button>
                </div>

            </div>
        </div>
    </div>

    <!-- Modal de confirmación para borrar -->
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">

                <div class="modal-header border-0 pb-0">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fs-4">⚠️</span>
                        <h5 class="modal-title fw-bold mb-0">¿Estás seguro?</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body pt-2">
                    <p class="text-muted mb-0" id="confirmMessage">Esta acción no se puede deshacer.</p>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary rounded-pill px-4"
                        data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold" id="confirmActionBtn">Sí,
                        eliminar</button>
                </div>

            </div>
        </div>
    </div>

    <div id="server-messages" data-error="<%= locals.error ? error : '' %>"
        data-success="<%= locals.success ? success : '' %>" style="display: none;">
    </div>



</footer>

<style>
    .footer-link:hover {
        color: #ffc107 !important;
        /* Un toque de color (ej. amarillo) al pasar el ratón */
        transition: 0.3s;
    }

    .legal-link:hover {
        color: #fff !important;
        transition: 0.3s;
    }

    .main-footer {
        border-top: 4px solid #343a40;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/modal.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const messagesDiv = document.getElementById('server-messages');
        const serverError = messagesDiv ? messagesDiv.getAttribute('data-error') : null;
        const serverSuccess = messagesDiv ? messagesDiv.getAttribute('data-success') : null;

        const urlParams = new URLSearchParams(window.location.search);
        const isUrlSuccess = urlParams.get('success') === 'true';

        // Usamos window.showModal explícitamente
        if (typeof window.showModal === "function") {
            if (serverError && serverError.trim() !== "") {
                window.showModal("error", serverError);
            }
            else if (serverSuccess && serverSuccess.trim() !== "") {
                window.showModal("success", serverSuccess);
            }
            else if (isUrlSuccess) {
                window.showModal("success", "¡Los cambios se han guardado correctamente!");

                // Esto limpia el ?success=true de la barra de direcciones sin recargar
                const newUrl = window.location.pathname;
                window.history.replaceState({}, document.title, newUrl);
            }
        }
    });
</script>

</body>

</html>